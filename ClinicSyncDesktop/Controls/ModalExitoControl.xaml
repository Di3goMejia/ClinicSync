<UserControl x:Class="ClinicSyncDesktop.Controls.ModalExitoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul con título ÉXITO! y botón rojo de cerrar -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock x:Name="TxtTitulo" Text="ÉXITO!" FontWeight="Bold" FontSize="15"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Cuerpo blanco con círculo verde de check y texto de confirmación -->
            <Border Grid.Row="1" Background="White" Padding="24,22,24,22">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icono circular verde con check blanco -->
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource ColorActivo}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="M 18,32 L 27,41 L 46,22" Stroke="White" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Mensaje de confirmación en dos líneas -->
                    <TextBlock x:Name="TxtMensaje"
                               Text="Los cambios se&#x0a;guardaron éxitosamente."
                               Foreground="{StaticResource ColorTexto}"
                               FontWeight="Bold" FontSize="15.5"
                               TextAlignment="Center" LineHeight="22"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Pie azul con botón Aceptar -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <Button Content="Aceptar" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Width="120" Height="27"
                        Click="BtnAceptar_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
