<UserControl x:Class="ClinicSyncDesktop.Controls.ModalCuidadoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="330">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul ClinicSync con título CUIDADO! y botón rojo de cerrar -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock x:Name="TxtTitulo" Text="CUIDADO!" FontWeight="Bold" FontSize="15"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnNo_Click"/>
            </Grid>

            <!-- Cuerpo del popup con insignia gris de advertencia y mensaje de confirmación -->
            <Border Grid.Row="1" Background="White" Padding="20,18,20,18">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Insignia gris de 8 puntas redondeadas con signo de exclamación centrado -->
                    <Viewbox Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Canvas Width="64" Height="64">
                            <Path Fill="#969D9F"
                                  Data="M32,6 C33.5,6 36,10 38.5,12 C41.5,11 46,12.5 47.5,15 C49,17.5 48.5,22.5 49.5,25.5 C52,27.5 56,30.5 56,32 C56,33.5 52,36.5 49.5,38.5 C48.5,41.5 49,46.5 47.5,49 C46,51.5 41.5,53 38.5,52 C36,54 33.5,58 32,58 C30.5,58 28,54 25.5,52 C22.5,53 18,51.5 16.5,49 C15,46.5 15.5,41.5 14.5,38.5 C12,36.5 8,33.5 8,32 C8,30.5 12,27.5 14.5,25.5 C15.5,22.5 15,17.5 16.5,15 C18,12.5 22.5,11 25.5,12 C28,10 30.5,6 32,6 Z"/>
                            <Path Fill="#222B34"
                                  Data="M 30,19 C 30,17.9 30.9,17 32,17 C 33.1,17 34,17.9 34,19 L 33.4,32 C 33.4,32.8 32.8,33.5 32,33.5 C 31.2,33.5 30.6,32.8 30.6,32 Z M 32,37.5 C 30.8,37.5 29.8,38.5 29.8,39.7 C 29.8,41 30.8,42 32,42 C 33.2,42 34.2,41 34.2,39.7 C 34.2,38.5 33.2,37.5 32,37.5 Z"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Mensaje de confirmación -->
                    <TextBlock x:Name="TxtMensaje"
                               Text="¿Seguro que desea&#x0a;descartar esta edición?"
                               Foreground="{StaticResource ColorTexto}"
                               FontWeight="Bold" FontSize="15"
                               TextAlignment="Center" LineHeight="21"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Pie azul con botones Sí y No -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Sí" Width="76" Height="26" Margin="0,0,8,0"
                            Style="{StaticResource BotonOvalado}" Padding="0"
                            Click="BtnSi_Click"/>
                    <Button Content="No" Width="76" Height="26" Margin="8,0,0,0"
                            Style="{StaticResource BotonOvalado}" Padding="0"
                            Click="BtnNo_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
