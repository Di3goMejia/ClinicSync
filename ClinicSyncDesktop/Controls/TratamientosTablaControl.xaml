<UserControl x:Class="ClinicSyncDesktop.Controls.TratamientosTablaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="14" Background="{StaticResource ColorPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra azul: AGREGAR NUEVO y Buscar -->
            <Border Grid.Row="0" Background="{StaticResource ColorAzul}"
                    CornerRadius="14,14,0,0" Height="36" Padding="14,0">
                <Grid>
                    <!-- Botón AGREGAR NUEVO con icono + circular -->
                    <Button Style="{StaticResource BotonIcono}" HorizontalAlignment="Left"
                            Foreground="White" Click="BtnAgregar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M13,7H11V11H7V13H11V17H13V13H17V11H13V7Z"
                                  Fill="White" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="AGREGAR NUEVO" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Campo de búsqueda redondeado -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Buscar:" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#F3F4F2" CornerRadius="11" Width="210" Height="22">
                            <TextBox x:Name="TxtBuscar" BorderThickness="0" Background="Transparent"
                                     Padding="8,0" VerticalContentAlignment="Center"
                                     FontSize="12.5" Foreground="{StaticResource ColorTexto}"
                                     TextChanged="TxtBuscar_TextChanged"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Encabezados de la tabla -->
            <Border Grid.Row="1" BorderBrush="{StaticResource ColorLinea}"
                    BorderThickness="0,0,0,1" Margin="0,14,0,0" Padding="22,0,22,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource ColorTexto}"/>
                    <TextBlock Grid.Column="1" Text="Nombre del tratamiento" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource ColorTexto}"/>
                    <TextBlock Grid.Column="2" Text="Precio base" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource ColorTexto}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Activo" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource ColorTexto}" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Filas de tratamientos -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaTratamientos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource ColorLinea}"
                                    BorderThickness="0,0,0,1" Height="38" Padding="22,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13.5"
                                               Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="13.5"
                                               Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PrecioDisplay}" FontSize="13.5"
                                               Foreground="{StaticResource ColorTexto}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding Activo, Mode=TwoWay}"
                                              Style="{StaticResource Interruptor}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Botón con icono de engranaje para editar -->
                                    <Button Grid.Column="4" Style="{StaticResource BotonIcono}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Editar tratamiento"
                                            Click="BtnEditar_Click">
                                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              Fill="{StaticResource ColorTexto}" Width="19" Height="19" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
