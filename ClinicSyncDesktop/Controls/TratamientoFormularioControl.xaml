<UserControl x:Class="ClinicSyncDesktop.Controls.TratamientoFormularioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="370">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Barra de título azul ClinicSync con botón cerrar -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock x:Name="TxtTitulo" Text="Editar información:" FontWeight="Bold" FontSize="14.5"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Campos del formulario -->
            <StackPanel Grid.Row="1" Background="White" Margin="22,18,22,20">

                <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="13">
                    <Run Text="Nombre del tratamiento:"/>
                    <Run Text=" *" Foreground="#D9435A"/>
                </TextBlock>
                <Border Background="#E1E4E1" CornerRadius="8" Margin="0,5,0,16" Height="30">
                    <TextBox x:Name="TxtNombre" BorderThickness="0" Background="Transparent"
                             Padding="8,0" VerticalContentAlignment="Center"
                             FontSize="13.5"
                             Foreground="{StaticResource ColorTexto}"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna Precio base -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="13">
                            <Run Text="Precio base:"/>
                            <Run Text=" *" Foreground="#D9435A"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Margin="0,5,0,0" Height="30">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="L" Margin="10,0,4,0"
                                           VerticalAlignment="Center" Foreground="#7A8B95" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtPrecio" BorderThickness="0" Background="Transparent"
                                         Padding="4,0,8,0" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right" FontSize="13.5"
                                         Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Columna Estado -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Estado:" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtEstado" Foreground="{StaticResource ColorTexto}"
                                   FontSize="12.5" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                        <CheckBox x:Name="ChkActivo" Style="{StaticResource Interruptor}"
                                  HorizontalAlignment="Center"
                                  Checked="ChkActivo_Cambio" Unchecked="ChkActivo_Cambio"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Pie azul con el botón Guardar cambios -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <Button Content="Guardar cambios" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Height="28" Padding="20,0"
                        Click="BtnGuardar_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
