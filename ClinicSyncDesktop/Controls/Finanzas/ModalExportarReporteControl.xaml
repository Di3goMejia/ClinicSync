<UserControl x:Class="ClinicSyncDesktop.Controls.Finanzas.ModalExportarReporteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="470">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul ClinicSync con botón rojo de cerrar -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock Text="Exportar reporte financiero" FontWeight="Bold" FontSize="15"
                           Foreground="White" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Cuerpo con selección de formato PDF / Excel -->
            <StackPanel Grid.Row="1" Background="White" Margin="22,18,22,20">
                <TextBlock Text="A continuación, seleccione el formato que desea exportar."
                           Foreground="{StaticResource ColorTextoClaro}" FontSize="13.5" Margin="0,0,0,16"/>

                <!-- Opciones de formato lado a lado -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tarjeta PDF -->
                    <Border x:Name="CardPdf" Grid.Column="0" Background="#EBF1F4" CornerRadius="12"
                            BorderBrush="{StaticResource ColorAzul}" BorderThickness="2"
                            Padding="12,14" Cursor="Hand" MouseLeftButtonDown="CardPdf_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono PDF azul oscuro -->
                            <Border Grid.Column="0" Width="32" Height="36" CornerRadius="4" Background="#1E4A63"
                                    VerticalAlignment="Top" Margin="0,2,0,0">
                                <Grid>
                                    <!-- Esquina doblada -->
                                    <Path Data="M 22,0 L 32,10 L 22,10 Z" Fill="#58B8C6" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <!-- Icono documento -->
                                    <Path Data="M 8,14 L 24,14 M 8,19 L 20,19 M 8,24 L 24,24"
                                          Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PDF" Foreground="{StaticResource ColorTexto}"
                                           FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Reportes imprimibles listo&#x0a;para presentación"
                                           Foreground="{StaticResource ColorTextoClaro}" FontSize="10.5"
                                           LineHeight="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tarjeta Excel -->
                    <Border x:Name="CardExcel" Grid.Column="2" Background="#EBF1F4" CornerRadius="12"
                            BorderBrush="Transparent" BorderThickness="2"
                            Padding="12,14" Cursor="Hand" MouseLeftButtonDown="CardExcel_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icono Excel con [X] -->
                            <Border Grid.Column="0" Width="32" Height="36" CornerRadius="4" Background="#1E4A63"
                                    VerticalAlignment="Top" Margin="0,2,0,0">
                                <Grid>
                                    <Border Width="16" Height="16" BorderBrush="White" BorderThickness="1.5" CornerRadius="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Excel" Foreground="{StaticResource ColorTexto}"
                                           FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Datos financieros&#x0a;organizados para análisis"
                                           Foreground="{StaticResource ColorTextoClaro}" FontSize="10.5"
                                           LineHeight="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Checkbox: Incluir gráficos en el reporte final -->
                <CheckBox x:Name="ChkIncluirGraficos" Margin="2,18,0,0" VerticalAlignment="Center" Cursor="Hand">
                    <TextBlock Text="Incluir gráficos en el reporte final"
                               Foreground="{StaticResource ColorTexto}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </CheckBox>
            </StackPanel>

            <!-- Pie azul con botón Exportar -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <Button Content="Exportar" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Width="124" Height="28"
                        Click="BtnExportar_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
