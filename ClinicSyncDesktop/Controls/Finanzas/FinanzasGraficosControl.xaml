<UserControl x:Class="ClinicSyncDesktop.Controls.Finanzas.FinanzasGraficosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Panel contenedor redondeado oficial de ClinicSync -->
    <Border CornerRadius="14" Background="{StaticResource ColorPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ BARRA AZUL SUPERIOR CON FILTROS ============ -->
            <Border Grid.Row="0" Background="{StaticResource ColorAzul}"
                    CornerRadius="14,14,0,0" Height="36" Padding="14,0">
                <Grid>
                    <!-- Filtros a la derecha: Hoy, Semana, Mes, Rango -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Filtrar:" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Píldora Hoy -->
                        <Border x:Name="PillHoy" Background="White" CornerRadius="11" Height="22" Padding="12,0" Margin="0,0,6,0"
                                Cursor="Hand" MouseLeftButtonDown="Filtro_Click">
                            <TextBlock x:Name="TxtHoy" Text="Hoy" Foreground="{StaticResource ColorTexto}" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Píldora Semana -->
                        <Border x:Name="PillSemana" Background="White" CornerRadius="11" Height="22" Padding="12,0" Margin="0,0,6,0"
                                Cursor="Hand" MouseLeftButtonDown="Filtro_Click">
                            <TextBlock x:Name="TxtSemana" Text="Semana" Foreground="{StaticResource ColorTexto}" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Píldora Mes (Activa por defecto en la captura) -->
                        <Border x:Name="PillMes" Background="#1E7D8A" CornerRadius="11" Height="22" Padding="12,0" Margin="0,0,6,0"
                                Cursor="Hand" MouseLeftButtonDown="Filtro_Click">
                            <TextBlock x:Name="TxtMes" Text="Mes" Foreground="White" FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Píldora Rango (Abre popover de fechas) -->
                        <Border x:Name="PillRango" Background="White" CornerRadius="11" Height="22" Padding="12,0"
                                Cursor="Hand" MouseLeftButtonDown="Filtro_Click">
                            <TextBlock x:Name="TxtRango" Text="Rango" Foreground="{StaticResource ColorTexto}" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ BARRA DE ACCIÓN: BOTÓN EXPORTAR Y AVISO ============ -->
            <Border Grid.Row="1" Margin="20,14,20,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Exportar cápsula blanca -->
                    <Border Background="White" CornerRadius="12" Height="26" Padding="16,0" Margin="0,0,12,0"
                            Cursor="Hand" MouseLeftButtonDown="BtnExportar_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#1E4A63" Opacity="0.10"/>
                        </Border.Effect>
                        <TextBlock Text="Exportar" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Icono circular de advertencia y mensaje informativo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono rojo circular con signo de exclamación ! -->
                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource ColorRojoCerrar}"
                                Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="!" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Tipos de formatos disponibles: PDF, Excel"
                                   Foreground="{StaticResource ColorTextoClaro}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ CONTENIDO PRINCIPAL: TARJETAS Y GRÁFICO ============ -->
            <Grid Grid.Row="2" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUMNA IZQUIERDA: 3 TARJETAS RESUMEN -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,4,16,0">
                    <!-- Tarjeta Ingresos -->
                    <Border Background="#E6E9E6" CornerRadius="12" Height="68" Margin="0,0,0,14" Padding="16,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ingresos" Foreground="{StaticResource ColorTexto}"
                                       FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalIngresos" Text="L 0.00" Foreground="{StaticResource ColorTexto}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Egresos -->
                    <Border Background="#E6E9E6" CornerRadius="12" Height="68" Margin="0,0,0,14" Padding="16,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Egresos" Foreground="{StaticResource ColorTexto}"
                                       FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalEgresos" Text="L 0.00" Foreground="{StaticResource ColorTexto}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta Saldo Neto -->
                    <Border Background="#E6E9E6" CornerRadius="12" Height="68" Padding="16,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Saldo Neto" Foreground="{StaticResource ColorTexto}"
                                       FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSaldoNeto" Text="L 0.00" Foreground="{StaticResource ColorTexto}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- COLUMNA DERECHA: GRÁFICO VECTORIAL DE LÍNEAS -->
                <Border Grid.Column="1" Background="Transparent" Margin="6,0,0,0">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Canvas Width="570" Height="285">

                            <!-- Líneas de cuadrícula horizontal muy suaves -->
                            <Line X1="45" Y1="20" X2="550" Y2="20" Stroke="#D6DAD7" StrokeThickness="0.8"/>
                            <Line X1="45" Y1="75" X2="550" Y2="75" Stroke="#D6DAD7" StrokeThickness="0.8"/>
                            <Line X1="45" Y1="130" X2="550" Y2="130" Stroke="#D6DAD7" StrokeThickness="0.8"/>
                            <Line X1="45" Y1="185" X2="550" Y2="185" Stroke="#D6DAD7" StrokeThickness="0.8"/>
                            <Line X1="45" Y1="240" X2="550" Y2="240" Stroke="#D6DAD7" StrokeThickness="0.8"/>

                            <!-- Etiquetas del eje Y (2000, 1500, 1000, 500, 0) -->
                            <TextBlock Canvas.Left="10" Canvas.Top="13" Text="2000 —" FontSize="9" Foreground="#5A788A"/>
                            <TextBlock Canvas.Left="10" Canvas.Top="68" Text="1500 —" FontSize="9" Foreground="#5A788A"/>
                            <TextBlock Canvas.Left="10" Canvas.Top="123" Text="1000 —" FontSize="9" Foreground="#5A788A"/>
                            <TextBlock Canvas.Left="15" Canvas.Top="178" Text="500 —" FontSize="9" Foreground="#5A788A"/>
                            <TextBlock Canvas.Left="26" Canvas.Top="233" Text="0 —" FontSize="9" Foreground="#5A788A"/>

                            <!-- Línea base del eje X -->
                            <Line X1="48" Y1="240" X2="550" Y2="240" Stroke="#7A8B95" StrokeThickness="1"/>

                            <!-- Marcas del eje X y números 0 al 23 -->
                            <!-- Ticks inferiores -->
                            <Path Data="M 48,240 L 48,247 M 69,240 L 69,247 M 90,240 L 90,247 M 111,240 L 111,247
                                       M 132,240 L 132,247 M 153,240 L 153,247 M 174,240 L 174,247 M 195,240 L 195,247
                                       M 216,240 L 216,247 M 237,240 L 237,247 M 258,240 L 258,247 M 279,240 L 279,247
                                       M 300,240 L 300,247 M 321,240 L 321,247 M 342,240 L 342,247 M 363,240 L 363,247
                                       M 384,240 L 384,247 M 405,240 L 405,247 M 426,240 L 426,247 M 447,247 L 447,240
                                       M 468,240 L 468,247 M 489,240 L 489,247 M 510,240 L 510,247 M 531,240 L 531,247"
                                  Stroke="#7A8B95" StrokeThickness="1"/>

                            <!-- Números en el eje X -->
                            <Canvas x:Name="ContenedorEjeX">
                                <TextBlock Canvas.Left="45" Canvas.Top="252" Text="0" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="67" Canvas.Top="252" Text="1" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="88" Canvas.Top="252" Text="2" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="109" Canvas.Top="252" Text="3" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="130" Canvas.Top="252" Text="4" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="151" Canvas.Top="252" Text="5" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="172" Canvas.Top="252" Text="6" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="193" Canvas.Top="252" Text="7" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="214" Canvas.Top="252" Text="8" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="235" Canvas.Top="252" Text="9" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="254" Canvas.Top="252" Text="10" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="276" Canvas.Top="252" Text="11" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="297" Canvas.Top="252" Text="12" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="318" Canvas.Top="252" Text="13" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="339" Canvas.Top="252" Text="14" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="360" Canvas.Top="252" Text="15" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="381" Canvas.Top="252" Text="16" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="402" Canvas.Top="252" Text="17" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="423" Canvas.Top="252" Text="18" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="444" Canvas.Top="252" Text="19" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="465" Canvas.Top="252" Text="20" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="486" Canvas.Top="252" Text="21" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="507" Canvas.Top="252" Text="22" FontSize="8.5" Foreground="#5A788A"/>
                                <TextBlock Canvas.Left="528" Canvas.Top="252" Text="23" FontSize="8.5" Foreground="#5A788A"/>
                            </Canvas>

                            <!-- ============ LÍNEA VERDE DE INGRESOS ============ -->
                            <Polyline x:Name="LineaIngresos" Points="48,240  69,218  90,172  111,200  132,142  153,88
                                             174,200 195,148 216,118 237,104 258,92   279,142
                                             300,16  321,55  342,66  363,78  384,124  405,182
                                             426,30  447,78  468,146 489,164 510,122  531,104 542,160"
                                      Stroke="#20A382" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- ============ LÍNEA ROJA DE EGRESOS ============ -->
                            <Polyline x:Name="LineaEgresos" Points="48,178  69,90   90,240  111,204 132,156  153,168
                                             174,136 195,84  216,210 237,126 258,110  279,42
                                             300,54  321,138 342,126 363,184 384,162  405,116
                                             426,236 447,232 468,162 489,44  510,198  531,170"
                                      Stroke="#D9435A" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- ============ POPOVER FLOTANTE DE RANGO DE FECHAS (IMAGEN 2) ============ -->
            <Border x:Name="PopoverRango" Grid.Row="0" Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,38,18,0" Width="225"
                    Background="White" CornerRadius="12" ClipToBounds="True"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.28"/>
                </Border.Effect>
                <StackPanel Margin="14,12,14,12">
                    <!-- Fila Desde -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Desde" Foreground="{StaticResource ColorTexto}" FontWeight="SemiBold"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#E4E9EC" CornerRadius="8" Height="25" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="📅" FontSize="11" Foreground="#7A8B95"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox x:Name="TxtFechaDesde" Text="YYYY/MM/DD" Foreground="#7A8B95"
                                         FontSize="11" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Fila Hasta -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hasta" Foreground="{StaticResource ColorTexto}" FontWeight="SemiBold"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#E4E9EC" CornerRadius="8" Height="25" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="📅" FontSize="11" Foreground="#7A8B95"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox x:Name="TxtFechaHasta" Text="YYYY/MM/DD" Foreground="#7A8B95"
                                         FontSize="11" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Botón Confirmar -->
                    <Button Content="Confirmar" HorizontalAlignment="Right"
                            Background="{StaticResource ColorAzul}" Foreground="White"
                            FontWeight="Bold" FontSize="11.5" Height="24" Padding="14,0"
                            BorderThickness="0" Cursor="Hand" Click="BtnConfirmarRango_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
