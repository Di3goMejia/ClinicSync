<UserControl x:Class="ClinicSyncDesktop.Controls.Finanzas.ModalAgregarIngresoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul ClinicSync con título Agregar nuevo ingreso: y botón rojo -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock Text="Agregar nuevo ingreso:" FontWeight="Bold" FontSize="14.5"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Cuerpo del formulario con campos a dos columnas -->
            <StackPanel Grid.Row="1" Background="White" Margin="22,16,22,20">
                <!-- Fila 1: Paciente y Fecha -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campo Paciente -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Paciente:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <!-- Botón circular azul con + -->
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnSeleccionarPaciente_Click">
                                    <TextBlock Text="+" Foreground="White" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <TextBox x:Name="TxtPaciente" Text="Seleccione un paciente" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="12" Foreground="{StaticResource ColorTextoClaro}"
                                         GotFocus="TxtPlaceholder_GotFocus" LostFocus="TxtPlaceholder_LostFocus"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Campo Fecha -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Fecha:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="📅" FontSize="11" Foreground="#7A8B95"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox x:Name="TxtFecha" Text="2026/06/19" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Tratamiento(s) y Materiales -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campo Tratamiento(s) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Tratamiento(s):"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnSeleccionarTratamiento_Click">
                                    <TextBlock Text="+" Foreground="White" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <TextBox x:Name="TxtTratamiento" Text="Seleccione un tratamiento" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="12" Foreground="{StaticResource ColorTextoClaro}"
                                         GotFocus="TxtPlaceholder_GotFocus" LostFocus="TxtPlaceholder_LostFocus"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Campo Materiales -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Materiales:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0"
                                Cursor="Hand" MouseLeftButtonDown="BtnSeleccionarMateriales_Click">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Margin="4,0,0,0">
                                    <TextBlock Text="+" Foreground="White" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <TextBlock x:Name="TxtMateriales" Text="Seleccionar" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource ColorTextoClaro}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Fila 3: Descuento y Medio de pago -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campo Descuento -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Descuento:" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4"/>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="L" Foreground="#7A8B95" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtDescuento" Text="0.00" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Campo Medio de pago -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Medio de pago:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <!-- Icono flecha circular hacia abajo -->
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnDropdownMedioPago_Click">
                                    <Path Data="M7,10L12,15L17,10H7Z" Fill="White" Width="12" Height="12"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ComboBox x:Name="CmbMedioPago" BorderThickness="0" Background="Transparent"
                                          VerticalContentAlignment="Center" FontSize="12"
                                          Foreground="{StaticResource ColorTexto}">
                                    <ComboBoxItem Content="Seleccione una opción" IsSelected="True"/>
                                    <ComboBoxItem Content="Transferencia"/>
                                    <ComboBoxItem Content="Efectivo"/>
                                    <ComboBoxItem Content="Tarjeta"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Pie azul con botón Agregar -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <Button Content="Agregar" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Width="124" Height="28"
                        Click="BtnAgregar_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
