<UserControl x:Class="ClinicSyncDesktop.Controls.Finanzas.ModalAgregarEgresoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul ClinicSync con título Agregar nuevo egreso: y botón rojo -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock Text="Agregar nuevo egreso:" FontWeight="Bold" FontSize="14.5"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Cuerpo del formulario con campos a dos columnas y área de concepto -->
            <StackPanel Grid.Row="1" Background="White" Margin="22,16,22,20">

                <!-- Fila 1: Tipo y Fecha -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campo Tipo -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Tipo:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnDropdownTipo_Click">
                                    <Path Data="M7,10L12,15L17,10H7Z" Fill="White" Width="12" Height="12"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ComboBox x:Name="CmbTipo" BorderThickness="0" Background="Transparent"
                                          VerticalContentAlignment="Center" FontSize="12"
                                          Foreground="{StaticResource ColorTexto}"
                                          SelectionChanged="CmbTipo_SelectionChanged">
                                    <ComboBoxItem Content="Seleccione una opción" IsSelected="True"/>
                                    <ComboBoxItem Content="Servicios"/>
                                    <ComboBoxItem Content="Materiales"/>
                                    <ComboBoxItem Content="Mantenimiento"/>
                                    <ComboBoxItem Content="Personal"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Campo Fecha -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Fecha:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="📅" FontSize="11" Foreground="#7A8B95"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox x:Name="TxtFecha" Text="2026/06/19" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Concepto (Conmutable: multilínea para servicios o selector pill para materiales, Imagen 5) -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                        <Run Text="Concepto:"/>
                        <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                    </TextBlock>

                    <!-- Modo 1: Área de texto multilínea (Servicios, Personal, etc.) -->
                    <Border x:Name="BrdConceptoTexto" Background="#E1E4E1" CornerRadius="8" Height="58" Padding="10,6">
                        <TextBox x:Name="TxtConcepto" Text="Escribir..." BorderThickness="0"
                                 Background="Transparent" VerticalContentAlignment="Top"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="12" Foreground="{StaticResource ColorTextoClaro}"
                                 GotFocus="TxtConcepto_GotFocus" LostFocus="TxtConcepto_LostFocus"/>
                    </Border>

                    <!-- Modo 2: Selector redondeado de material con botón circular (+) (Imagen 5) -->
                    <Border x:Name="BrdConceptoMaterial" Background="#E1E4E1" CornerRadius="8" Height="30" Padding="10,0"
                            Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="BrdConceptoMaterial_Click">
                        <DockPanel VerticalAlignment="Center">
                            <!-- Botón circular azul con signo más (+) -->
                            <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                    Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                    MouseLeftButtonDown="BtnPlusMaterial_Click">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="10" Height="10"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Texto del material o placeholder 'Seleccione un material' -->
                            <TextBlock x:Name="TxtMaterialSeleccionado" Text="Seleccione un material"
                                       Foreground="{StaticResource ColorTextoClaro}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Fila 3: Medio de pago y Monto -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campo Medio de pago -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Medio de pago:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnDropdownMedioPago_Click">
                                    <Path Data="M7,10L12,15L17,10H7Z" Fill="White" Width="12" Height="12"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ComboBox x:Name="CmbMedioPago" BorderThickness="0" Background="Transparent"
                                          VerticalContentAlignment="Center" FontSize="12"
                                          Foreground="{StaticResource ColorTexto}">
                                    <ComboBoxItem Content="Seleccione una opción" IsSelected="True"/>
                                    <ComboBoxItem Content="Transferencia"/>
                                    <ComboBoxItem Content="Efectivo"/>
                                    <ComboBoxItem Content="Tarjeta"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Campo Monto -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Monto:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="L" Foreground="#7A8B95" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtMonto" Text="0.00" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Pie azul con botón Agregar -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <Button Content="Agregar" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Width="124" Height="28"
                        Click="BtnAgregar_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
