<UserControl x:Class="ClinicSyncDesktop.Controls.Finanzas.ModalMaterialesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="390">

    <UserControl.Resources>
        <Style x:Key="CheckBoxCircularMaterial" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <!-- Estado desmarcado (Círculo con borde gris y visto tenue) -->
                            <Border x:Name="BrdUnchecked" Width="18" Height="18" CornerRadius="9"
                                    BorderBrush="#8A9CA5" BorderThickness="1.5" Background="Transparent">
                                <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                      Fill="#9EB0B8" Width="10" Height="10" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Estado marcado (Círculo verde azulado oscuro con visto blanco, Imagen 4) -->
                            <Border x:Name="BrdChecked" Width="18" Height="18" CornerRadius="9"
                                    Background="#1D4A5B" Visibility="Collapsed">
                                <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                      Fill="White" Width="10" Height="10" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BrdChecked" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BrdUnchecked" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul ClinicSync con título Agregar nuevo egreso: y botón rojo -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock x:Name="TxtTituloModalMateriales" Text="Agregar nuevo egreso:" FontWeight="Bold" FontSize="14.5"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Sub-barra azul con campo Buscar: -->
            <Border Grid.Row="1" Background="{StaticResource ColorAzul}" Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Buscar:" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="White" CornerRadius="11" Width="170" Height="22">
                        <TextBox x:Name="TxtBuscarMaterial" BorderThickness="0" Background="Transparent"
                                 Padding="8,0" VerticalContentAlignment="Center"
                                 FontSize="12" Foreground="{StaticResource ColorTexto}"
                                 TextChanged="TxtBuscarMaterial_TextChanged"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Encabezados de la tabla de materiales (Imagen 4) -->
            <Border Grid.Row="2" Background="#EBECE8" BorderBrush="{StaticResource ColorLinea}"
                    BorderThickness="0,0,0,1" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource ColorTexto}"/>
                    <TextBlock Grid.Column="2" Text="Nombre del material" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource ColorTexto}"/>
                </Grid>
            </Border>

            <!-- Lista de materiales con selección interactiva y ajuste de cantidad -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="#EBECE8">
                <ItemsControl x:Name="ListaMateriales">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource ColorLinea}" BorderThickness="0,0,0,1"
                                    Height="38" Padding="16,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox circular de selección (Imagen 4) -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                              Style="{StaticResource CheckBoxCircularMaterial}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                    <!-- Control de cantidad (- 2 c. +) visible solo cuando está seleccionado -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding ControlesCantidadVisibilidad}">
                                        <Button Content="-" Width="16" Height="18" Padding="0" Margin="0,0,4,0"
                                                Background="Transparent" BorderThickness="0" FontWeight="Bold"
                                                Foreground="{StaticResource ColorTexto}" Cursor="Hand"
                                                Click="BtnMenos_Click"/>
                                        <TextBlock Text="{Binding CantidadDisplay}" FontSize="12.5"
                                                   Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="16" Height="18" Padding="0" Margin="4,0,0,0"
                                                Background="Transparent" BorderThickness="0" FontWeight="Bold"
                                                Foreground="{StaticResource ColorTexto}" Cursor="Hand"
                                                Click="BtnMas_Click"/>
                                    </StackPanel>

                                    <!-- Nombre del material -->
                                    <TextBlock Grid.Column="2" Text="{Binding Nombre}" FontSize="12.5"
                                               Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Pie con botón Ok en la esquina derecha -->
            <Border Grid.Row="4" Background="#EBECE8" Padding="16,0">
                <Button Content="Ok" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource ColorAzul}" Foreground="White"
                        FontWeight="Bold" FontSize="12.5" Width="64" Height="26"
                        BorderThickness="0" Cursor="Hand" Click="BtnOk_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
