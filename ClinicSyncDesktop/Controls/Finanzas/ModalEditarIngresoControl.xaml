<UserControl x:Class="ClinicSyncDesktop.Controls.Finanzas.ModalEditarIngresoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">

    <Border CornerRadius="16" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#1E4A63" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Encabezado azul ClinicSync con título Editar información: y botón rojo -->
            <Grid Grid.Row="0" Background="{StaticResource ColorAzul}">
                <TextBlock Text="Editar información:" FontWeight="Bold" FontSize="14.5"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource BotonCerrarRojo}" Margin="0,0,10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <!-- Cuerpo del formulario -->
            <StackPanel Grid.Row="1" Background="White" Margin="22,14,22,18">

                <!-- Fila 0: Interruptor Activo (Imagen INGRESOS Finanzas - POP UP Editar I) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <TextBlock Text="Activo:" Foreground="{StaticResource ColorTexto}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="ChkActivo" Style="{StaticResource Interruptor}"
                              IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Fila 1: Paciente -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                        <Run Text="Paciente:"/>
                        <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                    </TextBlock>
                    <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                        <DockPanel>
                            <!-- Botón circular azul con + -->
                            <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                    Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                    MouseLeftButtonDown="BtnSeleccionarPaciente_Click">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="10" Height="10"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="TxtPaciente" Text="Karem N. Sánchez" BorderThickness="0"
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Fila 2: Tratamiento(s) y Fecha -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tratamiento(s) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Tratamiento(s):"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnSeleccionarTratamiento_Click">
                                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="10" Height="10"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox x:Name="TxtTratamiento" Text="Endodoncia" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Fecha -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Fecha:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="📅" FontSize="11" Foreground="#7A8B95"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox x:Name="TxtFecha" Text="2026/06/19" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Fila 3: Descuento y Medio de pago -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Descuento -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Descuento:" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4"/>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="L" Foreground="#7A8B95" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtDescuento" Text="0.00" BorderThickness="0"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right"
                                         FontSize="12" Foreground="{StaticResource ColorTexto}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Medio de pago -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource ColorTexto}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,4">
                            <Run Text="Medio de pago:"/>
                            <Run Text=" *" Foreground="{StaticResource ColorRojoCerrar}"/>
                        </TextBlock>
                        <Border Background="#E1E4E1" CornerRadius="8" Height="30" Padding="8,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource ColorAzul}" Cursor="Hand" Margin="4,0,0,0"
                                        MouseLeftButtonDown="BtnDropdownMedioPago_Click">
                                    <Path Data="M7,10L12,15L17,10H7Z" Fill="White" Width="12" Height="12"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ComboBox x:Name="CmbMedioPago" BorderThickness="0" Background="Transparent"
                                          VerticalContentAlignment="Center" FontSize="12"
                                          Foreground="{StaticResource ColorTexto}">
                                    <ComboBoxItem Content="Transferencia" IsSelected="True"/>
                                    <ComboBoxItem Content="Efectivo"/>
                                    <ComboBoxItem Content="Tarjeta"/>
                                </ComboBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Pie azul con botón Guardar cambios -->
            <Border Grid.Row="2" Background="{StaticResource ColorAzul}">
                <Button Content="Guardar cambios" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Height="28" Padding="20,0"
                        Click="BtnGuardar_Click"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
