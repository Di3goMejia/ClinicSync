<Window x:Class="ClinicSyncDesktop.Views.MensajeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mensaje"
        Width="260"
        SizeToContent="Height"
        MinHeight="0"
        MaxHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <LinearGradientBrush x:Key="DegradadoTurquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="BotonMensaje"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Background" Value="#8AD0D7"/>
            <Setter Property="Foreground" Value="#244B65"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="12"
            ClipToBounds="True"
            BorderBrush="#D5DEDA"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource DegradadoTurquesa}"
                    CornerRadius="11,11,0,0">

                <Grid Margin="11,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtTitulo"
                               Text="AVISO!"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="23"
                            Height="24"
                            Background="#E8425A"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cerrar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="1"
                        Margin="14,10,14,10"
                        HorizontalAlignment="Stretch">

                <Image x:Name="imgIcono"
                       Width="64"
                       Height="64"
                       Stretch="Uniform"
                       Margin="0,0,0,7"
                       Visibility="Collapsed"/>

                <TextBlock x:Name="txtMensaje"
                           Text="Mensaje"
                           Foreground="#244B65"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- BOTONES -->
            <Border Grid.Row="2"
                    Background="{StaticResource DegradadoTurquesa}"
                    Padding="8,6"
                    CornerRadius="0,0,11,11"
                    ClipToBounds="True">

                <StackPanel x:Name="panelBotones"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="btnAceptar"
                            Content="Aceptar"
                            Style="{StaticResource BotonMensaje}"
                            Click="Aceptar_Click"/>

                    <Button x:Name="btnSi"
                            Content="Sí"
                            Style="{StaticResource BotonMensaje}"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Click="Si_Click"/>

                    <Button x:Name="btnNo"
                            Content="No"
                            Style="{StaticResource BotonMensaje}"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            Click="No_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
