<UserControl x:Class="ClinicSyncDesktop.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F4F6F3"
             d:DesignHeight="375"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- DEGRADADO TURQUESA -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- BUSCADOR REDONDEADO -->
        <Style x:Key="Buscador" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#F5F7F4"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INTERRUPTOR DE ESTADO -->
        <Style x:Key="Interruptor" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Border x:Name="Pista"
                                    Background="#EFF1EE"
                                    CornerRadius="9"/>

                            <Ellipse x:Name="Circulo"
                                     Width="13"
                                     Height="13"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pista"
                                        Property="Background"
                                        Value="#25AD9A"/>

                                <Setter TargetName="Circulo"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                <Setter TargetName="Circulo"
                                        Property="Margin"
                                        Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ENCABEZADOS -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <!-- FILAS -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- CELDAS -->
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#17475A"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TEXTO CENTRADO -->
        <Style x:Key="TextoCentrado" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- BOTONES DE ICONOS -->
        <Style x:Key="BotonIcono" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- BOTÓN AGREGAR -->
        <Style x:Key="BotonAgregar" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- CONTENIDO PRINCIPAL -->
    <Grid Margin="18,20,18,18">

        <Border Background="#D9DDD8"
                CornerRadius="12"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA SUPERIOR -->
                <Border Grid.Row="0"
                        Background="{StaticResource Turquesa}"
                        CornerRadius="12,12,0,0">

                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <!-- AGREGAR NUEVO -->
                        <Button Grid.Column="0"
                                Style="{StaticResource BotonAgregar}"
                                HorizontalAlignment="Left"
                                Click="btnAgregar_Click">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Image Source="/Resources/ImagenesTabla/IconoMas.png"
                                       Width="20"
                                       Height="20"
                                       Margin="5,0,10,0"/>

                                <TextBlock Text="AGREGAR NUEVO"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- BUSCADOR -->
                        <TextBlock Grid.Column="1"
                                   Text="Buscar:"
                                   Foreground="White"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtBuscar"
                                 Grid.Column="2"
                                 Style="{StaticResource Buscador}"
                                 Height="25"
                                 VerticalAlignment="Center"
                                 ToolTip="Buscar material"
                                 TextChanged="txtBuscar_TextChanged"/>
                    </Grid>
                </Border>

                <!-- TABLA DE INVENTARIO -->
                <DataGrid x:Name="dgMateriales"
                          Grid.Row="1"
                          Background="Transparent"
                          RowBackground="#D9DDD8"
                          AlternatingRowBackground="#E8EBE7"
                          AlternationCount="2"
                          Foreground="#17475A"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          FontSize="13"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <!-- NÚMERO -->
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding IdMaterial}"
                                            Width="0.45*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <!-- IMAGEN Y LUPA -->
                        <DataGridTemplateColumn Header="Imagen"
                                                Width="0.9*"
                                                CanUserSort="False">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <!-- IMAGEN O ICONO DE RESPALDO -->
                                        <Grid Width="25"
                                              Height="25"
                                              Margin="0,0,5,0">

                                            <!-- ICONO DE RESPALDO -->
                                            <Image Source="/Resources/ImagenesInventario/IconoSinImagen.png"
                                                   Stretch="Uniform"
                                                   ToolTip="Sin imagen disponible"/>

                                            <!-- IMAGEN REAL DEL MATERIAL -->
                                            <Image Loaded="ImagenMaterial_Loaded"
                                                   Stretch="Uniform"
                                                   ToolTip="{Binding Nombre}">

                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Imagen}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Imagen}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>

                                        <!-- LUPA: SOLO SI EXISTE IMAGEN -->
                                        <Button Width="22"
                                                Height="25"
                                                ToolTip="Ampliar imagen"
                                                Click="VerImagen_Click">

                                            <!-- IMPORTANTE:
                                                 Style se define una sola vez. -->
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}"
                                                       BasedOn="{StaticResource BotonIcono}">

                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Imagen}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Imagen}"
                                                                     Value="">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                            <Image Source="/Resources/ImagenesInventario/IconoLupa.png"
                                                   Width="18"
                                                   Height="18"
                                                   Stretch="Uniform"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- NOMBRE -->
                        <DataGridTextColumn Header="Nombre del material"
                                            Binding="{Binding Nombre}"
                                            Width="2.2*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <!-- STOCK -->
                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding StockActual, StringFormat={}{0:0.##}}"
                                            Width="0.8*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <!-- PRECIO -->
                        <DataGridTextColumn Header="Precio de compra"
                                            Binding="{Binding PrecioCompra, StringFormat={}{0:'L '0.00}}"
                                            Width="1.35*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <!-- ESTADO -->
                        <DataGridTemplateColumn Header="Estado"
                                                Width="0.9*"
                                                SortMemberPath="Activo">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <CheckBox Style="{StaticResource Interruptor}"
                                                  IsChecked="{Binding Activo}"
                                                  IsHitTestVisible="False"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- EDITAR -->
                        <DataGridTemplateColumn Header=""
                                                Width="0.6*"
                                                CanUserSort="False">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Style="{StaticResource BotonIcono}"
                                                ToolTip="Editar material"
                                                Click="Editar_Click">

                                            <Image Source="/Resources/ImagenesTabla/IconoEngranaje.png"
                                                   Width="23"
                                                   Height="23"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- AVISOS -->
        <StackPanel x:Name="PanelAvisos"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Panel.ZIndex="10"/>

    </Grid>
</UserControl>
