<UserControl x:Class="ClinicSyncDesktop.Views.ExpedientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F4F6F3"
             d:DesignHeight="556.48"
             d:DesignWidth="995.567">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>


        <Style x:Key="BotonTransparente"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="18,8,18,18">

        <!-- CONTENEDOR PRINCIPAL -->
        <Border Background="#D9DDD8"
                CornerRadius="12"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA SUPERIOR -->
                <Border Grid.Row="0"
                        Background="{StaticResource Turquesa}"
                        CornerRadius="12,12,0,0">

                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- VOLVER -->
                        <Button Grid.Column="0"
                                Style="{StaticResource BotonTransparente}"
                                HorizontalAlignment="Left"
                                Click="Volver_Click">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Image Source="/Resources/ImagenesPacientes/ImagenesExpediente/volver-pacientes.png"
                                       Width="20"
                                       Height="20"
                                       Margin="0,0,7,0"/>

                                <TextBlock Text="VOLVER"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- AGREGAR NUEVO -->
                        <Button Grid.Column="1"
                                Style="{StaticResource BotonTransparente}"
                                Click="AgregarVisita_Click">

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Image Source="/Resources/ImagenesTabla/IconoMas.png"
                                       Width="19"
                                       Height="19"
                                       Margin="0,0,7,0"/>

                                <TextBlock Text="AGREGAR NUEVO"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- CONTENIDO -->
                <Grid Grid.Row="1"
                      Margin="12,8,12,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="65*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA -->
                    <Grid Grid.Column="0"
                          Margin="0,0,10,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="90"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- NOMBRE -->
                        <TextBlock x:Name="txtNombre"
                                   Grid.Row="0"
                                   Text="Cargando paciente..."
                                   Foreground="#17475A"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12"/>

                        <!-- SEXO Y EDAD -->
                        <Grid Grid.Row="1"
                              Margin="0,0,0,9">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal">

                                <TextBlock Text="Sexo:"
                                           FontWeight="Bold"
                                           Foreground="#17475A"
                                           FontSize="13"/>

                                <TextBlock x:Name="txtSexo"
                                           Margin="5,0,0,0"
                                           Foreground="#17475A"
                                           FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">

                                <TextBlock Text="Edad:"
                                           FontWeight="Bold"
                                           Foreground="#17475A"
                                           FontSize="13"/>

                                <TextBlock x:Name="txtEdad"
                                           Margin="5,0,0,0"
                                           Foreground="#17475A"
                                           FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- TELÉFONO -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,9">

                            <TextBlock Text="Teléfono:"
                                       FontWeight="Bold"
                                       Foreground="#17475A"
                                       FontSize="13"/>

                            <TextBlock x:Name="txtTelefono"
                                       Margin="5,0,0,0"
                                       Foreground="#17475A"
                                       FontSize="13"/>
                        </StackPanel>

                        <!-- NOTAS -->
                        <Grid Grid.Row="3">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,5">
                                <TextBlock Text="Notas:"
                                           FontWeight="Bold"
                                           Foreground="#17475A"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="btnEditarNotas"
                                            Content="Editar"
                                            Padding="8,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#138DAA"
                                            Cursor="Hand"
                                            Click="EditarNotas_Click"/>

                                    <Button x:Name="btnGuardarNotas"
                                            Content="Guardar"
                                            Padding="8,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#138DAA"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="GuardarNotas_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#F5F7F4"
                                    CornerRadius="9">

                                <ScrollViewer Margin="8,5"
                                              VerticalScrollBarVisibility="Auto">

                                    <TextBox x:Name="txtNotasExpediente"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             Foreground="#17475A"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             MaxLength="500"
                                             IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- ARCHIVOS -->
                        <Grid Grid.Row="4"
                              Margin="0,9,0,5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Archivos:"
                                       FontWeight="Bold"
                                       Foreground="#17475A"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Background="#F5F7F4"
                                    BorderThickness="0"
                                    Foreground="#138DAA"
                                    Cursor="Hand"
                                    Padding="8,2"
                                    Click="SubirArchivo_Click">

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Image Source="/Resources/ImagenesPacientes/ImagenesExpediente/subir-archivo.png"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,5,0"/>

                                    <TextBlock Text="Subir"
                                               FontSize="12"
                                               Foreground="#138DAA"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- LISTA DE ARCHIVOS -->
                        <Border Grid.Row="5"
                                Background="#F5F7F4"
                                CornerRadius="9"
                                MinHeight="100"
                                Margin="0,0,0,79">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Margin="8">

                                <StackPanel x:Name="PanelArchivos"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- COLUMNA DERECHA -->
                    <Grid Grid.Column="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TABLA DE VISITAS -->
                        <DataGrid x:Name="dgVisitas"
                                  Grid.Row="0"
                                  Background="Transparent"
                                  RowBackground="#D9DDD8"
                                  AlternatingRowBackground="#D3D8D3"
                                  AlternationCount="2"
                                  Foreground="#17475A"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#C5CBC5"
                                  FontSize="13"
                                   SelectionMode="Single">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="BorderBrush"
                                            Value="#C5CBC5"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding Fecha, StringFormat=yyyy/MM/dd}"
                                                    Width="1*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Motivo"
                                                    Binding="{Binding Motivo}"
                                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header=""
                                                        Width="55"
                                                        CanUserSort="False">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Editar visita"
                                                    Click="EditarVisita_Click">

                                                <Image Source="/Resources/ImagenesTabla/IconoEngranaje.png"
                                                       Width="23"
                                                       Height="23"/>
                                            </Button>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- ESTADO -->
                        <TextBlock x:Name="txtEstado"
                                   Grid.Row="1"
                                   Foreground="#17475A"
                                   FontSize="11"
                                   Margin="5,8,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- CONTENEDOR DE AVISOS -->
        <Grid x:Name="PanelAvisos"
              Width="315"
              Height="48"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,12,12"
              Panel.ZIndex="100"
              Visibility="Collapsed"/>

    </Grid>
</UserControl>
