<Window x:Class="ClinicSyncDesktop.Views.AgregarVisitaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar visita"
        Width="510"
        Height="510"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- BOTONES INFERIORES -->
        <Style x:Key="BotonPie" TargetType="Button">
            <Setter Property="Background" Value="#8BD4E0"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX CON BORDES REDONDEADOS -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCampo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Background="White"
            CornerRadius="15"
            ClipToBounds="True"
            Margin="5">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="53"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="39"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="14,0,10,0">
                    <TextBlock Text="Agregar visita"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cancelar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Width="26"
                               Height="26"/>
                    </Button>
                </Grid>
            </Border>

            <!-- PASOS -->
            <Grid Grid.Row="1"
                  Margin="35,13,35,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="2,0">
                    <Border x:Name="BarraPaso1"
                            Height="5"
                            Background="#138DAA"/>
                    <TextBlock Text="Antecedentes"
                               Foreground="#17475A"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="2,0">
                    <Border x:Name="BarraPaso2"
                            Height="5"
                            Background="#D9DDD8"/>
                    <TextBlock Text="Tratamientos"
                               Foreground="#17475A"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="2,0">
                    <Border x:Name="BarraPaso3"
                            Height="5"
                            Background="#D9DDD8"/>
                    <TextBlock Text="Notas"
                               Foreground="#17475A"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- CONTENIDO -->
            <Grid Grid.Row="2"
                  Margin="36,8,30,18">

                <!-- ANTECEDENTES -->
                <Grid x:Name="PanelAntecedentes">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <!-- DOCTOR -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource TituloCampo}">
                            <Run Text="Doctor(a):"/>
                            <Run Text="*" Foreground="#CF4059"/>
                        </TextBlock>

                        <Border Grid.Column="1"
                                Background="#D9DDD8"
                                Height="30"
                                CornerRadius="15"
                                VerticalAlignment="Center">

                            <TextBox x:Name="txtDoctor"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#17475A"
                                     FontSize="13"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="False"
                                     IsEnabled="True"
                                     Focusable="True"
                                     MaxLength="100"
                                     TextChanged="Campo_TextChanged"/>
                        </Border>
                    </Grid>

                    <!-- FECHA -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource TituloCampo}">
                            <Run Text="Fecha:"/>
                            <Run Text="*" Foreground="#CF4059"/>
                        </TextBlock>

                        <Grid Grid.Column="1"
                              Height="28"
                              VerticalAlignment="Center">

                            <Border Background="#D9DDD8"
                                    CornerRadius="14"/>

                            <Grid Margin="9,0,5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox x:Name="txtFechaVisita"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#17475A"
                                             FontSize="12"
                                             Padding="0"
                                             MaxLength="10"
                                             VerticalContentAlignment="Center"
                                             TextChanged="Campo_TextChanged"
                                             LostFocus="FechaVisita_LostFocus"
                                             ToolTip="YYYY/MM/DD"/>

                                    <TextBlock Text="YYYY/MM/DD"
                                               Foreground="#AEB0B1"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtFechaVisita}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CalendarioVisita_Click">
                                    <Image Source="/Resources/ImagenesPacientes/calendario.png"
                                           Width="15"
                                           Height="15"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <Popup x:Name="PopupCalendarioVisita"
                               Grid.Column="1"
                               PlacementTarget="{Binding ElementName=txtFechaVisita}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">

                            <Border Background="White"
                                    BorderBrush="#C5CBC5"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6">
                                <Calendar x:Name="calFechaVisita"
                                          SelectedDatesChanged="CalendarioVisita_SelectedDatesChanged"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- MOTIVO -->
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource TituloCampo}">
                        <Run Text="Motivo:"/>
                        <Run Text="*" Foreground="#CF4059"/>
                    </TextBlock>

                    <TextBox x:Name="txtMotivo"
                             Grid.Row="3"
                             Style="{StaticResource Campo}"
                             MaxLength="255"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="Campo_TextChanged" Margin="0,0,0,31"/>

                    <TextBlock x:Name="txtError"
                               Grid.Row="4"
                               Foreground="#CF4059"
                               FontSize="13"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- TRATAMIENTOS -->
                <Grid x:Name="PanelTratamientos"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="12,12,0,0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0">

                            <TextBlock Text="Buscar:"
                                       Foreground="White"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <!-- BUSCADOR REDONDEADO -->
                            <Border Width="225"
                                    Height="25"
                                    Background="White"
                                    CornerRadius="13"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">

                                <TextBox x:Name="txtBuscarTratamiento"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#17475A"
                                         FontSize="13"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BuscarTratamiento_TextChanged"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TABLA -->
                    <Border Grid.Row="1"
                            Background="#D9DDD8"
                            CornerRadius="0,0,15,15"
                            ClipToBounds="True">

                        <Grid>

                            <DataGrid x:Name="dgTratamientos"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      RowHeight="38"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#C6CCC7"
                                      Background="Transparent"
                                      RowBackground="#D9DDD8"
                                      AlternatingRowBackground="#D9DDD8"
                                      BorderThickness="0"
                                      Foreground="#17475A">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#D9DDD8"/>
                                        <Setter Property="Foreground" Value="#17475A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="Height" Value="32"/>
                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>

                                    <!-- SELECCIÓN -->
                                    <DataGridTemplateColumn Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="SeleccionarTratamiento_Click">

                                                    <Image Width="22" Height="22">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source"
                                                                        Value="/Resources/ImagenesPacientes/ImagenesExpediente/seleccion-sin-marcar.png"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Seleccionado}"
                                                                                 Value="True">
                                                                        <Setter Property="Source"
                                                                                Value="/Resources/ImagenesPacientes/ImagenesExpediente/seleccion-marcada.png"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- CANTIDAD -->
                                    <DataGridTemplateColumn Header="Cantidad"
                                                            Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">

                                                    <Button Content="-"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#17475A"
                                                            FontSize="15"
                                                            Cursor="Hand"
                                                            Click="RestarCantidad_Click"/>

                                                    <TextBlock Text="{Binding Cantidad}"
                                                               Foreground="#17475A"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0"/>

                                                    <Button Content="+"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#17475A"
                                                            FontSize="15"
                                                            Cursor="Hand"
                                                            Click="SumarCantidad_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- NOMBRE -->
                                    <DataGridTextColumn Header="Nombre del tratamiento"
                                                        Binding="{Binding Nombre}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- ESTADO DE CARGA -->
                            <TextBlock x:Name="txtEstadoTratamientos"
                                       Text="Cargando tratamientos..."
                                       Foreground="#17475A"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="20"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- NOTAS -->
                <Grid x:Name="PanelNotas"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="115"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Observaciones:"
                               Style="{StaticResource TituloCampo}"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtNotas"
                             Grid.Row="1"
                             Style="{StaticResource Campo}"
                             MaxLength="500"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- ARCHIVOS -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Archivos:"
                                   Style="{StaticResource TituloCampo}"/>

                        <!-- SUBIR REDONDEADO -->
                        <Button Grid.Column="1"
                                Width="100"
                                Height="25"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SubirArchivo_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#D9DDD8"
                                            CornerRadius="13"
                                            Padding="8,2">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Image Source="/Resources/ImagenesPacientes/ImagenesExpediente/subir-archivo.png"
                                                   Width="17"
                                                   Height="17"
                                                   Margin="0,0,5,0"/>

                                            <TextBlock Text="Subir"
                                                       Foreground="#138DAA"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanelArchivos"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- PIE -->
            <Border Grid.Row="3"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,15,15">

                <Grid Margin="20,4">

                    <Button x:Name="btnRegresar"
                            Content="Regresar"
                            Style="{StaticResource BotonPie}"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="Regresar_Click"/>

                    <Button x:Name="btnSiguiente"
                            Content="Siguiente"
                            Style="{StaticResource BotonPie}"
                            HorizontalAlignment="Right"
                            Click="Siguiente_Click"/>

                    <Button x:Name="btnAgregar"
                            Content="Agregar"
                            Style="{StaticResource BotonPie}"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Click="Guardar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
