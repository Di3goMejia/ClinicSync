<Window x:Class="ClinicSyncDesktop.Views.VisualizarVisitaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizar visita"
        Width="630"
        Height="565"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Ventana_Loaded">

    <Window.Resources>
        <LinearGradientBrush x:Key="FondoTurquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2B9CA1" Offset="0"/>
            <GradientStop Color="#1385A6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="EstiloPestana" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinWidth" Value="93"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloCampo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloEtiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="BotonSinBorde" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#17475A"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextoCelda" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="17">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="47"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource FondoTurquesa}"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <TextBlock Text="Visualizar visita"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Button Width="31" Height="31"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonSinBorde}"
                            AutomationProperties.Name="Cerrar"
                            Click="Cerrar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="35,25,35,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnAntecedentes"
                            Content="Antecedentes"
                            Style="{StaticResource EstiloPestana}"
                            Click="Antecedentes_Click"/>
                    <Button x:Name="btnTratamientos"
                            Content="Tratamientos"
                            Style="{StaticResource EstiloPestana}"
                            Click="Tratamientos_Click"/>
                    <Button x:Name="btnNotas"
                            Content="Notas"
                            Style="{StaticResource EstiloPestana}"
                            Click="Notas_Click"/>
                </StackPanel>

                <Button x:Name="btnEditar"
                        Grid.Row="0"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        ToolTip="Editar visita"
                        AutomationProperties.Name="Editar visita"
                        Style="{StaticResource BotonSinBorde}"
                        Click="Editar_Click">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <Image Source="/Resources/ImagenesPacientes/ImagenesExpediente/editar_visita.png"
                           Width="27"
                           Height="27"
                           Stretch="Uniform"/>
                </Button>

                <!-- ANTECEDENTES -->
                <Grid x:Name="PanelAntecedentes" Grid.Row="1" Margin="5,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Doctor(a):"
                               Style="{StaticResource EstiloEtiqueta}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="#D9DDD8"
                            CornerRadius="12"
                            Padding="10,0">
                                            <TextBlock x:Name="txtDoctor"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#17475A"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Fecha:"
                               Style="{StaticResource EstiloEtiqueta}"
                               VerticalAlignment="Center"/>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="#D9DDD8"
                            CornerRadius="12"
                            Padding="10,0">
                                            <TextBlock x:Name="txtFecha"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#17475A"/>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               Text="Motivo:" Margin="0,12,0,8"
                               Style="{StaticResource EstiloEtiqueta}"/>
                    <TextBox x:Name="txtMotivo" Grid.Row="3" Grid.ColumnSpan="2"
                             Height="168"
                             VerticalAlignment="Top"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource EstiloCampo}"/>
                </Grid>

                <!-- TRATAMIENTOS -->
                <Grid x:Name="PanelTratamientos" Grid.Row="1"
                      Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource FondoTurquesa}"
                            CornerRadius="14,14,0,0">
                        <StackPanel Orientation="Horizontal" Margin="18,0">
                            <TextBlock Text="Buscar:"
                                       Foreground="White"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBox x:Name="txtBuscar"
                                     Width="320" Height="28"
                                     Padding="10,3"
                                     Background="White"
                                     IsReadOnly="False"
                                     Style="{StaticResource EstiloCampo}"
                                     AutomationProperties.Name="Buscar tratamiento"
                                     TextChanged="Buscar_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#D9DDD8"
                            CornerRadius="0,0,14,14"
                            Padding="0,0,0,10">
                        <DataGrid x:Name="dgTratamientos"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Foreground="#17475A"
                                  RowBackground="#D9DDD8"
                                  AlternatingRowBackground="#E8EBE7"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding Cantidad}"
                                                    ElementStyle="{StaticResource TextoCelda}"
                                                    Width="145"/>
                                <DataGridTextColumn Header="Nombre del tratamiento"
                                                    Binding="{Binding Nombre}"
                                                    ElementStyle="{StaticResource TextoCelda}"
                                                    Width="*"/>     
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- NOTAS Y ARCHIVOS -->
                <Grid x:Name="PanelNotas" Grid.Row="1"
                      Margin="5,14,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="145"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Observaciones:"
                               Margin="0,0,0,8"
                               Style="{StaticResource EstiloEtiqueta}"/>
                    <TextBox x:Name="txtNotas" Grid.Row="1"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource EstiloCampo}"/>
                    <TextBlock Grid.Row="2" Text="Archivos:"
                               Margin="0,12,0,8"
                               Style="{StaticResource EstiloEtiqueta}"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelArchivos"/>
                    </ScrollViewer>
                </Grid>

                <TextBlock x:Name="txtEstado" Grid.Row="2"
                           Margin="0,8,0,0"
                           Foreground="#17475A"
                           TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource FondoTurquesa}"
                    CornerRadius="0,0,17,17"/>
        </Grid>
    </Border>
</Window>