<Window x:Class="ClinicSyncDesktop.Views.HoraNoDisponibleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hora no disponible"
        Width="260"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- BOTÓN ACEPTAR REDONDEADO -->
        <Style x:Key="BotonAceptar" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- BURBUJA ROSADA -->
    <Border Margin="9"
            Background="#FFDDE0"
            CornerRadius="18">

        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="4"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid>

            <!-- BOTÓN CERRAR -->
            <Button Content="✕"
                    Width="23"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,10,0"
                    Background="#E8425A"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Cerrar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- MENSAJE Y BOTÓN -->
            <StackPanel Margin="16,38,16,14"
                        HorizontalAlignment="Center">

                <TextBlock x:Name="txtMensaje"
                           Text="Esta hora no está disponible."
                           Foreground="#17475A"
                           FontSize="16"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Button Content="Aceptar"
                        Style="{StaticResource BotonAceptar}"
                        Click="Aceptar_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>