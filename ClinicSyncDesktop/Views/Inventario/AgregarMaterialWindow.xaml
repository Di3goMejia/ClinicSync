<Window x:Class="ClinicSyncDesktop.Views.AgregarMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar nuevo material"
        Width="312"
        Height="433"
        MinWidth="357"
        MinHeight="435"
        MaxWidth="357"
        MaxHeight="435"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>

        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#168FA5" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="AzulOscuro" Color="#17475A"/>
        <SolidColorBrush x:Key="FondoCampo" Color="#D9DDD8"/>
        <SolidColorBrush x:Key="RojoCerrar" Color="#E83C53"/>

        <Style x:Key="Etiqueta"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{StaticResource AzulOscuro}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Campo"
               TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background"
                    Value="{StaticResource FondoCampo}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource AzulOscuro}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPlano"
               TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </Window.Resources>

    <Border Background="White"
            CornerRadius="15"
            BorderThickness="1"
            BorderBrush="#E1E7E4"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Grid Margin="0,0,0,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="14,14,0,0"
                    ClipToBounds="True">

                <Grid Margin="14,0,9,0">

                    <TextBlock Text="Agregar nuevo material:"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Width="23"
                            Height="23"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cancelar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"/>
                    </Button>

                </Grid>
            </Border>

            <!-- CUERPO -->
            <Grid Grid.Row="1"
                  Margin="30,8,30,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="49"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="59"/>
                    <RowDefinition Height="49"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- IMAGEN -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Imagen:"
                                   Style="{StaticResource Etiqueta}"
                                   Margin="3,0,10,0"/>

                        <Button Grid.Column="1"
                                Height="22"
                                Padding="6,0"
                                Background="#E4F0F0"
                                Style="{StaticResource BotonPlano}"
                                Click="SeleccionarImagen_Click" Grid.ColumnSpan="2" Margin="0,2,136,3">

                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="9">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Source="/Resources/ImagenesInventario/IconoImagen.png"
                                       Width="16"
                                       Height="16"
                                       Stretch="Uniform"
                                       Margin="0,0,4,0"/>

                                <TextBlock Text="Elegir imagen"
                                           Foreground="#168FAD"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBox x:Name="txtImagen"
                                 Grid.Column="2"
                                 Height="22"
                                 Margin="4,0,2,0"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="{StaticResource AzulOscuro}"
                                 FontSize="12"
                                 Padding="2,0"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Imagen seleccionada"/>

                        <Button x:Name="btnQuitarImagen"
                                Grid.Column="3"
                                Width="19"
                                Height="22"
                                Background="Transparent"
                                Style="{StaticResource BotonPlano}"
                                ToolTip="Quitar imagen"
                                Visibility="Collapsed"
                                Click="QuitarImagen_Click">

                            <Image Source="/Resources/ImagenesInventario/IconoBasurero.png"
                                   Width="15"
                                   Height="18"
                                   Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="ⓘ Tipos de archivo aceptados: JPG, PNG"
                               FontSize="10"
                               Foreground="#B7BDBB"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"/>

                    <Image x:Name="imgVistaPrevia"
                           Visibility="Collapsed"
                           Width="1"
                           Height="1"/>
                </Grid>

                <!-- NOMBRE -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="23"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Nombre del material:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <TextBox x:Name="txtNombre"
                             Grid.Row="1"
                             Style="{StaticResource Campo}"
                             MaxLength="50" Height="20" Margin="0,1,0,0" VerticalAlignment="Top"/>
                </Grid>

                <!-- CÓDIGO Y PRECIO -->
                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="23"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Código:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <TextBox x:Name="txtCodigo"
                             Grid.Row="1"
                             Grid.Column="0"
                             Style="{StaticResource Campo}"
                             MaxLength="30"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Precio por unidad:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <Grid Grid.Row="1"
                          Grid.Column="2">

                        <Border Background="{StaticResource FondoCampo}"
                                CornerRadius="10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="L"
                                       Grid.Column="0"
                                       Foreground="#B0B7B4"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtPrecioCompra"
                                     Grid.Column="1"
                                     Style="{StaticResource Campo}"
                                     Background="Transparent"
                                     Padding="0,1,8,1"
                                     Text="0.00"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- CANTIDAD INICIAL Y MÍNIMA -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Cantidad inicial:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <Grid Grid.Row="1"
                          Grid.Column="0">

                        <Border Background="{StaticResource FondoCampo}"
                                CornerRadius="10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="49"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtCantidadInicial"
                                     Grid.Column="0"
                                     Style="{StaticResource Campo}"
                                     Background="Transparent"
                                     Padding="0"
                                     Text="0"
                                     TextAlignment="Center"/>

                            <Border Grid.Column="1"
                                    BorderBrush="#C3C9C5"
                                    BorderThickness="1,0,0,0"/>

                            <TextBox x:Name="txtUnidadMedida"
                                     Grid.Column="1"
                                     Style="{StaticResource Campo}"
                                     Background="Transparent"
                                     Padding="1"
                                     TextAlignment="Center"
                                     MaxLength="20"
                                     ToolTip="Unidad de medida"/>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Cantidad mínima:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <TextBox x:Name="txtStockMinimo"
                             Grid.Row="1"
                             Grid.Column="2"
                             Style="{StaticResource Campo}"
                             Text="0"/>
                </Grid>

                <!-- DESCRIPCIÓN -->
                <Grid Grid.Row="4" Margin="0,10,0,14" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Descripción (opcional):"
                               Style="{StaticResource Etiqueta}" Height="17"/>

                    <TextBox x:Name="txtDescripcion"
                             Grid.Row="1"
                             Style="{StaticResource Campo}"
                             Height="Auto"
                             MinHeight="48"
                             Padding="9,7"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxLength="200"/>
                </Grid>

                <!-- MENSAJE ROJO DE VALIDACIÓN -->
                <TextBlock x:Name="txtAvisoValidacion"
                           Grid.Row="5"
                           Foreground="#E83C53"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- PIE -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,14,14"
                    ClipToBounds="True" Margin="0,10,0,-10">

                <Button x:Name="btnGuardar"
                        Content="Agregar"
                        Width="85"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#91D3DE"
                        Foreground="{StaticResource AzulOscuro}"
                        FontSize="13"
                        FontWeight="Bold"
                        Style="{StaticResource BotonPlano}"
                        Click="Guardar_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>