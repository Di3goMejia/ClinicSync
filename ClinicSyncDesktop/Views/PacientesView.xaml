<UserControl x:Class="ClinicSyncDesktop.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClinicSyncDesktop.Controls"
             Background="White">

    <Grid>
        <!-- Zona principal con la tabla de pacientes -->
        <Border Padding="26,14,26,26" Background="White">
            <controls:PacientesTablaControl x:Name="TablaPacientes"
                                           AgregarNuevoClick="Tabla_AgregarNuevoClick"
                                           EditarClick="Tabla_EditarClick"/>
        </Border>

        <!-- Capa modal para alertas -->
        <Grid x:Name="OverlayModal" Visibility="Collapsed" Background="#33000000">
            <controls:ModalExitoControl x:Name="CtrlExito"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="Modal_CerrarClick"
                                        CerrarClick="Modal_CerrarClick"/>
            <controls:ModalAvisoControl x:Name="CtrlAviso"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="Modal_CerrarClick"
                                        CerrarClick="Modal_CerrarClick"/>
        </Grid>
    </Grid>
</UserControl>
