<Window x:Class="ClinicSyncDesktop.Views.RecuperacionContrasenaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicSync | Recuperación de contraseña"
        Height="550"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#2197AA">

    <Window.Resources>

        <!-- BOTONES REDONDEADOS -->
        <Style x:Key="BotonRedondeado"
           TargetType="Button">

            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#0789AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        x:Name="BordeBoton"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- EFECTO AL PASAR EL MOUSE -->
                            <Trigger
                            Property="IsMouseOver"
                            Value="True">

                                <Setter
                                TargetName="BordeBoton"
                                Property="Opacity"
                                Value="0.85"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ESTILO PARA MENSAJES DE ERROR -->
        <Style x:Key="EstiloError"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#B91C1C"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="Margin"
                    Value="0,4,0,0"/>
            <Setter Property="Visibility"
                    Value="Collapsed"/>
        </Style>

        <!-- ESTILO DE LOS CAMPOS -->
        <Style x:Key="EstiloTextBox"
               TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="EstiloPasswordBox"
               TargetType="PasswordBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Border Background="#78BDCC"
                Width="380"
                Padding="25"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="CLINIC SYNC"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- PANTALLA 1: CORREO -->
                <StackPanel x:Name="PanelCorreo">

                    <TextBlock Text="Restablecer contraseña"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Correo electrónico:"
                               FontWeight="SemiBold"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,15,0,5" Height="23"/>

                    <TextBox x:Name="TxtCorreo"
                             Style="{StaticResource EstiloTextBox}"
                             Background="White"
                             VerticalContentAlignment="Center"
                             MaxLength="320"
                             TextChanged="TxtCorreo_TextChanged" Width="312">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="10,0"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>
                                </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>     
                    </TextBox>

                    <!-- ERROR DE CORREO -->
                    <TextBlock x:Name="LblErrorCorreo"
                               Style="{StaticResource EstiloError}"/>

                    <Button x:Name="BtnEnviarCodigo"
                            Content="Enviar código"
                            Height="38"
                            Margin="0,20,0,0"
                            Background="#087FA4"
                            Foreground="White"
                            Style="{StaticResource BotonRedondeado}"
                            Click="BtnEnviarCodigo_Click" Width="310"/>

                </StackPanel>

                <!-- PANTALLA 2: CÓDIGO -->
                <StackPanel x:Name="PanelCodigo"
                            Visibility="Collapsed">

                    <TextBlock Text="Verificar código"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Ingrese el código recibido en su correo:"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,15,0,5"/>

                    <TextBox x:Name="TxtCodigo"
                             Style="{StaticResource EstiloTextBox}"
                             MaxLength="6"
                             HorizontalContentAlignment="Center"
                             PreviewTextInput="TxtCodigo_PreviewTextInput"
                             TextChanged="TxtCodigo_TextChanged"/>

                    <!-- ERROR DE CÓDIGO -->
                    <TextBlock x:Name="LblErrorCodigo"
                               Style="{StaticResource EstiloError}"/>

                    <Button Content="Continuar"
                            Height="38"
                            Margin="0,20,0,0"
                            Background="#087FA4"
                            Foreground="White"
                            Style="{StaticResource BotonRedondeado}"
                            Click="BtnContinuar_Click"/>

                    <Button x:Name="BtnReenviar"
                            Content="Enviar otro código"
                            Margin="0,10,0,0"
                            Style="{StaticResource BotonRedondeado}"
                            Click="BtnReenviar_Click"/>

                </StackPanel>

                <!-- PANTALLA 3: CONTRASEÑA -->
                <StackPanel x:Name="PanelNuevaPassword"
                            Visibility="Collapsed">

                    <TextBlock Text="Nueva contraseña"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Nueva contraseña:"
                               Foreground="White"
                               Margin="0,15,0,5"/>

                    <PasswordBox x:Name="TxtNuevaPassword"
                                 Style="{StaticResource EstiloPasswordBox}"
                                 PasswordChanged="TxtNuevaPassword_PasswordChanged"/>

                    <!-- ERROR DE CONTRASEÑA -->
                    <TextBlock x:Name="LblErrorPassword"
                               Style="{StaticResource EstiloError}"/>

                    <TextBlock Text="Confirmar contraseña:"
                               Foreground="White"
                               Margin="0,15,0,5"/>

                    <PasswordBox x:Name="TxtConfirmarPassword"
                                 Style="{StaticResource EstiloPasswordBox}"
                                 PasswordChanged="TxtConfirmarPassword_PasswordChanged"/>

                    <!-- ERROR DE CONFIRMACIÓN -->
                    <TextBlock x:Name="LblErrorConfirmar"
                               Style="{StaticResource EstiloError}"/>

                    <TextBlock Text="Mínimo 8 caracteres, con letras y números."
                               Foreground="White"
                               FontSize="11"
                               Margin="0,10,0,0"/>

                    <Button x:Name="BtnGuardarPassword"
                            Content="Guardar contraseña"
                            Height="38"
                            Margin="0,20,0,0"
                            Background="#087FA4"
                            Style="{StaticResource BotonRedondeado}"
                            Foreground="White"
                            Click="BtnGuardarPassword_Click"/>

                </StackPanel>

                <!-- MENSAJES GENERALES -->
                <TextBlock x:Name="LblMensajeGeneral"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           Visibility="Collapsed"/>

                <Button Content="Regresar"
                        Margin="0,15,0,0"
                        Background="#0789AB"
                        Style="{StaticResource BotonRedondeado}"
                        Click="BtnRegresar_Click" Width="311"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>
