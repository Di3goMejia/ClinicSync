<Window x:Class="ClinicSyncDesktop.Views.ImagenMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagen del material"
        Width="680"
        Height="540"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- DEGRADADO TURQUESA DE CLINICSYNC -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- BOTÓN DE CERRAR -->
        <Style x:Key="BotonCerrar"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F13F55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#D92F48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="12"
            Background="White"
            CornerRadius="14"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="14,14,0,0">

                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Imagen del material"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="txtEncabezado"
                                   FontSize="11"
                                   Foreground="#E7FFFF"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource BotonCerrar}"
                            Content="×"
                            ToolTip="Cerrar ventana"
                            Click="Cerrar_Click"/>
                </Grid>
            </Border>

            <!-- ÁREA DE LA IMAGEN -->
            <Border Grid.Row="1"
                    Margin="18"
                    Background="#F4F6F3"
                    BorderBrush="#E2E8E4"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>
                    <Image x:Name="imgMaterial"
                           Margin="12"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>

                    <TextBlock x:Name="txtSinImagen"
                               Text="No hay una imagen para mostrar."
                               Foreground="#17475A"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- PIE DE VENTANA -->
            <Border Grid.Row="2"
                    Background="White"
                    Padding="18,0,18,18">

                <TextBlock Text="ClinicSync | Inventario"
                           Foreground="#7B9297"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
