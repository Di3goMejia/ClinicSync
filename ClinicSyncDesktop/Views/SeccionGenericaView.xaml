<UserControl x:Class="ClinicSyncDesktop.Views.SeccionGenericaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Border Padding="26,14,26,26" Background="White">
        <Border CornerRadius="14" Background="{StaticResource ColorPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra azul superior -->
                <Border Grid.Row="0" Background="{StaticResource ColorAzul}"
                        CornerRadius="14,14,0,0" Height="36" Padding="14,0">
                    <TextBlock x:Name="TxtTituloBarra" Text="SECCIÓN"
                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Mensaje de estado de la sección -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="16" Padding="40,30" MaxWidth="500">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#1E4A63" Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource ColorAzul}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,7V13H17V11H13V7H11Z"
                                      Fill="White" Width="28" Height="28" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="TxtTituloSeccion" Text="Módulo en Preparación"
                                       Foreground="{StaticResource ColorTexto}" FontWeight="Bold"
                                       FontSize="17" TextAlignment="Center" Margin="0,0,0,8"/>

                            <TextBlock x:Name="TxtDescripcionSeccion"
                                       Text="Esta vista utiliza el mismo diseño base y contenedores reutilizables del sistema ClinicSync."
                                       Foreground="{StaticResource ColorTextoClaro}" FontSize="13"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
