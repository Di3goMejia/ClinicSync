<UserControl x:Class="ClinicSyncDesktop.Views.TratamientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClinicSyncDesktop.Controls"
             Background="White">

    <Grid>
        <!-- Zona principal con la tabla de tratamientos -->
        <Border Padding="26,14,26,26" Background="White">
            <controls:TratamientosTablaControl x:Name="TablaTratamientos"
                                              AgregarNuevoClick="Tabla_AgregarNuevoClick"
                                              EditarClick="Tabla_EditarClick"/>
        </Border>

        <!-- Capa modal unificada para formularios y popups -->
        <Grid x:Name="OverlayModal" Visibility="Collapsed" Background="#33000000">

            <!-- Formulario de agregar / editar tratamiento -->
            <controls:TratamientoFormularioControl x:Name="CtrlFormulario"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Guardado="Formulario_Guardado"
                                                  Cerrado="Formulario_Cerrado"
                                                  AvisoRequerido="Formulario_AvisoRequerido"
                                                  ConfirmarDescarte="Formulario_ConfirmarDescarte"/>

            <!-- Popup de éxito -->
            <controls:ModalExitoControl x:Name="CtrlExito"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="ModalExito_AceptarClick"
                                        CerrarClick="ModalExito_AceptarClick"/>

            <!-- Popup de error -->
            <controls:ModalErrorControl x:Name="CtrlError"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="ModalError_AceptarClick"
                                        CerrarClick="ModalError_AceptarClick"/>

            <!-- Popup de aviso -->
            <controls:ModalAvisoControl x:Name="CtrlAviso"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="ModalAviso_AceptarClick"
                                        CerrarClick="ModalAviso_AceptarClick"/>

            <!-- Popup de cuidado / confirmación -->
            <controls:ModalCuidadoControl x:Name="CtrlCuidado"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SiClick="ModalCuidado_SiClick"
                                          NoClick="ModalCuidado_NoClick"/>
        </Grid>
    </Grid>
</UserControl>
