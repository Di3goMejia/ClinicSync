<UserControl x:Class="ClinicSyncDesktop.Views.AvisoNotificacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="315"
             Height="48"
             Background="Transparent">

    <Border Background="#17475A"
            CornerRadius="24"
            ClipToBounds="True">

        <Grid Margin="7,4,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="imgEstado"
                   Grid.Column="0"
                   Width="34"
                   Height="34"
                   Stretch="Uniform"/>

            <TextBlock x:Name="txtMensaje"
                       Grid.Column="1"
                       Foreground="White"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="2"
                    Width="20"
                    Height="20"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Cerrar_Click">

                <Image Source="/Resources/ImagenesAvisos/cerrar-aviso.png"
                       Width="15"
                       Height="15"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
