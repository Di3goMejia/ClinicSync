<Window x:Class="ClinicSyncDesktop.Views.ConfirmarDescarteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descartar"
        Width="235"
        Height="195"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- DEGRADADO TURQUESA -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB"
                          Offset="0"/>
            <GradientStop Color="#138DAA"
                          Offset="1"/>
        </LinearGradientBrush>

        <!-- BOTONES REDONDEADOS -->
        <Style x:Key="BotonRedondo"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#92D4DE"/>

            <Setter Property="Foreground"
                    Value="#17475A"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#B6E7ED"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- VENTANA PRINCIPAL -->
    <Border Margin="9"
            Background="White"
            CornerRadius="15"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="4"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO CON DEGRADADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="15,15,0,0">

                <Grid Margin="12,0,8,0">

                    <TextBlock Text="Descartar"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- BOTÓN CERRAR -->
                    <Button Width="23"
                            Height="23"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="No_Click">

                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Stretch="Uniform"/>

                    </Button>

                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- ICONO DE ADVERTENCIA -->

                <!-- MENSAJE -->
                <!-- ICONO DE ADVERTENCIA -->
                <Image Source="/Resources/ImagenesAvisos/IconoAviso.png"
                       Width="53"
                       Height="53"
                       Stretch="Uniform"
                       />

                <!-- MENSAJE -->
                <TextBlock x:Name="txtMensaje"
                           Text="¿Seguro que desea descartar este registro?"
                           Foreground="#17475A"
                           FontSize="14"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="8,0"
                           VerticalAlignment="Center"/>

            </StackPanel>

            <!-- PIE CON DEGRADADO -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,15,15">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- SÍ -->
                    <Button Content="Sí"
                            Width="83"
                            Height="23"
                            Margin="0,0,5,0"
                            Style="{StaticResource BotonRedondo}"
                            Click="Si_Click"/>

                    <!-- NO -->
                    <Button Content="No"
                            Width="83"
                            Height="23"
                            Margin="5,0,0,0"
                            Style="{StaticResource BotonRedondo}"
                            Click="No_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>
