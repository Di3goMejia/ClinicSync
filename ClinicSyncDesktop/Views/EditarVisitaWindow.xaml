<Window x:Class="ClinicSyncDesktop.Views.EditarVisitaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar visita"
        Width="630"
        Height="565"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Ventana_Loaded">

    <Window.Resources>

        <!-- PESTAÑAS REDONDEADAS -->
        <Style x:Key="EstiloPestana" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="Background" Value="#D1D7D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CAMPOS REDONDEADOS -->
        <Style x:Key="EstiloCampo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="3"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES SIN BORDE -->
        <Style x:Key="BotonSinBorde" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#17475A"/>
        </Style>

        <!-- FILAS DE TRATAMIENTOS -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#D9DDD8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="37"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Background="White"
            CornerRadius="17"
            ClipToBounds="True">
        

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="47"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="#2198A8"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown"
                    CornerRadius="15,15,0,0">

                <Grid Margin="18,0,12,0">

                    <TextBlock Text="Editar visita"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Button Width="31"
                            Height="31"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonSinBorde}"
                            Click="Cerrar_Click">

                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <Grid Grid.Row="1"
                  Margin="35,25,35,15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PESTAÑAS -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">

                    <Button x:Name="btnAntecedentes"
                            Content="Antecedentes"
                            Style="{StaticResource EstiloPestana}"
                            Click="Antecedentes_Click"/>

                    <Button x:Name="btnTratamientos"
                            Content="Tratamientos"
                            Style="{StaticResource EstiloPestana}"
                            Click="Tratamientos_Click"/>

                    <Button x:Name="btnNotas"
                            Content="Notas"
                            Style="{StaticResource EstiloPestana}"
                            Click="Notas_Click"/>
                </StackPanel>

                <!-- ANTECEDENTES -->
                <Grid x:Name="PanelAntecedentes"
                      Grid.Row="1"
                      Margin="5,18,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DOCTOR -->
                    <TextBlock Grid.Row="0"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#17475A"
                               VerticalAlignment="Center">
                        <Run Text="Doctor(a): "/>
                        <Run Text="*" Foreground="#E34462"/>
                    </TextBlock>

                    <TextBox x:Name="txtDoctor"
                             Grid.Row="0"
                             Grid.Column="1"
                             Height="33"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Focusable="False"
                             Style="{StaticResource EstiloCampo}"/>

                    <!-- FECHA -->
                    <TextBlock Grid.Row="1"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#17475A"
                               VerticalAlignment="Center">
                        <Run Text="Fecha: "/>
                        <Run Text="*" Foreground="#E34462"/>
                                        </TextBlock>

                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          Height="33"
                          VerticalAlignment="Center">

                        <TextBox x:Name="txtFecha"
                                 Style="{StaticResource EstiloCampo}"/>

                        <Button Width="35"
                                HorizontalAlignment="Right"
                                Style="{StaticResource BotonSinBorde}"
                                Click="Calendario_Click">

                            <Image Source="/Resources/ImagenesPacientes/calendario.png"
                                   Width="22"
                                   Height="22"/>
                        </Button>

                        <Popup x:Name="PopupFecha"
                               Placement="Bottom"
                               StaysOpen="False">

                            <Border Background="White"
                                    BorderBrush="#D1D7D8"
                                    BorderThickness="1">

                                <Calendar x:Name="calFecha"
                                          SelectedDatesChanged="Calendario_SelectedDatesChanged"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- MOTIVO -->
                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#17475A"
                               VerticalAlignment="Center">
                        <Run Text="Motivo: "/>
                        <Run Text="*" Foreground="#E34462"/>
                                        </TextBlock>

                    <TextBox x:Name="txtMotivo"
                             Grid.Row="3"
                             Grid.ColumnSpan="2"
                             Style="{StaticResource EstiloCampo}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </Grid>

                <!-- TRATAMIENTOS -->
                <Grid x:Name="PanelTratamientos"
                      Grid.Row="1"
                      Margin="0,18,0,0"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR -->
                    <Border Grid.Row="0"
                            Background="#2198A8"
                            CornerRadius="15,15,0,0">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,5">

                            <TextBlock Text="Buscar:"
                                       Foreground="White"
                                       FontSize="17"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Border Background="White"
                                    CornerRadius="15"
                                    Width="290"
                                    Height="27">

                                <TextBox x:Name="txtBuscar"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Padding="10,3"
                                         TextChanged="Buscar_TextChanged"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TABLA -->
                    <Border Grid.Row="1"
                            Background="#D9DDD8"
                            CornerRadius="0,0,15,15"
                            ClipToBounds="True">

                        <DataGrid x:Name="dgTratamientos"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#C8CFCA"
                                  VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <!-- SELECCIÓN -->
                                <DataGridTemplateColumn Header=""
                                                        Width="75">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="27"
                                                    Height="27"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource BotonSinBorde}"
                                                    Click="SeleccionarTratamiento_Click">

                                                <Image Width="24"
                                                       Height="24">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source"
                                                                    Value="/Resources/ImagenesPacientes/ImagenesExpediente/seleccion-sin-marcar.png"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Seleccionado}"
                                                                             Value="True">
                                                                    <Setter Property="Source"
                                                                            Value="/Resources/ImagenesPacientes/ImagenesExpediente/seleccion-marcada.png"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CANTIDAD -->
                                <DataGridTemplateColumn Header="Cantidad"
                                                        Width="135">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <Button Content="−"
                                                        Width="25"
                                                        FontSize="16"
                                                        Style="{StaticResource BotonSinBorde}"
                                                        Click="Restar_Click"/>

                                                <TextBlock Text="{Binding Cantidad}"
                                                           Width="25"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#17475A"
                                                           FontSize="15"/>

                                                <Button Content="+"
                                                        Width="25"
                                                        FontSize="16"
                                                        Style="{StaticResource BotonSinBorde}"
                                                        Click="Sumar_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- NOMBRE -->
                                <DataGridTextColumn Header="Nombre del tratamiento"
                                                    Binding="{Binding Nombre}"
                                                    Width="*">

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#17475A"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- NOTAS -->
                <Grid x:Name="PanelNotas"
                      Grid.Row="1"
                      Margin="5,18,0,0"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Observaciones:"
                               Foreground="#17475A"
                               FontSize="17"
                               FontWeight="Bold"/>

                    <TextBox x:Name="txtNotas"
                             Grid.Row="1"
                             Style="{StaticResource EstiloCampo}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- ARCHIVOS -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="Archivos:"
                                   Foreground="#17475A"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button HorizontalAlignment="Right"
                                Width="95"
                                Height="27"
                                Style="{StaticResource BotonSinBorde}"
                                Click="SubirArchivo_Click">

                            <Border Background="#D9DDD8"
                                    CornerRadius="15"
                                    Padding="9,3">

                                <StackPanel Orientation="Horizontal">

                                    <Image Source="/Resources/ImagenesPacientes/ImagenesExpediente/subir-archivo.png"
                                           Width="19"
                                           Height="19"
                                           Margin="0,0,5,0"/>

                                    <TextBlock Text="Subir"
                                               Foreground="#138DAA"
                                               FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="#D9DDD8"
                            CornerRadius="12"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PanelArchivos"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ERROR -->
                <TextBlock x:Name="txtError"
                           Grid.Row="2"
                           Foreground="#E34462"
                           FontSize="12"
                           Margin="5,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- PIE -->
            <Border Grid.Row="2"
                    Background="#2198A8"
                    CornerRadius="0,0,15,15">
                

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="128"
                        Height="33"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,35,0"
                        Background="#8DD5E8"
                        Foreground="#17475A"
                        FontSize="17"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Guardar_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
