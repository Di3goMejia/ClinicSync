<Window x:Class="ClinicSyncDesktop.Views.EditarTratamientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar tratamiento"
        Width="370"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="12"
            ClipToBounds="True"
            BorderThickness="1"
            BorderBrush="#D5DEDA">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="11,11,0,0"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Barra_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Editar tratamiento:"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="19"
                            Height="20"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#E8424B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Cerrar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- FORMULARIO -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="16,10,16,8">

                    <!-- NOMBRE OBLIGATORIO -->
                    <StackPanel Margin="0,0,0,8">

                        <StackPanel Orientation="Horizontal"
                                    Margin="3,0,0,4">

                            <TextBlock Text="Nombre del tratamiento:"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#244B65"/>

                            <TextBlock Text=" *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#E8424B"/>
                        </StackPanel>

                        <TextBox x:Name="TxtNombre"
                                 Height="36"
                                 Padding="8,0"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Background="#D9DDD8"
                                 Foreground="#244B65"
                                 BorderThickness="0"
                                 MaxLength="100"
                                 TextChanged="TxtNombre_TextChanged">

                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            BorderBrush="#D0D8D2"
                                            BorderThickness="1">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <!-- PRECIO OBLIGATORIO -->
                    <StackPanel Margin="0,0,0,8">

                        <StackPanel Orientation="Horizontal"
                                    Margin="3,0,0,4">

                            <TextBlock Text="Precio base:"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#244B65"/>

                            <TextBlock Text=" *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#E8424B"/>
                        </StackPanel>

                        <TextBox x:Name="TxtPrecio"
                                 Width="115"
                                 Height="36"
                                 HorizontalAlignment="Left"
                                 Padding="8,0"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Background="#D9DDD8"
                                 Foreground="#244B65"
                                 BorderThickness="0"
                                 ToolTip="Precio en lempiras"
                                 TextChanged="TxtPrecio_TextChanged">

                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            BorderBrush="#D0D8D2"
                                            BorderThickness="1">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <!-- DESCRIPCIÓN OPCIONAL -->
                    <StackPanel Margin="0,0,0,8">

                        <TextBlock Text="Descripción (opcional)"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#244B65"
                                   Margin="3,0,0,4"/>

                        <TextBox x:Name="TxtDescripcion"
                                 MinHeight="48"
                                 MaxHeight="60"
                                 Padding="8,6"
                                 FontSize="11"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxLength="200"
                                 Background="#D9DDD8"
                                 Foreground="#244B65"
                                 BorderThickness="0"
                                 TextChanged="TxtDescripcion_TextChanged">

                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            BorderBrush="#D0D8D2"
                                            BorderThickness="1">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Stretch"
                                                      VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <!-- ESTADO -->
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Estado:"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#244B65"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="TxtEstado"
                                   Grid.Column="2"
                                   Foreground="#1E4A63"
                                   FontSize="11"
                                   Margin="4,4,8,4"
                                   VerticalAlignment="Center"/>

                        <CheckBox x:Name="ChkActivo"
                                  Grid.Column="3"
                                  Style="{StaticResource Interruptor}"
                                  VerticalAlignment="Center"
                                  Checked="ChkActivo_Checked"
                                  Unchecked="ChkActivo_Unchecked"/>
                    </Grid>


                    <TextBlock x:Name="TxtAvisoEstado"
                               Text="⚠ El tratamiento está deshabilitado. Habilítalo para poder modificar sus datos."
                               Foreground="#FF3655"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="3,0,0,8"
                               Visibility="Collapsed"/>
                    
                    <!-- ÚNICO MENSAJE DE VALIDACIÓN -->
                    <TextBlock x:Name="TxtErrorGeneral"
                               Foreground="#E84263"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="3,5,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <!-- BOTÓN GUARDAR -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,11,11"
                    ClipToBounds="True">

                <Button x:Name="BtnGuardar"
                        Content="Guardar"
                        Width="94"
                        Height="29"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#80D2DF"
                        Foreground="#164963"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnGuardar_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
