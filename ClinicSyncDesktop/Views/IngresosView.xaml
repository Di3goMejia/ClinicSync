<UserControl x:Class="ClinicSyncDesktop.Views.IngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="ColorTexto" Color="#17465A"/>
        <SolidColorBrush x:Key="ColorFondo" Color="#D9DEDA"/>
        <SolidColorBrush x:Key="ColorTotal" Color="#00A98B"/>

        <!-- ESTILO GENERAL DE LOS FILTROS -->
        <Style x:Key="EstiloFiltro" TargetType="Button">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="#E8F0F0"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ENCABEZADOS -->
        <Style x:Key="EstiloEncabezado"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9DEDA"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- TEXTO DE LAS CELDAS -->
        <Style x:Key="EstiloTextoCelda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- TEXTO DEL TOTAL -->
        <Style x:Key="EstiloTotal" TargetType="TextBlock"
               BasedOn="{StaticResource EstiloTextoCelda}">
            <Setter Property="Foreground" Value="#00A98B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- TEXTO NUMÉRICO -->
        <Style x:Key="EstiloNumero" TargetType="TextBlock"
               BasedOn="{StaticResource EstiloTextoCelda}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- FILAS -->
        <Style x:Key="EstiloFila" TargetType="DataGridRow">
            <Setter Property="Background" Value="#D9DEDA"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="#C4CBC8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C9DEDF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B8DBDF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CELDAS -->
        <Style x:Key="EstiloCelda" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#17465A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ENGRANAJE -->
        <Style x:Key="EstiloEngranaje" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Editar ingreso"/>
        </Style>


        <!-- ENCABEZADOS CENTRADOS -->
        <Style x:Key="EncabezadoCentrado"
       TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9DEDA"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment"
            Value="Center"/>
            <Setter Property="VerticalContentAlignment"
            Value="Center"/>
        </Style>

        <!-- TEXTO CENTRADO -->
        <Style x:Key="TextoCentrado"
       TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- DESCUENTO CENTRADO -->
        <Style x:Key="ImporteCentrado"
       TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#17465A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- TOTAL CENTRADO EN VERDE -->
        <Style x:Key="TotalCentrado"
       TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#00A98B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>


    </UserControl.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Border Background="{StaticResource ColorFondo}"
            CornerRadius="0,0,13,13"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BARRA TURQUESA CON DEGRADADO -->
            <Border Grid.Row="0"
                   CornerRadius="12,12,0,0">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,0">
                        <GradientStop Color="#32A8B0"
                                      Offset="0"/>
                        <GradientStop Color="#168FA7"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="14,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- AGREGAR NUEVO -->
                    <Button Grid.Column="0"
                            Click="AgregarNuevo_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Image Source="/Resources/ImagenesTabla/IconoMas.png"
                               Width="20"
                               Height="20"
                               Margin="5,0,10,0"/>          

                            <TextBlock Text="AGREGAR NUEVO"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- FILTROS -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Filtrar:"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Button x:Name="BtnHoy"
                                Content="Hoy"
                                Width="65"
                                Style="{StaticResource EstiloFiltro}"
                                Click="Hoy_Click"/>

                        <Button x:Name="BtnSemana"
                                Content="Semana"
                                Width="84"
                                Style="{StaticResource EstiloFiltro}"
                                Click="Semana_Click"/>

                        <Button x:Name="BtnMes"
                                Content="Mes"
                                Width="65"
                                Style="{StaticResource EstiloFiltro}"
                                Click="Mes_Click"/>

                        <Button x:Name="BtnTodos"
                                Content="Todos"
                                Width="85"
                                Style="{StaticResource EstiloFiltro}"
                                Click="BtnTodos_Click"/>    

                    </StackPanel>
                </Grid>
            </Border>

            <!-- TABLA DE INGRESOS -->
            <DataGrid x:Name="DgIngresos"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      RowHeight="38"
                      ColumnHeaderHeight="38"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="#D9DEDA"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource EstiloEncabezado}"
                      RowStyle="{StaticResource EstiloFila}"
                      CellStyle="{StaticResource EstiloCelda}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                <DataGrid.Columns>

                    <!-- NÚMERO -->
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding IdIngreso}"
                                        Width="48"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <!-- FECHA -->
                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding Fecha, StringFormat=yyyy/MM/dd}"
                                        Width="115"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <!-- PACIENTE -->
                    <DataGridTextColumn Header="Paciente"
                                        Binding="{Binding Paciente}"
                                        Width="2*"
                                        MinWidth="145"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <!-- TRATAMIENTO -->
                    <DataGridTextColumn Header="Tratamiento"
                                        Binding="{Binding Tratamiento}"
                                        Width="2*"
                                        MinWidth="145"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>


                    <!-- MEDIO DE PAGO -->
                    <DataGridTextColumn Header="Medio de pago"
                    Binding="{Binding MedioPago}"
                    Width="145"
                    HeaderStyle="{StaticResource EncabezadoCentrado}"
                    ElementStyle="{StaticResource TextoCentrado}"/>

                    <!-- DESCUENTO -->
                    <DataGridTextColumn Header="Descuento"
                    Binding="{Binding Descuento, StringFormat=L {0:N2}}"
                    Width="125"
                    HeaderStyle="{StaticResource EncabezadoCentrado}"
                    ElementStyle="{StaticResource ImporteCentrado}"/>

                    <!-- TOTAL -->
                    <DataGridTextColumn Header="Total"
                    Binding="{Binding Total, StringFormat=L {0:N2}}"
                    Width="125"
                    HeaderStyle="{StaticResource EncabezadoCentrado}"
                    ElementStyle="{StaticResource TotalCentrado}"/>


                    <!-- BOTÓN EDITAR -->
                    <DataGridTemplateColumn Header=""
                        Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                    Width="35"
                    Height="35"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Editar ingreso"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="EditarIngreso_Click">

                                    <Image Source="/Resources/ImagenesTabla/IconoEngranaje.png"
                       Width="23"
                       Height="23"
                       Stretch="Uniform"/>

                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                </DataGrid.Columns>
            </DataGrid>

            <!-- ERROR DEL LISTADO -->
            <TextBlock x:Name="ErrorListado"
                       Grid.Row="2"
                       Foreground="#E52B50"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="12,6"
                       Visibility="Collapsed"/>

        </Grid>
    </Border>
</UserControl>
