<Window x:Class="ClinicSyncDesktop.Views.AgregarTratamientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar nuevo tratamiento"
        Width="370"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Mismo degradado del menú principal -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="12"
            ClipToBounds="True"
            BorderThickness="1"
            BorderBrush="#D5DEDA">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Barra superior con esquinas redondeadas -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="11,11,0,0"
                    ClipToBounds="True">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Agregar nuevo tratamiento:"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="19"
                            Height="20"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="#E8424B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Cerrar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Campos del formulario -->
            <Grid Grid.Row="1" Margin="16,10,16,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nombre obligatorio -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal"
                                Margin="3,0,0,4">
                        <TextBlock Text="Nombre del tratamiento:"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#244B65"/>

                        <TextBlock Text=" *"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#E8424B"/>
                    </StackPanel>

                    <TextBox x:Name="txtNombre"
                             Height="29"
                             Padding="8,0"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             Background="#D9DDD8"
                             Foreground="#244B65"
                             BorderThickness="0"
                             MaxLength="100">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        BorderBrush="#D0D8D2"
                                        BorderThickness="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>

                <!-- Precio obligatorio -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal"
                                Margin="3,0,0,4">
                        <TextBlock Text="Precio base:"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#244B65"/>

                        <TextBlock Text=" *"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#E8424B"/>
                    </StackPanel>

                    <TextBox x:Name="txtPrecio"
                             Width="115"
                             Height="29"
                             HorizontalAlignment="Left"
                             Padding="8,0"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             Background="#D9DDD8"
                             Foreground="#244B65"
                             BorderThickness="0"
                             ToolTip="Precio en lempiras">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        BorderBrush="#D0D8D2"
                                        BorderThickness="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>

                <!-- Descripción opcional -->
                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal"
                                Margin="3,0,0,4">
                        <TextBlock Text="Descripción"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#244B65"/>

                        <TextBlock Text=" (opcional)"
                                   FontSize="10"
                                   Foreground="#71817D"/>
                    </StackPanel>

                    <TextBox x:Name="txtDescripcion"
                             MinHeight="48"
                             MaxHeight="60"
                             Padding="8,6"
                             FontSize="11"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxLength="200"
                             Background="#D9DDD8"
                             Foreground="#244B65"
                             BorderThickness="0">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        BorderBrush="#D0D8D2"
                                        BorderThickness="1">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Stretch"
                                                  VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>
            </Grid>

            <!-- Barra inferior con esquinas redondeadas -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,11,11"
                    ClipToBounds="True">

                <Button x:Name="btnAgregar"
                        Content="Agregar"
                        Width="94"
                        Height="29"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#80D2DF"
                        Foreground="#164963"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Agregar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
