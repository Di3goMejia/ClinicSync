<UserControl x:Class="ClinicSyncDesktop.Views.Notificaciones.NotificacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             MinWidth="520">

    <UserControl.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="ColorTexto"
                         Color="#17475A"/>

        <SolidColorBrush x:Key="ColorCampos"
                         Color="#D9DEDA"/>

        <SolidColorBrush x:Key="ColorFondo"
                         Color="#F5F7F5"/>

        <!-- DEGRADADO TURQUESA -->
        <LinearGradientBrush x:Key="BarraNotificaciones"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A8B0"
                          Offset="0"/>
            <GradientStop Color="#168FA7"
                          Offset="1"/>
        </LinearGradientBrush>

        <!-- ETIQUETAS -->
        <Style x:Key="EstiloEtiqueta"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#17475A"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <!-- CAMPO DE BÚSQUEDA REDONDEADO -->
        <Style x:Key="CampoRedondeado"
               TargetType="TextBox">

            <Setter Property="Height" Value="32"/>
            <Setter Property="Background"
                    Value="#D9DEDA"/>
            <Setter Property="Foreground"
                    Value="#17475A"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="16">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX REDONDEADO -->
        <Style x:Key="ComboRedondeado"
               TargetType="ComboBox">

            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="165"/>
            <Setter Property="Background"
                    Value="#D9DEDA"/>
            <Setter Property="Foreground"
                    Value="#17475A"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- FONDO REDONDEADO -->
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"/>

                            <!-- BOTÓN DESPLEGABLE -->
                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        IsHitTestVisible="False"/>

                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="#168FA7"
                                          Width="10"
                                          Height="5"
                                          Stretch="Fill"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                                </Grid>

                            </ToggleButton>

                            <!-- LISTADO DESPLEGABLE -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">

                                <Border
                                    Width="{Binding ActualWidth,
                                        RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="White"
                                    BorderBrush="#C4D2D0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="2">

                                    <ScrollViewer
                                        MaxHeight="200"
                                        VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>
                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE ACCIÓN -->
        <Style x:Key="AccionNotificacion"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#17475A"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Padding"
                    Value="10,6"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="FondoAccion"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="FondoAccion"
                                        Property="Background"
                                        Value="#D9DEDA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN LIMPIAR -->
        <Style x:Key="BotonLimpiar"
               TargetType="Button"
               BasedOn="{StaticResource AccionNotificacion}">

            <Setter Property="Background"
                    Value="#D9DEDA"/>
            <Setter Property="MinWidth"
                    Value="80"/>
            <Setter Property="Height"
                    Value="32"/>

        </Style>

    </UserControl.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Border Background="{StaticResource ColorFondo}"
        CornerRadius="13"
        Margin="15,0,15,0"
        ClipToBounds="True">


        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Margin="15,0,15,0"
                    Background="{StaticResource BarraNotificaciones}">

                <TextBlock
                    Text="Centro de notificaciones"
                    Margin="18,0"
                    Foreground="White"
                    FontSize="17"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

            </Border>

            <!-- ZONA SUPERIOR DE FILTROS -->
            <Border Grid.Row="1"
                Background="White"
                Margin="12,0,12,10"
                Padding="15"
                CornerRadius="0,0,13,13">

                <StackPanel>

                    <!-- ACCIONES -->
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,14">

                        <Button
                            Content="Marcar como leído"
                            Style="{StaticResource AccionNotificacion}"
                            Click="MarcarTodas_Click"/>

                    </StackPanel>

                    <!-- BUSCADOR Y FECHA -->
                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Buscar:"
                            Grid.Column="0"
                            Style="{StaticResource EstiloEtiqueta}"
                            Margin="0,0,10,0"/>

                        <TextBox
                            x:Name="TxtBuscar"
                            Grid.Column="1"
                            Style="{StaticResource CampoRedondeado}"
                            Margin="0,0,16,0"
                            TextChanged="FiltroCambiado"/>

                        <TextBlock
                            Text="Período:"
                            Grid.Column="2"
                            Style="{StaticResource EstiloEtiqueta}"
                            Margin="0,0,10,0"/>

                        <!-- FECHA REDONDEADA -->
                        <Border Grid.Column="3"
                                Background="#D9DEDA"
                                CornerRadius="16"
                                Height="32"
                                ClipToBounds="True">

                            <DatePicker
                                x:Name="DpDesde"
                                Background="#D9DEDA"
                                Foreground="#17475A"
                                BorderThickness="0"
                                FontSize="12"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="FiltroFechaCambiado"/>

                        </Border>

                    </Grid>

                    <!-- COMBOBOX DE FILTROS -->
                    <StackPanel Orientation="Horizontal">

                        <ComboBox
                            x:Name="CmbTipo"
                            Style="{StaticResource ComboRedondeado}"
                            SelectedIndex="0"
                            SelectionChanged="ComboCambiado"
                            Margin="0,0,12,0">

                            <ComboBoxItem
                                Content="Todos los tipos"
                                Tag=""/>

                            <ComboBoxItem
                                Content="Citas"
                                Tag="CITA"/>

                            <ComboBoxItem
                                Content="Stock bajo"
                                Tag="STOCK"/>

                        </ComboBox>

                        <ComboBox
                            x:Name="CmbEstado"
                            Style="{StaticResource ComboRedondeado}"
                            SelectedIndex="0"
                            SelectionChanged="ComboCambiado"
                            Margin="0,0,12,0">

                            <ComboBoxItem
                                Content="Todos los estados"
                                Tag=""/>

                            <ComboBoxItem
                                Content="Pendientes"
                                Tag="PENDIENTE"/>

                            <ComboBoxItem
                                Content="Leídas"
                                Tag="LEIDA"/>

                        </ComboBox>

                        <Button
                            Content="Limpiar"
                            Style="{StaticResource BotonLimpiar}"
                            Click="Limpiar_Click"/>

                    </StackPanel>

                    <!-- ERRORES -->
                    <TextBlock
                        x:Name="ErrorListado"
                        Foreground="#E52B50"
                        FontSize="12"
                        Margin="4,10,0,0"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"/>

                </StackPanel>

            </Border>

            <!-- CONTENEDOR DEL LISTADO -->
            <Border Grid.Row="2"
                    Background="White"
                    Margin="12,-10,12,12"
                    Padding="12"
                    CornerRadius="13">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <!-- AQUÍ APARECEN LAS TARJETAS -->
                    <StackPanel
                        x:Name="Lista"/>

                </ScrollViewer>

            </Border>

            <!-- BARRA INFERIOR -->
            <Border Grid.Row="3"
                    CornerRadius="0,0,10,10"
                    Background="{StaticResource BarraNotificaciones}"/>

        </Grid>

    </Border>

</UserControl>


