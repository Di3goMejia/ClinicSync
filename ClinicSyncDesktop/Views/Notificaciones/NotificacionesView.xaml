<UserControl x:Class="ClinicSyncDesktop.Views.Notificaciones.NotificacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             MinWidth="520">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorTexto" Color="#17475A"/>
        <SolidColorBrush x:Key="ColorCampos" Color="#D9DEDA"/>

        <LinearGradientBrush x:Key="BarraNotificaciones"
                             StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A8B0" Offset="0"/>
            <GradientStop Color="#168FA7" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="EstiloEtiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CampoRedondeado" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource ColorCampos}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboRedondeado" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="165"/>
            <Setter Property="Background" Value="{StaticResource ColorCampos}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="BotonDesplegable"
                                  Background="{TemplateBinding Background}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Focusable="False"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen,
                                      RelativeSource={RelativeSource TemplatedParent},
                                      Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Fondo"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="16">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fondo"
                                                Property="Background"
                                                Value="#CFE6E7"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Fondo"
                                                Property="Background"
                                                Value="#B8DBDF"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Fondo"
                                                Property="Background"
                                                Value="#B8DBDF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>

                                    <Path Grid.Column="1"
                                  Data="M 0 0 L 5 5 L 10 0 Z"
                                  Fill="#168FA7"
                                  Width="10"
                                  Height="5"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                                </Grid>
                            </ToggleButton>

                            <Border x:Name="BordeFoco"
                            CornerRadius="16"
                            BorderBrush="#168FA7"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>

                            <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=BotonDesplegable}"
                           AllowsTransparency="True"
                           Focusable="False">
                                <Border Width="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                Background="White"
                                BorderBrush="#C4D2D0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="2">
                                    <ScrollViewer MaxHeight="200"
                                          VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BordeFoco"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccionNotificacion" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoAccion"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoAccion"
                                        Property="Background"
                                        Value="{StaticResource ColorCampos}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonLimpiar"
               TargetType="Button"
               BasedOn="{StaticResource AccionNotificacion}">
            <Setter Property="Background" Value="{StaticResource ColorCampos}"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="SelectorFechaNotificacion" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource ColorCampos}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Button x:Name="PART_Button"
                                    Background="{TemplateBinding Background}"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Abrir calendario">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="16"
                                                Padding="10,0,8,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Foreground="{StaticResource ColorTexto}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedDate,
                                                   RelativeSource={RelativeSource AncestorType={x:Type DatePicker}},
                                                   StringFormat={}{0:yyyy/MM/dd}}"/>

                                    <TextBlock x:Name="FechaPlaceholder"
                                               Text="YYYY/MM/DD"
                                               Foreground="#778580"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>

                                    <Image Grid.Column="1"
                                           Source="/Resources/ImagenesPacientes/calendario.png"
                                           Width="15" Height="15"/>
                                </Grid>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   PlacementTarget="{Binding ElementName=PART_Button}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedDate" Value="{x:Null}">
                                <Setter TargetName="FechaPlaceholder"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            CornerRadius="13"
            Margin="15,0,15,20"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="13,13,0,0"
                    Background="{StaticResource BarraNotificaciones}">
                <TextBlock Text="Centro de notificaciones"
                           Margin="18,0"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Padding="15">
                <StackPanel>
                    <Button Content="Marcar como leído"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,14"
                            Style="{StaticResource AccionNotificacion}"
                            Click="MarcarTodas_Click"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Buscar:"
                                   Style="{StaticResource EstiloEtiqueta}"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="TxtBuscar"
                                 Grid.Column="1"
                                 Style="{StaticResource CampoRedondeado}"
                                 Margin="0,0,16,0"
                                 TextChanged="FiltroCambiado"/>

                        <TextBlock Grid.Column="2"
                                   Text="Período:"
                                   Style="{StaticResource EstiloEtiqueta}"
                                   Margin="0,0,10,0"/>

                        <DatePicker x:Name="DpDesde"
                                    Grid.Column="3"
                                    Language="es-HN"
                                    AutomationProperties.Name="Período"
                                    ToolTip="Mostrar notificaciones desde esta fecha"
                                    Style="{StaticResource SelectorFechaNotificacion}"
                                    SelectedDateChanged="FiltroFechaCambiado"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbTipo"
                                  Style="{StaticResource ComboRedondeado}"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboCambiado"
                                  Margin="0,0,12,0"
                                  FontWeight="SemiBold">
                            <ComboBoxItem Content="Todos los tipos" Tag=""/>
                            <ComboBoxItem Content="Citas" Tag="CITA"/>
                            <ComboBoxItem Content="Stock bajo" Tag="STOCK"/>
                        </ComboBox>

                        <ComboBox x:Name="CmbEstado"
                                  Style="{StaticResource ComboRedondeado}"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboCambiado"
                                  Margin="0,0,12,0"
                                  FontWeight="SemiBold">
                            <ComboBoxItem Content="Todos los estados" Tag=""/>
                            <ComboBoxItem Content="Pendientes" Tag="PENDIENTE"/>
                            <ComboBoxItem Content="Leídas" Tag="LEIDA"/>
                        </ComboBox>

                        <Button Content="Limpiar filtro"
                                Style="{StaticResource BotonLimpiar}"
                                Click="Limpiar_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorListado"
                               Foreground="#E52B50"
                               FontSize="12"
                               Margin="4,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Padding="15,0,15,15">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Lista"/>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</UserControl>