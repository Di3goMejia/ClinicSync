<Window x:Class="ClinicSyncDesktop.Views.EditarTratamientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar tratamiento"
        Width="460"
        Height="410"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoDescripcion"
               TargetType="TextBox"
               BasedOn="{StaticResource Campo}">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="BotonRedondo" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#B6E7ED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Width" Value="39"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Fondo"
                                    Background="#D9DDD8"
                                    CornerRadius="11"/>

                            <Ellipse x:Name="Circulo"
                                     Width="16"
                                     Height="16"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#23A995"/>
                                <Setter TargetName="Circulo"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Circulo"
                                        Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="9"
            Background="White"
            CornerRadius="15"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="5"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="Barra_MouseLeftButtonDown">
                <Grid Margin="12,0,9,0">
                    <TextBlock Text="Editar tratamiento:"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="10,0,34,0"/>

                    <Button Width="23"
                            Height="23"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            AutomationProperties.Name="Cerrar"
                            Click="Cerrar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- FORMULARIO -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,17,22,10">

                    <!-- NOMBRE -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nombre del tratamiento:"
                                   Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text=" *"
                                   Foreground="#CF4059"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox x:Name="TxtNombre"
                             Margin="0,5,0,0"
                             Style="{StaticResource Campo}"
                             MaxLength="100"
                             TextChanged="TxtNombre_TextChanged"/>

                    <!-- PRECIO BASE -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Precio base:"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text=" *"
                                       Foreground="#CF4059"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBox x:Name="TxtPrecio"
                                 Width="165"
                                 HorizontalAlignment="Left"
                                 Margin="0,5,0,0"
                                 Style="{StaticResource Campo}"
                                 ToolTip="Precio en lempiras"
                                 TextChanged="TxtPrecio_TextChanged"/>
                    </StackPanel>

                    <!-- DESCRIPCIÓN -->
                    <TextBlock Text="Descripción (opcional)"
                               Margin="0,12,0,0"
                               Style="{StaticResource Etiqueta}"/>

                    <TextBox x:Name="TxtDescripcion"
                             Margin="0,5,0,0"
                             Style="{StaticResource CampoDescripcion}"
                             MaxLength="200"
                             TextChanged="TxtDescripcion_TextChanged"/>

                    <!-- ESTADO -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Estado:"
                                       Style="{StaticResource Etiqueta}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <CheckBox x:Name="ChkActivo"
                                      Style="{StaticResource Interruptor}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Tratamiento activo"
                                      Checked="ChkActivo_Checked"
                                      Unchecked="ChkActivo_Unchecked"/>

                            <TextBlock x:Name="TxtEstado"
                                       Foreground="#17475A"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtAvisoEstado"
               Text="El tratamiento está deshabilitado. Habilítalo para poder modificar sus datos."
               Foreground="#CF4059"
               FontSize="11"
               TextWrapping="Wrap"
               Margin="0,6,0,0"
               Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- MENSAJE DE VALIDACIÓN -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding Visibility, ElementName=TxtErrorGeneral}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Resources/ImagenesAvisos/validacion-alerta.png"
                               Width="13"
                               Height="13"
                               VerticalAlignment="Top"
                               Margin="0,1,0,0"/>

                        <TextBlock x:Name="TxtErrorGeneral"
                                   Grid.Column="1"
                                   Foreground="#CF4059"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- GUARDAR -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,15,15">
                <Button x:Name="BtnGuardar"
                        Content="Guardar"
                        Width="95"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotonRedondo}"
                        Click="BtnGuardar_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>