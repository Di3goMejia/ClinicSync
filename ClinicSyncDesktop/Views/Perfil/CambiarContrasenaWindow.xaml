<Window x:Class="ClinicSyncDesktop.Views.CambiarContrasenaWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cambiar contraseña"
 Width="540"
 Height="610"
 MinHeight="590"
 WindowStartupLocation="CenterOwner"
 WindowStyle="None"
 ResizeMode="NoResize"
 AllowsTransparency="True"
 Background="Transparent"
 ShowInTaskbar="False">

    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa"
                       StartPoint="0,0"
                       EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CampoClave" TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#D9DDDA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="CampoVisible" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#D9DDDA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Border Margin="10"
         Background="White"
         CornerRadius="18"
         ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                     ShadowDepth="5"
                     Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
           Background="{StaticResource Turquesa}">

                <Grid Margin="18,0,12,0">
                    <TextBlock Text="Cambiar contraseña"
                Foreground="White"
                FontSize="18"
                FontWeight="Bold"
                VerticalAlignment="Center"/>

                    <Button Content="✕"
             Click="Cerrar_Click"
             Width="30"
             Height="29"
             HorizontalAlignment="Right"
             Background="#D83356"
             Foreground="White"
             BorderThickness="0"
             FontSize="17"
             FontWeight="Bold"
             Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- CAMPOS -->
            <ScrollViewer Grid.Row="1"
                 VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="34,24,34,15">

                    <TextBlock Text="Contraseña actual:"
                Style="{StaticResource Etiqueta}"/>

                    <Grid Margin="0,0,0,22">
                        <PasswordBox x:Name="Actual"
                   Style="{StaticResource CampoClave}"
                   PasswordChanged="Campos_PasswordChanged"
                   Padding="12,7,42,7"/>

                        <TextBox x:Name="ActualVisible"
               Style="{StaticResource CampoVisible}"
               Visibility="Collapsed"
               TextChanged="Visible_TextChanged"
               Padding="12,7,42,7"/>

                        <Button Content="◉"
              Tag="actual"
              Click="AlternarVisibilidad_Click"
              HorizontalAlignment="Right"
              Width="38"
              Background="Transparent"
              BorderThickness="0"
              Foreground="#65777C"
              ToolTip="Mostrar u ocultar contraseña"/>
                    </Grid>

                    <TextBlock Text="Nueva contraseña:"
                Style="{StaticResource Etiqueta}"/>

                    <Grid Margin="0,0,0,14">
                        <PasswordBox x:Name="Nueva"
                   Style="{StaticResource CampoClave}"
                   PasswordChanged="Campos_PasswordChanged"
                   Padding="12,7,42,7"/>

                        <TextBox x:Name="NuevaVisible"
               Style="{StaticResource CampoVisible}"
               Visibility="Collapsed"
               TextChanged="Visible_TextChanged"
               Padding="12,7,42,7"/>

                        <Button Content="◉"
              Tag="nueva"
              Click="AlternarVisibilidad_Click"
              HorizontalAlignment="Right"
              Width="38"
              Background="Transparent"
              BorderThickness="0"
              Foreground="#65777C"
              ToolTip="Mostrar u ocultar contraseña"/>
                    </Grid>

                    <TextBlock Text="Confirmar nueva contraseña:"
                Style="{StaticResource Etiqueta}"/>

                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="Confirmacion"
                   Style="{StaticResource CampoClave}"
                   PasswordChanged="Campos_PasswordChanged"
                   Padding="12,7,42,7"/>

                        <TextBox x:Name="ConfirmacionVisible"
               Style="{StaticResource CampoVisible}"
               Visibility="Collapsed"
               TextChanged="Visible_TextChanged"
               Padding="12,7,42,7"/>

                        <Button Content="◉"
              Tag="confirmacion"
              Click="AlternarVisibilidad_Click"
              HorizontalAlignment="Right"
              Width="38"
              Background="Transparent"
              BorderThickness="0"
              Foreground="#65777C"
              ToolTip="Mostrar u ocultar contraseña"/>
                    </Grid>

                    <!-- COINCIDENCIA -->
                    <TextBlock x:Name="TextoCoincidencia"
                FontSize="14"
                Margin="3,0,0,17"/>

                    <!-- REQUISITOS -->
                    <TextBlock Text="La nueva contraseña debe cumplir los siguientes requisitos:"
                Foreground="#7D8587"
                FontSize="13"
                Margin="0,0,0,7"/>

                    <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ReglaLongitud" FontSize="13"/>
                        <TextBlock x:Name="ReglaMayuscula" FontSize="13"/>
                        <TextBlock x:Name="ReglaMinuscula" FontSize="13"/>
                        <TextBlock x:Name="ReglaNumero" FontSize="13"/>
                        <TextBlock x:Name="ReglaEspecial" FontSize="13"/>
                    </StackPanel>

                    <TextBlock Text="ⓘ Al cambiar su contraseña, se cerrarán las sesiones activas en los demás dispositivos cuando el servidor implemente esa invalidación."
                TextWrapping="Wrap"
                Foreground="#7D8587"
                FontSize="12"
                Margin="0,18,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- BOTÓN GUARDAR -->
            <Border Grid.Row="2"
           Background="{StaticResource Turquesa}">

                <Button x:Name="BtnGuardar"
            Content="Cambiar"
            Click="Guardar_Click"
            Width="124"
            Height="32"
            FontSize="17"
            FontWeight="Bold"
            Background="#92D4DE"
            Foreground="#17475A"
            BorderThickness="0"
            Cursor="Hand"
            IsEnabled="False"/>
            </Border>

            <!-- NOTIFICACIONES COMPARTIDAS -->
            <StackPanel x:Name="PanelAvisos"
               Grid.RowSpan="3"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,12,54"
               Panel.ZIndex="200"
               Visibility="Collapsed"/>

        </Grid>
    </Border>
</Window>
