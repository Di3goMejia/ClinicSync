<Window x:Class="ClinicSyncDesktop.Views.CambiarContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña"
        Width="540"
        Height="610"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AzulOscuro" Color="#17475A"/>
        <SolidColorBrush x:Key="FondoCampo" Color="#D9DDDA"/>

        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AzulOscuro}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="FondoClave" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource FondoCampo}"/>
            <Setter Property="CornerRadius" Value="17"/>
        </Style>

        <Style x:Key="EntradaClave" TargetType="Control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AzulOscuro}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0,6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CampoClave" TargetType="PasswordBox"
               BasedOn="{StaticResource EntradaClave}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoVisible" TargetType="TextBox"
               BasedOn="{StaticResource EntradaClave}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonOjo" TargetType="Button"
               BasedOn="{StaticResource BotonIcono}">
            <Setter Property="ToolTip" Value="Mostrar u ocultar contraseña"/>
            <Setter Property="AutomationProperties.Name"
                    Value="Mostrar u ocultar contraseña"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Image Source="/Resources/ImagenesLogin/mostrar-contraseña.png"
                               Width="24"
                               Height="24"
                               Stretch="Uniform"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonCambiar" TargetType="Button">
            <Setter Property="Width" Value="124"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="{StaticResource AzulOscuro}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton"
                                        Property="Background"
                                        Value="#B6E7ED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="White"
            CornerRadius="18"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="5"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="18,18,0,0">
                <Grid Margin="18,0,12,0">
                    <TextBlock Text="Cambiar contraseña"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Width="25"
                            Height="25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonIcono}"
                            ToolTip="Cerrar"
                            AutomationProperties.Name="Cerrar"
                            Click="Cerrar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Width="25"
                               Height="25"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,24,34,15">
                    <TextBlock Text="Contraseña actual:"
                               Style="{StaticResource Etiqueta}"/>

                    <Border Style="{StaticResource FondoClave}"
                            Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="Actual"
                                         Style="{StaticResource CampoClave}"
                                         PasswordChanged="Campos_PasswordChanged"/>

                            <TextBox x:Name="ActualVisible"
                                     Style="{StaticResource CampoVisible}"
                                     Visibility="Collapsed"
                                     TextChanged="Visible_TextChanged"/>

                            <Button
                                    Content="Ojo"
                                    Tag="actual"
                                    Style="{StaticResource BotonOjo}"
                                    Click="AlternarVisibilidad_Click" Grid.ColumnSpan="2" Margin="399,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Nueva contraseña:"
                               Style="{StaticResource Etiqueta}"/>

                    <Border Style="{StaticResource FondoClave}"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="Nueva"
                                         Style="{StaticResource CampoClave}"
                                         PasswordChanged="Campos_PasswordChanged"/>

                            <TextBox x:Name="NuevaVisible"
                                     Style="{StaticResource CampoVisible}"
                                     Visibility="Collapsed"
                                     TextChanged="Visible_TextChanged"/>

                            <Button
                                    Content="Ojo"
                                    Tag="nueva"
                                    Style="{StaticResource BotonOjo}"
                                    Click="AlternarVisibilidad_Click" Grid.ColumnSpan="2" Margin="399,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Confirmar nueva contraseña:"
                               Style="{StaticResource Etiqueta}"/>

                    <Border Style="{StaticResource FondoClave}"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="Confirmacion"
                                         Style="{StaticResource CampoClave}"
                                         PasswordChanged="Campos_PasswordChanged"/>

                            <TextBox x:Name="ConfirmacionVisible"
                                     Style="{StaticResource CampoVisible}"
                                     Visibility="Collapsed"
                                     TextChanged="Visible_TextChanged"/>

                            <Button
                                    Content="Ojo"
                                    Tag="confirmacion"
                                    Style="{StaticResource BotonOjo}"
                                    Click="AlternarVisibilidad_Click" Grid.ColumnSpan="2" Margin="399,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TextoCoincidencia"
                               FontSize="14"
                               Margin="3,0,0,17"/>

                    <TextBlock Text="La nueva contraseña debe cumplir los siguientes requisitos:"
                               Foreground="#7D8587"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,7"/>

                    <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ReglaLongitud" FontSize="13"/>
                        <TextBlock x:Name="ReglaMayuscula" FontSize="13"/>
                        <TextBlock x:Name="ReglaMinuscula" FontSize="13"/>
                        <TextBlock x:Name="ReglaNumero" FontSize="13"/>
                        <TextBlock x:Name="ReglaEspecial" FontSize="13"/>
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ⓘ"
                                   FontSize="15"
                                   Foreground="#E34462"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="Al cambiar su contraseña, se cerrarán las sesiones activas en los demás dispositivos cuando el servidor implemente esa invalidación."
                                   TextWrapping="Wrap"
                                   Foreground="#7D8587"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,18,18">
                <Button x:Name="BtnGuardar"
                        Content="Cambiar"
                        Style="{StaticResource BotonCambiar}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="Guardar_Click"/>
            </Border>

            <StackPanel x:Name="PanelAvisos"
                        Grid.RowSpan="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,12,54"
                        Panel.ZIndex="200"
                        Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>