<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="ClinicSyncDesktop.Views.PerfilView"
             Loaded="PerfilView_Loaded"
             Background="#F0F3EF" d:DesignHeight="530.574" d:DesignWidth="987.652">

    <UserControl.Resources>

        <!-- CAMPOS DE SOLO LECTURA -->
        <Style x:Key="CampoPerfil" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#D9DDDA"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ETIQUETAS -->
        <Style x:Key="EtiquetaPerfil" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- BOTÓN DEL LÁPIZ -->
        <Style x:Key="BotonEditarFoto" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="43"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#D9DDDA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTip" Value="Editar perfil"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="24">
                            <Image Source="/Resources/ImagenesPerfil/editar-perfil.png"
                                   Width="27"
                                   Height="27"
                                   Stretch="Uniform"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.12" Duration="0:0:0.18"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.12" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1" Duration="0:0:0.18"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- MENÚ INTERNO -->
        <Style x:Key="BotonMenuPerfil" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Grid Background="#F0F3EF">

        <!-- CONTENIDO DEL PERFIL -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="45,25,35,30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">

                    <Grid Width="105"
                          Height="105"
                          Margin="0,0,25,0"
                          Background="Transparent">

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BtnEditarFoto"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BtnEditarFoto"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Image x:Name="ImgPerfil"
                               Source="/Resources/ImagenesPerfil/perfil.png"
                               Width="95"
                               Height="95"
                               Stretch="Uniform"/>

                        <Button x:Name="BtnEditarFoto"
                                Style="{StaticResource BotonEditarFoto}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-5,-3"
                                Opacity="0"
                                Click="EditarFoto_Click"/>

                    </Grid>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="TxtNombrePerfil"
                                   Text="Cargando perfil..."
                                   FontSize="29"
                                   FontWeight="Bold"
                                   Foreground="#17475A"/>

                        <TextBlock x:Name="TxtRolPerfil"
                                   FontSize="17"
                                   Foreground="#222222"
                                   Margin="0,5,0,0"/>

                    </StackPanel>
                </StackPanel>

                <!-- CONTENIDO -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="195"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- NAVEGACIÓN -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,25,0">

                        <Button x:Name="BtnDatosPersonales"
                                Content="Datos personales"
                                Style="{StaticResource BotonMenuPerfil}"
                                Click="DatosPersonales_Click"
                                Margin="0,0,0,12"/>

                        <Button x:Name="BtnSeguridad"
                                Content="Seguridad"
                                Style="{StaticResource BotonMenuPerfil}"
                                Click="Seguridad_Click"
                                Margin="0,0,0,12"/>

                        <Button x:Name="BtnAcercaDe"
                                Content="Acerca de"
                                Style="{StaticResource BotonMenuPerfil}"
                                Click="AcercaDe_Click"/>

                    </StackPanel>

                    <!-- DATOS PERSONALES -->
                    <StackPanel x:Name="PanelDatosPersonales"
                                Grid.Column="1">

                        <TextBlock Text="Identidad:"
                                   Style="{StaticResource EtiquetaPerfil}"/>

                        <TextBox x:Name="TxtIdentidad"
                                 Style="{StaticResource CampoPerfil}"
                                 Margin="0,6,550,18" 
                                 Height="30"/>

                        <TextBlock
                                   Style="{StaticResource EtiquetaPerfil}"><Run Text="Nombre"/><Run Text="s:    "/><Run Text="        "/><Run Text="                                                          "/><Run Text="&#x9;&#x9;"/><Run Text="&#x9;"/><Run Language="es-hn" Text="   "/><Run Text="Apellidos:"/></TextBlock>

                        <Grid Margin="0,6,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtNombres"
                                     Grid.Column="0"
                                     Style="{StaticResource CampoPerfil}" TextChanged="TxtNombres_TextChanged"/>

                            <TextBox x:Name="TxtApellidos"
                                     Grid.Column="2"
                                     Style="{StaticResource CampoPerfil}"/>

                        </Grid>

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Fecha de nacimiento:"
                                           Style="{StaticResource EtiquetaPerfil}"/>

                                <Grid Margin="0,6,0,0">

                                    <TextBox x:Name="TxtFechaNacimiento"
                                             Style="{StaticResource CampoPerfil}"
                                             Padding="10,4,36,4"/>

                                    <Image
                                        Source="/Resources/ImagenesPacientes/ImagenesExpediente/calendario.png"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,9,0"
                                        IsHitTestVisible="False"/>

                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Sexo:"
                                           Style="{StaticResource EtiquetaPerfil}"/>

                                <TextBox x:Name="TxtSexo"
                                         Style="{StaticResource CampoPerfil}"
                                         Margin="0,6,0,0"/>

                            </StackPanel>

                        </Grid>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Teléfono:"
                                           Style="{StaticResource EtiquetaPerfil}"/>

                                <TextBox x:Name="TxtTelefono"
                                         Style="{StaticResource CampoPerfil}"
                                         Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Correo:"
                                           Style="{StaticResource EtiquetaPerfil}"/>

                                <TextBox x:Name="TxtCorreo"
                                         Style="{StaticResource CampoPerfil}"
                                         Margin="0,6,0,0"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock x:Name="TxtError"
                                   Foreground="#E34462"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,20,0,0"/>

                    </StackPanel>

                    <!-- SEGURIDAD -->
                    <StackPanel x:Name="PanelSeguridad"
                                Grid.Column="1"
                                Visibility="Collapsed">

                        <!-- CAMBIAR CONTRASEÑA -->
                        <Grid Margin="0,0,0,22">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="135"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Cambiar contraseña"
                                           Style="{StaticResource EtiquetaPerfil}"/>

                                <TextBlock
                                    Text="Actualiza tu contraseña para mantener tu cuenta segura."
                                    Foreground="#333333"
                                    FontSize="12"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Cambiar"
                                    Click="CambiarPassword_Click"
                                    Width="115"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Background="#2298A9"
                                    Foreground="White"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand">

                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">

                                        <Border
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="12">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </Grid>

                        <!-- AUTENTICACIÓN DE DOS FACTORES -->
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Autenticación de dos factores"
                                    Style="{StaticResource EtiquetaPerfil}"/>

                                <TextBlock
                                    Text="Habilite la autenticación de dos factores (2FA) para una mayor protección de su cuenta."
                                    Foreground="#333333"
                                    FontSize="12"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top"
                                        Margin="20,0,0,0">

                                <TextBlock x:Name="TxtEstado2FA"
                                           Text="No configurado"
                                           Foreground="#333333"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Button x:Name="BtnInterruptor2FA"
                                        Width="40"
                                        Height="22"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        FocusVisualStyle="{x:Null}"
                                        Cursor="Hand"
                                        ToolTip="Configuración de dos factores pendiente"
                                        Click="Configurar2FA_Click">

                                    <Grid Width="40" Height="22">

                                        <Border x:Name="FondoInterruptor2FA"
                                                Background="#D9DDDA"
                                                CornerRadius="11"/>

                                        <Ellipse x:Name="IndicadorInterruptor2FA"
                                                 Width="17"
                                                 Height="17"
                                                 Fill="#F0F3EF"
                                                 HorizontalAlignment="Left"
                                                 Margin="3,0,0,0"/>

                                    </Grid>

                                </Button>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                    <!-- ACERCA DE -->
                    <Grid x:Name="PanelAcercaDe"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="360"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="ClinicSync"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#17475A"/>

                            <TextBlock Text="Sistema de Gestión de Clínica Dental"
                                       FontSize="18"
                                       Foreground="#444444"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>

                        <Image Grid.Column="2"
                               Source="/Resources/ImagenesPerfil/clinicsync_acercade.png"
                               Width="140"
                               Height="140"
                               Stretch="Uniform"
                               VerticalAlignment="Top"/>
                    </Grid>

                </Grid>

            </Grid>

        </ScrollViewer>

        <!-- CONTENEDOR DE NOTIFICACIONES -->
        <StackPanel x:Name="PanelAvisos"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,25,65"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"/>

    </Grid>

</UserControl>
