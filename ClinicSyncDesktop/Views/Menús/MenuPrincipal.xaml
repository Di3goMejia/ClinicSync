<Window x:Class="ClinicSync.Views.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicSync - Menú Principal"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="900"
        MinHeight="550"
        Background="#F4F6F3"
        Loaded="Ventana_Loaded">

    <Window.Resources>

        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- TARJETAS DE LOS MÓDULOS -->
        <Style x:Key="BotonModulo" TargetType="Button">
            <Setter Property="Width" Value="225"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Background"
                    Value="{StaticResource Turquesa}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  ShadowDepth="2"
                                                  Opacity="0.18"/>
                            </Border.Effect>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImagenModulo" TargetType="Image">
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="TextoModulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonRedondo" TargetType="Button">
            <Setter Property="Background" Value="#8BD4E0"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0"
              Background="{StaticResource Turquesa}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="35,0,0,0">

                <Image Source="/Resources/Imagenes MenuPrincipal/ClinicSync-LOGO.png"
                       Width="75"
                       Height="75"
                       Stretch="Uniform"/>

                <TextBlock Text="CLINIC&#10;SYNC"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           LineHeight="26"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Margin="18,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="Menú Principal"
                       Foreground="White"
                       FontSize="27"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button x:Name="btnCampana"
                        Style="{StaticResource BotonIcono}"
                        Click="Campana_Click">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="White">
                        <Image Source="/Resources/Imagenes MenuPrincipal/campana-azul.png"
                               Width="23"
                               Height="23"/>
                    </Border>
                </Button>

                <Button x:Name="btnUsuario"
                        Style="{StaticResource BotonIcono}"
                        Click="PerfilMenu_Click">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="White">
                        <Image Source="/Resources/Imagenes MenuPrincipal/usuario-azul.png"
                               Width="23"
                               Height="23"/>
                    </Border>
                </Button>

            </StackPanel>
        </Grid>

        <!-- MÓDULOS -->
        <Grid Grid.Row="1">

            <Grid Width="850"
                  Height="300"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="135"/>
                    <RowDefinition Height="165"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource BotonModulo}"
                        Tag="Pacientes"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="/Resources/Imagenes MenuPrincipal/pacientes.png"/>
                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Pacientes"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource BotonModulo}"
                        Tag="Tratamientos"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="/Resources/Imagenes MenuPrincipal/tratamientos.png"/>
                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Tratamientos"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource BotonModulo}"
                        Tag="Inventario"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="/Resources/Imagenes MenuPrincipal/inventario.png"/>
                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Inventario"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource BotonModulo}"
                        Tag="Finanzas"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="/Resources/Imagenes MenuPrincipal/finanzas.png"/>
                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Finanzas"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource BotonModulo}"
                        Tag="Agenda"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="/Resources/Imagenes MenuPrincipal/agenda.png"/>
                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Agenda"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Grid>

        <!-- NOTIFICACIONES -->
        <Popup x:Name="PopupNotificaciones"
               PlacementTarget="{Binding ElementName=btnCampana}"
               Placement="Bottom"
               HorizontalOffset="-255"
               VerticalOffset="-4"
               AllowsTransparency="True"
               StaysOpen="False">

            <Border Width="310"
                    Height="315"
                    Background="White"
                    CornerRadius="15">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="5"
                                      Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="15,15,0,0">
                        <TextBlock Text="Notificaciones"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <Button Grid.Row="1"
                            Content="Marcar como leído"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Padding="4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#17475A"
                            FontSize="11"
                            Cursor="Hand"
                            Click="MarcarLeidas_Click"/>

                    <Grid Grid.Row="2"
                          Background="White">
                        <StackPanel x:Name="ListaAhora"/>
                        <StackPanel x:Name="ListaAnteriores"/>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="0,0,15,15">
                        <Button Content="Todo"
                                Style="{StaticResource BotonRedondo}"
                                Width="78"
                                Height="24"
                                HorizontalAlignment="Right"
                                Margin="0,0,12,0"
                                Click="VerTodas_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- PERFIL -->
        <Popup x:Name="PopupPerfil"
               PlacementTarget="{Binding ElementName=btnUsuario}"
               Placement="Bottom"
               HorizontalOffset="-220"
               VerticalOffset="-4"
               AllowsTransparency="True"
               StaysOpen="False">

            <Border Width="285"
                    Background="White"
                    CornerRadius="15">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="5"
                                      Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="15,15,0,0">
                        <Grid Margin="12,7,12,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Source="/Resources/Imagenes MenuPrincipal/usuario-perfil.png"
                                   Width="32"
                                   Height="32"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                <TextBlock x:Name="NombrePerfil"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#17475A"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RolPerfil"
                                           FontSize="12"
                                           Foreground="#17475A"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="Configuracion_Click">
                                <Image Source="/Resources/Imagenes MenuPrincipal/ajuste.png"
                                       Width="23"
                                       Height="23"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="0,0,15,15">
                        <Button Content="Cerrar sesión"
                                Style="{StaticResource BotonRedondo}"
                                Width="100"
                                Height="23"
                                HorizontalAlignment="Right"
                                Margin="0,0,12,0"
                                Click="CerrarSesion_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>

    </Grid>
</Window>
