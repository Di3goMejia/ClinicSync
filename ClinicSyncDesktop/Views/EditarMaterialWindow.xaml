<Window x:Class="ClinicSyncDesktop.Views.EditarMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar material"
        Width="357"
        Height="475"
        MinWidth="357"
        MinHeight="475"
        MaxWidth="357"
        MaxHeight="475"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- COLORES -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#168FA5" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="AzulOscuro" Color="#17475A"/>
        <SolidColorBrush x:Key="FondoCampo" Color="#D9DDD8"/>
        <SolidColorBrush x:Key="RojoCerrar" Color="#E83C53"/>

        <!-- ESTILO DE ETIQUETAS -->
        <Style x:Key="Etiqueta"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
                    Value="{StaticResource AzulOscuro}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ESTILO DE CAMPOS -->
        <Style x:Key="Campo"
               TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background"
                    Value="{StaticResource FondoCampo}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource AzulOscuro}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DE BOTONES -->
        <Style x:Key="BotonPlano"
               TargetType="{x:Type Button}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Border Background="White"
            CornerRadius="15"
            BorderThickness="1"
            BorderBrush="#E1E7E4"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="14,14,0,0"
                    ClipToBounds="True">

                <Grid Margin="14,0,9,0">

                    <TextBlock Text="Editar material:"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Width="25"
                            Height="26"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource RojoCerrar}"
                            Style="{StaticResource BotonPlano}"
                            Click="Cancelar_Click"
                            ToolTip="Cerrar">

                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <TextBlock Text="×"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="22"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,-2,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>
            </Border>

            <!-- CUERPO -->
            <Grid Grid.Row="1"
                  Margin="30,8,30,8">

                <Grid.RowDefinitions>
                    <RowDefinition Height="49"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="59"/>
                    <RowDefinition Height="49"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- IMAGEN -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Imagen:"
                                   Style="{StaticResource Etiqueta}"
                                   Margin="3,0,10,0"/>

                        <Button Grid.Column="1"
                                Height="22"
                                Padding="6,0"
                                Background="#E4F0F0"
                                Style="{StaticResource BotonPlano}"
                                Click="SeleccionarImagen_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="9">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Image Source="/Resources/ImagenesInventario/IconoImagen.png"
                                       Width="16"
                                       Height="16"
                                       Stretch="Uniform"
                                       Margin="0,0,4,0"/>

                                <TextBlock Text="Elegir imagen"
                                           Foreground="#168FAD"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBox x:Name="txtImagen"
                                 Grid.Column="2"
                                 Height="22"
                                 Margin="4,0,2,0"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="{StaticResource AzulOscuro}"
                                 FontSize="10"
                                 Padding="2,0"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Imagen seleccionada"/>

                        <Button x:Name="btnQuitarImagen"
                                Grid.Column="3"
                                Width="19"
                                Height="22"
                                Background="Transparent"
                                Style="{StaticResource BotonPlano}"
                                ToolTip="Quitar imagen"
                                Visibility="Collapsed"
                                Click="QuitarImagen_Click">

                            <Image Source="/Resources/ImagenesInventario/IconoBasurero.png"
                                   Width="15"
                                   Height="18"
                                   Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="ⓘ Tipos de archivo aceptados: JPG, PNG"
                               FontSize="10"
                               Foreground="#B7BDBB"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"/>

                    <Image x:Name="imgVistaPrevia"
                           Visibility="Collapsed"
                           Width="1"
                           Height="1"/>
                </Grid>

                <!-- NOMBRE -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="23"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Nombre del material:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <TextBox x:Name="txtNombre"
                             Grid.Row="1"
                             Style="{StaticResource Campo}"
                             MaxLength="50"/>
                </Grid>

                <!-- CÓDIGO Y PRECIO -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="23"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Código:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <TextBox x:Name="txtCodigo"
                             Grid.Row="1"
                             Grid.Column="0"
                             Style="{StaticResource Campo}"
                             MaxLength="30"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Precio por unidad:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <Grid Grid.Row="1"
                          Grid.Column="2">

                        <Border Background="{StaticResource FondoCampo}"
                                CornerRadius="10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="L"
                                       Grid.Column="0"
                                       Foreground="#B0B7B4"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtPrecioCompra"
                                     Grid.Column="1"
                                     Style="{StaticResource Campo}"
                                     Background="Transparent"
                                     Padding="0,1,8,1"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- STOCK ACTUAL, UNIDAD Y CANTIDAD MÍNIMA -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource Etiqueta}"
                               Text="Stock actual:"/>

                    <!-- STOCK Y UNIDAD -->
                    <Grid Grid.Row="1"
                          Grid.Column="0">

                        <Border Background="{StaticResource FondoCampo}"
                                CornerRadius="10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="49"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtStockActual"
                                     Grid.Column="0"
                                     Style="{StaticResource Campo}"
                                     Background="Transparent"
                                     Padding="0"
                                     TextAlignment="Center"
                                     IsReadOnly="True"
                                     ToolTip="Stock actual del material"/>

                            <Border Grid.Column="1"
                                    BorderBrush="#C3C9C5"
                                    BorderThickness="1,0,0,0"/>

                            <TextBox x:Name="txtUnidadMedida"
                                     Grid.Column="1"
                                     Style="{StaticResource Campo}"
                                     Background="Transparent"
                                     Padding="1"
                                     TextAlignment="Center"
                                     MaxLength="20"
                                     ToolTip="Unidad de medida"/>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource Etiqueta}">
                        <Run Text="Cantidad mínima:"/>
                        <Run Text=" *" Foreground="#E83C53"/>
                    </TextBlock>

                    <TextBox x:Name="txtStockMinimo"
                             Grid.Row="1"
                             Grid.Column="2"
                             Style="{StaticResource Campo}"/>
                </Grid>

                <!-- DESCRIPCIÓN -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Descripción:"
                               Style="{StaticResource Etiqueta}"/>

                    <TextBox x:Name="txtDescripcion"
                             Grid.Row="1"
                             Style="{StaticResource Campo}"
                             Height="Auto"
                             MinHeight="48"
                             Padding="9,7"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxLength="200"/>
                </Grid>

                <!-- ESTADO DEL MATERIAL -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Habilitado:"
                               Style="{StaticResource Etiqueta}"/>

                    <ToggleButton x:Name="chkActivo"
                                  Grid.Column="1"
                                  Width="40"
                                  Height="22"
                                  IsChecked="True"
                                  Cursor="Hand"
                                  Background="#D9DDD8"
                                  BorderThickness="0"
                                  FocusVisualStyle="{x:Null}">

                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="FondoInterruptor"
                                        Width="40"
                                        Height="22"
                                        Background="#D9DDD8"
                                        CornerRadius="11">

                                    <Ellipse x:Name="Circulo"
                                             Width="16"
                                             Height="16"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             Margin="3,0,0,0"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter TargetName="FondoInterruptor"
                                                Property="Background"
                                                Value="#32A5AB"/>

                                        <Setter TargetName="Circulo"
                                                Property="HorizontalAlignment"
                                                Value="Right"/>

                                        <Setter TargetName="Circulo"
                                                Property="Margin"
                                                Value="0,0,3,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <!-- MENSAJE DE VALIDACIÓN -->
                <TextBlock x:Name="txtAvisoValidacion"
                           Grid.Row="6"
                           Foreground="#E83C53"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

            </Grid>

            <!-- PIE -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,14,14"
                    ClipToBounds="True">

                <Button x:Name="btnGuardar"
                        Content="Guardar cambios"
                        Width="130"
                        Height="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#91D3DE"
                        Foreground="{StaticResource AzulOscuro}"
                        FontSize="13"
                        FontWeight="Bold"
                        Style="{StaticResource BotonPlano}"
                        Click="Guardar_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

        </Grid>
    </Border>
</Window>
