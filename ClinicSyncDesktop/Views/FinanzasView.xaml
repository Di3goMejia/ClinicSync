<UserControl x:Class="ClinicSyncDesktop.Views.FinanzasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F3EF">

    <UserControl.Resources>

        <!-- ESTILO DE LOS BOTONES SUPERIORES -->
        <Style x:Key="EstiloPestanas"
               TargetType="Button">

            <Setter Property="Width" Value="125"/>
            <Setter Property="Height" Value="32"/>

            <Setter Property="Background"
                    Value="#F7F9F7"/>

            <Setter Property="Foreground"
                    Value="#17475A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Margin"
                    Value="7,0"/>

            <!-- BORDES REDONDEADOS -->
            <Setter Property="Template">

                <Setter.Value>


                    <ControlTemplate TargetType="Button">

                        <Border
                         x:Name="BordeBoton"
                         Background="{TemplateBinding Background}"
                        CornerRadius="18">
                            

                            <!-- SOMBRA DEL BOTÓN -->
                            <Border.Effect>

                           <DropShadowEffect
                            Color="#000000"
                            Direction="270"
                            ShadowDepth="1"
                            BlurRadius="5"
                            Opacity="0.25"/>        

                           </Border.Effect>

                            <!-- TEXTO DEL BOTÓN -->
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <!-- EFECTO AL PASAR EL MOUSE -->
                        <ControlTemplate.Triggers>

                        <Trigger
                        Property="IsMouseOver"
                        Value="True">

                        <Setter
                        TargetName="BordeBoton"
                        Property="Effect">

                        <Setter.Value>

                        <DropShadowEffect
                        Color="#000000"
                        Direction="270"
                        ShadowDepth="5"
                        BlurRadius="10"
                        Opacity="0.35"/>

                        </Setter.Value>

                        </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>


                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- CONTENEDOR GENERAL -->
    <Grid Margin="18,-15,18,18">

        <Grid.RowDefinitions>

            <!-- FILA DE PESTAÑAS -->
            <RowDefinition Height="Auto"/>

            <!-- CONTENIDO DE FINANZAS -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- =================================== -->
        <!-- BOTONES SUPERIORES DE FINANZAS      -->
        <!-- =================================== -->

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="-550,0,0,12">

            <!-- BOTÓN RESUMEN -->
            <Button
                x:Name="BtnResumen"
                Content="Resumen"
                Tag="Resumen"
                Style="{StaticResource EstiloPestanas}"
                Click="Pestana_Click"/>

            <!-- BOTÓN INGRESOS -->
            <Button
                x:Name="BtnIngresos"
                Content="Ingresos"
                Tag="Ingresos"
                Background="#86C5D0"
                Style="{StaticResource EstiloPestanas}"
                Click="Pestana_Click"/>

            <!-- BOTÓN EGRESOS -->
            <Button
                x:Name="BtnEgresos"
                Content="Egresos"
                Tag="Egresos"
                Style="{StaticResource EstiloPestanas}"
                Click="Pestana_Click"/>

            <!-- BOTÓN GRÁFICOS -->
            <Button
                x:Name="BtnGraficos"
                Content="Gráficos"
                Tag="Graficos"
                Style="{StaticResource EstiloPestanas}"
                Click="Pestana_Click"/>

        </StackPanel>

        <!-- =================================== -->
        <!-- ÁREA DONDE IRÁ CADA MÓDULO          -->
        <!-- =================================== -->

        <Border
            Grid.Row="1"
            Background="#D9DDDA"
            CornerRadius="13">

            <Grid>

                <!-- AQUÍ SE MOSTRARÁ EL CONTENIDO -->
                <!-- DE RESUMEN, INGRESOS, EGRESOS -->
                <!-- Y GRÁFICOS POSTERIORMENTE -->

                <ContentControl
                    x:Name="ContenidoFinanzas"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
