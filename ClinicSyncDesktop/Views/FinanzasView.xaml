<UserControl x:Class="ClinicSyncDesktop.Views.FinanzasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClinicSyncDesktop.Controls"
             xmlns:finanzas="clr-namespace:ClinicSyncDesktop.Controls.Finanzas"
             Background="White">

    <Grid>
        <!-- Estructura principal de la vista Finanzas -->
        <Grid Margin="26,14,26,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ SUBMENÚ SUPERIOR: Resumen, Ingresos, Egresos, Gráficos ============ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <!-- Pestañas redondeadas tipo cápsula -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:Name="TabResumen" CornerRadius="16" Height="32" Padding="20,0" Margin="0,0,10,0"
                            Background="{StaticResource ColorMenuSeleccionado}" Cursor="Hand" MouseLeftButtonDown="Tab_Click">
                        <TextBlock x:Name="TxtTabResumen" Text="Resumen" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="TabIngresos" CornerRadius="16" Height="32" Padding="20,0" Margin="0,0,10,0"
                            Background="#F0F1EE" Cursor="Hand" MouseLeftButtonDown="Tab_Click">
                        <TextBlock x:Name="TxtTabIngresos" Text="Ingresos" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="TabEgresos" CornerRadius="16" Height="32" Padding="20,0" Margin="0,0,10,0"
                            Background="#F0F1EE" Cursor="Hand" MouseLeftButtonDown="Tab_Click">
                        <TextBlock x:Name="TxtTabEgresos" Text="Egresos" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="TabGraficos" CornerRadius="16" Height="32" Padding="20,0"
                            Background="#F0F1EE" Cursor="Hand" MouseLeftButtonDown="Tab_Click">
                        <TextBlock x:Name="TxtTabGraficos" Text="Gráficos" Foreground="{StaticResource ColorTexto}"
                                   FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Botón Exportar reporte financiero a la derecha -->
                <Button x:Name="BtnExportarSuperior" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource BotonOvalado}" Height="30" Padding="16,0"
                        Click="BtnAbrirExportar_Click" ToolTip="Exportar reporte financiero en PDF o Excel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono documento de reporte -->
                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M12,19L8,15H11V11H13V15H16L12,19M13,9V3.5L18.5,9H13Z"
                              Fill="{StaticResource ColorTexto}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Exportar reporte" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ CONTENEDOR DE LA SUBVISTA ACTIVA ============ -->
            <ContentControl x:Name="ContenedorSubvista" Grid.Row="1"/>
        </Grid>

        <!-- ============ CAPA MODAL INTEGRADA ============ -->
        <Grid x:Name="OverlayModal" Visibility="Collapsed" Background="#33000000">

            <!-- Modal 1: Selección de Formato PDF / Excel -->
            <finanzas:ModalExportarReporteControl x:Name="CtrlExportar"
                                                 Visibility="Collapsed"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 ExportarClick="CtrlExportar_ExportarClick"
                                                 CerrarClick="Modal_CerrarClick"/>

            <!-- Modal 2: Progreso Generando el reporte... -->
            <finanzas:ModalGenerandoReporteControl x:Name="CtrlGenerando"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  CancelarClick="Modal_CerrarClick"
                                                  GeneracionCompletada="CtrlGenerando_GeneracionCompletada"/>

            <!-- Modal 3: Agregar Nuevo Ingreso -->
            <finanzas:ModalAgregarIngresoControl x:Name="CtrlAgregarIngreso"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IngresoAgregado="CtrlAgregarIngreso_IngresoAgregado"
                                                CerrarClick="CtrlFormulario_Cerrado"
                                                ConfirmarDescarte="CtrlFormulario_ConfirmarDescarte"
                                                AbrirSelectorMateriales="CtrlAgregarIngreso_AbrirSelectorMateriales"
                                                AvisoRequerido="CtrlFormulario_AvisoRequerido"/>

            <!-- Modal 4: Editar Información de Ingreso (Imagen 3) -->
            <finanzas:ModalEditarIngresoControl x:Name="CtrlEditarIngreso"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                GuardarClick="CtrlEditarIngreso_GuardarClick"
                                                CerrarClick="CtrlFormulario_Cerrado"
                                                ConfirmarDescarte="CtrlFormulario_ConfirmarDescarte"
                                                ImprimirFacturaClick="CtrlEditarIngreso_ImprimirFacturaClick"
                                                AvisoRequerido="CtrlFormulario_AvisoRequerido"/>

            <!-- Modal 5: Agregar Nuevo Egreso (Egresos Imágenes 1, 2, 4 y 5) -->
            <finanzas:ModalAgregarEgresoControl x:Name="CtrlAgregarEgreso"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                EgresoAgregado="CtrlAgregarEgreso_EgresoAgregado"
                                                CerrarClick="CtrlFormulario_Cerrado"
                                                ConfirmarDescarte="CtrlFormulario_ConfirmarDescarte"
                                                AbrirSelectorMateriales="CtrlAgregarEgreso_AbrirSelectorMateriales"
                                                AvisoRequerido="CtrlFormulario_AvisoRequerido"/>

            <!-- Modal 6: Editar Información de Egreso (Egresos Imágenes 1, 2, 3 y 4) -->
            <finanzas:ModalEditarEgresoControl x:Name="CtrlEditarEgreso"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               GuardarClick="CtrlEditarEgreso_GuardarClick"
                                               CerrarClick="CtrlFormulario_Cerrado"
                                               ConfirmarDescarte="CtrlFormulario_ConfirmarDescarte"
                                               AbrirSelectorMateriales="CtrlEditarEgreso_AbrirSelectorMateriales"
                                               AvisoRequerido="CtrlFormulario_AvisoRequerido"/>

            <!-- Sub-Modal: Selector de Materiales -->
            <finanzas:ModalMaterialesControl x:Name="CtrlMateriales"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Confirmado="CtrlMateriales_Confirmado"
                                            Cerrado="CtrlMateriales_Cerrado"/>

            <!-- Pop-up de Aviso / Validación (Imagen 1) -->
            <controls:ModalAvisoControl x:Name="CtrlAviso"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="ModalAviso_AceptarClick"
                                        CerrarClick="ModalAviso_AceptarClick"/>

            <!-- Pop-up Cuidado / Descartar Registro (Imagen 2) -->
            <controls:ModalCuidadoControl x:Name="CtrlCuidado"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SiClick="ModalCuidado_SiClick"
                                          NoClick="ModalCuidado_NoClick"/>

            <!-- Pop-up Éxito (Imágenes 4 y 5) -->
            <controls:ModalExitoControl x:Name="CtrlExito"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="Modal_CerrarClick"
                                        CerrarClick="Modal_CerrarClick"/>

            <!-- Pop-up Error (Imagen 5) -->
            <controls:ModalErrorControl x:Name="CtrlError"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AceptarClick="Modal_CerrarClick"
                                        CerrarClick="Modal_CerrarClick"/>
        </Grid>
    </Grid>
</UserControl>
