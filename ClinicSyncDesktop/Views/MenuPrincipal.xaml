<Window x:Class="ClinicSync.Views.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicSync"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="900"
        MinHeight="550"
        Background="#F7F9F8">

    <Window.Resources>

        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="BotonModulo" TargetType="Button">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="135"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Background" Value="{StaticResource Turquesa}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  ShadowDepth="2"
                                                  Opacity="0.2"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImagenModulo" TargetType="Image">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="75"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="TextoModulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PanelDesplegable" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="6"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPanel" TargetType="Button">
            <Setter Property="Background" Value="#80D2DF"/>
            <Setter Property="Foreground" Value="#164963"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid x:Name="EncabezadoPrincipal"
              Grid.Row="0"
              Background="{StaticResource Turquesa}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="35,0,0,0"
                        Panel.ZIndex="2">

                <Image Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/ClinicSync-LOGO.png"
                       Width="75"
                       Height="75"
                       ImageFailed="Imagen_ImageFailed"/>

                <TextBlock Text="CLINIC&#10;SYNC"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="TituloPantalla"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Text="Menú Principal"
                       Foreground="White"
                       FontSize="27"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Panel.ZIndex="1"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="2">

                <!-- NOTIFICACIONES -->
                <Button Style="{StaticResource BotonIcono}"
                        Click="Campana_Click"
                        ToolTip="Notificaciones">
                    <Border Width="38"
                            Height="38"
                            Background="White"
                            CornerRadius="19">

                        <Image Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/campana-azul.png"
                               Width="28"
                               Height="28"
                               ImageFailed="Imagen_ImageFailed"/>
                    </Border>
                </Button>

                <!-- USUARIO -->
                <Button Style="{StaticResource BotonIcono}"
                        Click="PerfilMenu_Click"
                        ToolTip="Perfil">
                    <Border Width="38"
                            Height="38"
                            Background="White"
                            CornerRadius="19">

                        <Image Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/usuario.png"
                               Width="28"
                               Height="28"
                               ImageFailed="Imagen_ImageFailed"/>
                    </Border>
                </Button>

            </StackPanel>
        </Grid>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">

            <Grid x:Name="VistaInicio"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="1100"
                  Height="446">

                <Grid.RowDefinitions>
                    <RowDefinition Height="175"/>
                    <RowDefinition Height="175"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PACIENTES -->
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BotonModulo}"
                        Tag="Pacientes"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/pacientes.png"/>

                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Pacientes"/>
                    </StackPanel>
                </Button>

                <!-- TRATAMIENTOS -->
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BotonModulo}"
                        Tag="Tratamientos"
                        Click="BotonModulo_Click">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/tratamientos.png"/>

                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Tratamientos"/>
                    </StackPanel>
                </Button>

                <!-- INVENTARIO -->
                <Button x:Name="BtnInventario"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BotonModulo}"
                        Tag="Inventario"
                        Click="BotonModulo_Click"
                        Margin="15,67,15,-27">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/inventario.png"/>

                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Inventario"/>
                    </StackPanel>
                </Button>

                <!-- FINANZAS -->
                <Button x:Name="BtnFinanzas"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BotonModulo}"
                        Tag="Finanzas"
                        Click="BotonModulo_Click"
                        Margin="53,67,53,-27"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/finanzas.png"/>

                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Finanzas"/>
                    </StackPanel>
                </Button>

                <!-- AGENDA -->
                <Button x:Name="BtnAgenda"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BotonModulo}"
                        Tag="Agenda"
                        Click="BotonModulo_Click"
                        Margin="15,67,15,-27">
                    <StackPanel>
                        <Image Style="{StaticResource ImagenModulo}"
                               Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/agenda.png"/>

                        <TextBlock Style="{StaticResource TextoModulo}"
                                   Text="Agenda"/>
                    </StackPanel>
                </Button>

            </Grid>

            <!-- ÁREA MDI -->
            <TabControl x:Name="Pestanas"
                        Visibility="Collapsed"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectionChanged="Pestanas_SelectionChanged">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>
            </TabControl>

            <!-- PERFIL -->
            <Border x:Name="PanelPerfil"
                    Style="{StaticResource PanelDesplegable}"
                    Width="450"
                    Height="135"
                    Margin="0,0,60,0"
                    Panel.ZIndex="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="47"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/usuario-perfil.png"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="NombrePerfil"
                                       Text=""
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#164963"/>

                            <TextBlock x:Name="RolPerfil"
                                       Text=""
                                       FontSize="17"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource BotonIcono}"
                                Click="AjustesPerfil_Click"
                                ToolTip="Ajustes de perfil">

                            <Image Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/ajuste.png"
                                   Width="39"
                                   Height="39"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="0,0,18,18">

                        <Button Content="Cerrar sesión"
                                Width="135"
                                Style="{StaticResource BotonPanel}"
                                Click="CerrarSesion_Click"/>
                    </Border>

                </Grid>
            </Border>

            <!-- NOTIFICACIONES -->
            <Border x:Name="PanelNotificaciones"
                    Style="{StaticResource PanelDesplegable}"
                    Width="455"
                    Height="470"
                    Margin="0,0,105,0"
                    Panel.ZIndex="30">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="18,18,0,0">

                        <TextBlock Text="Notificaciones"
                                   Foreground="White"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Margin="20,0"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="16">

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Ahora"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#164963"/>

                                <Button Grid.Column="1"
                                        Content="Marcar como leído"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#164963"
                                        Click="MarcarLeidas_Click"/>
                            </Grid>

                            <!-- CITA -->
                            <Border Background="#D9DDDA"
                                    CornerRadius="12"
                                    Padding="15"
                                    Margin="0,0,0,20">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="☑"
                                               FontSize="28"
                                               Foreground="#164963"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Cita programada: Diego Mejía, 2 PM"
                                                   FontSize="16"
                                                   Foreground="#164963"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Hoy, 1 PM"
                                                   Foreground="Gray"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <Ellipse x:Name="PuntoNoLeida"
                                             Grid.Column="2"
                                             Width="10"
                                             Height="10"
                                             Fill="#2AA5A9"
                                             VerticalAlignment="Top"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Más temprano"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#164963"
                                       Margin="0,0,0,12"/>

                            <!-- INVENTARIO -->
                            <Border Background="#D9DDDA"
                                    CornerRadius="12"
                                    Padding="15">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="☑"
                                               FontSize="28"
                                               Foreground="#164963"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Stock bajo: Adhesivo dental PermaFlo®"
                                                   FontSize="16"
                                                   Foreground="#164963"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Hoy, 10 AM"
                                                   Foreground="Gray"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{StaticResource Turquesa}"
                            CornerRadius="0,0,18,18">

                        <Button Content="Todo"
                                Width="115"
                                Style="{StaticResource BotonPanel}"
                                Click="VerTodas_Click"/>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>