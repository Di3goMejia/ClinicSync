<Window x:Class="ClinicSyncDesktop.Views.SeleccionIngresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar"
        Width="480"
        Height="385"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A8B0" Offset="0"/>
            <GradientStop Color="#168FA7" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="BuscadorRedondo" TargetType="TextBox">
            <Setter Property="Background" Value="#F4F8F7"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonRedondo" TargetType="Button">
            <Setter Property="Background" Value="#91D2DD"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="85"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilaLista" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C2DBDD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B5DADF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CantidadRedonda" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#D9DEDA"
            CornerRadius="19"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="47"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}">
                <Grid Margin="16,0,12,0">
                    <TextBlock x:Name="TxtTitulo"
                               Text="Seleccionar"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Content="✕"
                            Width="29"
                            Height="29"
                            Background="#E52B50"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="Cancelar_Click"/>
                </Grid>
            </Border>

            <!-- BUSCADOR -->
            <Border Grid.Row="1"
                    Background="{StaticResource Turquesa}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Buscar:"
                               Foreground="White"
                               FontSize="15"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBuscar"
                             Width="250"
                             Style="{StaticResource BuscadorRedondo}"
                             TextChanged="Buscar_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- PACIENTES -->
            <Border x:Name="ContenedorPacientes"
                    Grid.Row="2"
                    Margin="10,10,10,5"
                    Background="#D9DEDA"
                    CornerRadius="13"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <ListBox x:Name="LstPacientes"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource FilaLista}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NombreCompleto}"
                                       FontSize="14"
                                       Foreground="#17475A"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- TRATAMIENTOS -->
            <Border x:Name="ContenedorTratamientos"
                    Grid.Row="2"
                    Margin="10,10,10,5"
                    Background="#D9DEDA"
                    CornerRadius="13"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <ListBox x:Name="LstTratamientos"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource FilaLista}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Nombre}"
                                          IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                          Foreground="#17475A"
                                          FontSize="14"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Precio, StringFormat=L {0:N2}}"
                                           Foreground="#17475A"
                                           FontSize="13"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- MATERIALES -->
            <Border x:Name="ContenedorMateriales"
                    Grid.Row="2"
                    Margin="10,10,10,5"
                    Background="#D9DEDA"
                    CornerRadius="13"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <DataGrid x:Name="DgMateriales"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          RowHeight="37"
                          Background="#D9DEDA"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre del material"
                                            Binding="{Binding Nombre}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTemplateColumn Header="Cantidad"
                                                Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        Style="{StaticResource CantidadRedonda}"
                                        Margin="4"
                                        Text="{Binding CantidadTexto,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding StockActual}"
                                            IsReadOnly="True"
                                            Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- VALIDACIONES -->
            <TextBlock x:Name="TxtError"
                       Grid.Row="3"
                       Foreground="#E52B50"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="16,6"/>

            <!-- PIE -->
            <Border Grid.Row="4"
                    Background="{StaticResource Turquesa}">
                <Button Content="Ok"
                        Style="{StaticResource BotonRedondo}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"
                        Click="Aceptar_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>


