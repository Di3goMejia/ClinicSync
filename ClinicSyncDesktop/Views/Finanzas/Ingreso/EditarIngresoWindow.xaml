<Window x:Class="ClinicSyncDesktop.Views.EditarIngresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar ingreso"
        Width="470"
        Height="405"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- DEGRADADO -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A8B0" Offset="0"/>
            <GradientStop Color="#168FA7" Offset="1"/>
        </LinearGradientBrush>

        <!-- ETIQUETA -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ERROR -->
        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E52B50"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- TEXTBOX REDONDO -->
        <Style x:Key="TextBoxRedondo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DEDA"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#D9DEDA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Borde"
                                        Property="BorderBrush"
                                        Value="#2398A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX REDONDO -->
        <Style x:Key="ComboBoxRedondo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="Background" Value="#D9DEDA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="16"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Margin="12,0,32,0"
                                                      IsHitTestVisible="False"/>
                                    <TextBlock Text="▼"
                                               FontSize="11"
                                               Foreground="#168FA7"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="White"
                                        BorderBrush="#B5CECE"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#91D2DD"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde"
                                        Property="Background"
                                        Value="#B4E4EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borde"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN MÁS -->
        <Style x:Key="BotonMas" TargetType="Button">
            <Setter Property="Width" Value="23"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Background" Value="#168FA7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="11.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN CERRAR -->
        <Style x:Key="BotonCerrar" TargetType="Button">
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Background" Value="#E52B50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SWITCH ACTIVO -->
        <Style x:Key="SwitchActivo" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Fondo"
                                    Width="40"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#8BC7C7"/>
                            <Ellipse x:Name="Circulo"
                                     Width="16"
                                     Height="16"
                                     Fill="White"
                                     HorizontalAlignment="Right"
                                     Margin="0,0,3,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#C9D1CE"/>
                                <Setter TargetName="Circulo"
                                        Property="HorizontalAlignment"
                                        Value="Left"/>
                                <Setter TargetName="Circulo"
                                        Property="Margin"
                                        Value="3,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#3AA9AF"/>
                                <Setter TargetName="Circulo"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Circulo"
                                        Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Border Margin="10"
            Background="White"
            CornerRadius="19"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    CornerRadius="12,12,0,0"
                    Background="{StaticResource Turquesa}">
                <Grid Margin="16,0,12,0">
                    <TextBlock Text="Editar información:"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Content="✕"
                            Style="{StaticResource BotonCerrar}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Cerrar_Click"/>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="1"
                        Margin="22,8,22,14">

                <!-- ACTIVO -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Activo:"
                               Foreground="#17475A"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleButton x:Name="TglActivo"
                                  Style="{StaticResource SwitchActivo}"
                                  IsChecked="True"/>
                </StackPanel>

                <!-- PACIENTE -->
                <TextBlock Text="Paciente: *"
                           Style="{StaticResource Etiqueta}"
                           Margin="0,16,0,6"/>

                <Grid>
                    <TextBox x:Name="TxtPaciente"
                             Style="{StaticResource TextBoxRedondo}"
                             IsReadOnly="True"
                             Padding="12,0,36,0"/>

                    <Button Content="+"
                            Style="{StaticResource BotonMas}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Click="SeleccionarPaciente_Click"/>
                </Grid>

                <TextBlock x:Name="ErrorPaciente"
                           Style="{StaticResource Error}"/>

                <!-- TRATAMIENTO / FECHA -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tratamiento(s): *"
                                   Style="{StaticResource Etiqueta}"/>

                        <Grid>
                            <TextBox x:Name="TxtTratamientos"
                                     Style="{StaticResource TextBoxRedondo}"
                                     IsReadOnly="True"
                                     Padding="12,0,36,0"/>

                            <Button Content="+"
                                    Style="{StaticResource BotonMas}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0"
                                    Click="SeleccionarTratamientos_Click"/>
                        </Grid>

                        <TextBlock x:Name="ErrorTratamientos"
                                   Style="{StaticResource Error}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha: *"
                                   Style="{StaticResource Etiqueta}"/>

                        <Border Height="32"
                                Background="#D9DEDA"
                                CornerRadius="16"
                                ClipToBounds="True">
                            <DatePicker x:Name="DpFecha"
                                        Background="#D9DEDA"
                                        Foreground="#17475A"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Padding="5,0"
                                        VerticalContentAlignment="Center"         
                                        SelectedDateChanged="DpFecha_SelectedDateChanged"/>
                        </Border>
                        
                        <TextBlock x:Name="ErrorFecha"
                                   Style="{StaticResource Error}"/>
                    </StackPanel>
                </Grid>

                <!-- DESCUENTO / MEDIO DE PAGO -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Descuento:"
                                   Style="{StaticResource Etiqueta}"/>

                        <TextBox x:Name="TxtDescuento"
                                 Style="{StaticResource TextBoxRedondo}"
                                 Text="0.00"
                                 TextChanged="Recalcular_Click"/>

                        <TextBlock x:Name="ErrorDescuento"
                                   Style="{StaticResource Error}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Medio de pago: *"
                                   Style="{StaticResource Etiqueta}"/>

                        <ComboBox x:Name="CmbMedioPago"
                                  Style="{StaticResource ComboBoxRedondo}">
                            <ComboBoxItem Content="Efectivo"/>
                            <ComboBoxItem Content="Transferencia"/>
                        </ComboBox>

                        <TextBlock x:Name="ErrorMedioPago"
                                   Style="{StaticResource Error}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorGeneral"
                           Style="{StaticResource Error}"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <!-- PIE -->
            <Border Grid.Row="2"
                    CornerRadius="0,0,12,12"
                    Background="{StaticResource Turquesa}">
                <Button x:Name="BtnGuardarCambios"
                        Content="Guardar cambios"
                        Style="{StaticResource BotonPrincipal}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="GuardarCambios_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>