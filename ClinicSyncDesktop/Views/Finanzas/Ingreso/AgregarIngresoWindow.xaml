<Window x:Class="ClinicSyncDesktop.Views.AgregarIngresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar ingreso"
        Width="480"
        Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CF4059"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonMas" TargetType="Button"
               BasedOn="{StaticResource BotonIcono}">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="BotonRedondo" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#B6E7ED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboRedondo" TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="#D9DDD8" CornerRadius="13"/>

                            <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,0,25,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>

                            <Image x:Name="IconoFlecha"
                                   Source="/Resources/ImagenesPacientes/flecha-hacia-abajo-combobox.png"
                                   Width="15"
                                   Height="15"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5"/>

                            <ToggleButton Focusable="False"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True">
                                <Border Background="White"
                                        BorderBrush="#D9DDD8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="IconoFlecha"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="9" Background="White" CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Turquesa}"
                    CornerRadius="15,15,0,0">
                <Grid Margin="16,0,12,0">
                    <TextBlock Text="Agregar nuevo ingreso:"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Width="23"
                            Height="23"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotonIcono}"
                            Click="Cerrar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="22,17,22,10">

                    <TextBlock Style="{StaticResource Etiqueta}">
                        <Run Text="Paciente:"/><Run Text=" *" Foreground="#CF4059" FontWeight="Bold"/>
                    </TextBlock>
                    <Grid>
                        <TextBox x:Name="TxtPaciente"
                                 Text="Seleccione un paciente"
                                 Style="{StaticResource Campo}"
                                 IsReadOnly="True"
                                 Padding="10,0,32,0"/>
                        <Button Style="{StaticResource BotonMas}"
                                ToolTip="Seleccionar paciente"
                                Click="SeleccionarPaciente_Click">
                            <Image Source="/Resources/ImagenesTabla/boton-mas.png"
                                   Width="17"
                                   Height="17"
                                   Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ErrorPaciente" Style="{StaticResource Error}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="145"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Etiqueta}">
                                <Run Text="Tratamiento(s):"/><Run Text=" *" Foreground="#CF4059" FontWeight="Bold"/>
                            </TextBlock>
                            <Grid>
                                <TextBox x:Name="TxtTratamientos"
                                 Text="Seleccione tratamientos"
                                         Style="{StaticResource Campo}"
                                         IsReadOnly="True"
                                         Padding="10,0,32,0"/>
                                <Button Style="{StaticResource BotonMas}"
                                        ToolTip="Seleccionar tratamientos"
                                        Click="SeleccionarTratamientos_Click">
                                    <Image Source="/Resources/ImagenesTabla/boton-mas.png"
                                           Width="17"
                                           Height="17"
                                           Stretch="Uniform"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ErrorTratamientos"
                                       Style="{StaticResource Error}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Etiqueta}">
                                <Run Text="Fecha:"/><Run Text=" *" Foreground="#CF4059" FontWeight="Bold"/>
                            </TextBlock>

                            <Grid Width="145" Height="25" HorizontalAlignment="Left">
                                <DatePicker x:Name="DpFecha"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Focusable="False"
                                            IsTabStop="False"
                                            SelectedDateChanged="DpFecha_SelectedDateChanged"/>

                                <Border Background="#D9DDD8" CornerRadius="13"/>

                                <Grid Margin="9,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <TextBox x:Name="TxtFechaIngreso"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#17475A"
                                                 FontSize="12"
                                                 Padding="0"
                                                 MaxLength="10"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="YYYY/MM/DD"
                                                 TextChanged="TxtFechaIngreso_TextChanged"
                                                 LostFocus="TxtFechaIngreso_LostFocus"/>

                                        <TextBlock Text="YYYY/MM/DD"
                                                   Foreground="#AEB0B1"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtFechaIngreso}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource BotonIcono}"
                                            ToolTip="Abrir calendario"
                                            Click="CalendarioIngreso_Click">
                                        <Image Source="/Resources/ImagenesPacientes/calendario.png"
                                               Width="15"
                                               Height="15"/>
                                    </Button>
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="ErrorFecha"
                                       Style="{StaticResource Error}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Materiales:"/><Run Foreground="#FFCF4059" Text=" *"/></TextBlock>
                        <Grid>
                            <TextBox x:Name="TxtMateriales"
                                 Text="Seleccionar materiales"
                                     Style="{StaticResource Campo}"
                                     IsReadOnly="True"
                                     Padding="10,0,32,0"/>
                            <Button Style="{StaticResource BotonMas}"
                                    ToolTip="Seleccionar materiales"
                                    Click="SeleccionarMateriales_Click">
                                <Image Source="/Resources/ImagenesTabla/boton-mas.png"
                                       Width="17"
                                       Height="17"
                                       Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ErrorMaterial" Style="{StaticResource Error}"/>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Descuento:" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtDescuento"
                                     Style="{StaticResource Campo}"
                                     Text="0.00"
                                     TextChanged="Recalcular_Click"/>
                            <TextBlock x:Name="ErrorDescuento" Style="{StaticResource Error}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Etiqueta}">
                                <Run Text="Medio de pago:"/><Run Text=" *" Foreground="#CF4059" FontWeight="Bold"/>
                            </TextBlock>
                            <ComboBox x:Name="CmbMedioPago" Style="{StaticResource ComboRedondo}">
                                <ComboBoxItem Content="Efectivo"/>
                                <ComboBoxItem Content="Transferencia"/>
                            </ComboBox>
                            <TextBlock x:Name="ErrorMedioPago" Style="{StaticResource Error}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,6" Background="#D9DDD8"/>

                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Subtotal:" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtSubtotal"
                                   DockPanel.Dock="Right"
                                   Text="L 0.00"
                                   Foreground="#17475A"/>
                    </DockPanel>

                    <DockPanel LastChildFill="False" Margin="0,6,0,0">
                        <TextBlock Text="TOTAL:"
                                   Foreground="#17475A"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotal"
                                   DockPanel.Dock="Right"
                                   Text="L 0.00"
                                   Foreground="#00A98B"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                    </DockPanel>

                    <TextBlock x:Name="ErrorGeneral" Style="{StaticResource Error}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,15,15">
                <Button x:Name="BtnGuardar"
                        Content="Agregar"
                        Width="95"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotonRedondo}"
                        Click="Guardar_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>