<UserControl x:Class="ClinicSyncDesktop.Views.IngresosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorTexto" Color="#17475A"/>
        <SolidColorBrush x:Key="ColorFondo" Color="#D9DDD8"/>
        <SolidColorBrush x:Key="ColorFilaAlterna" Color="#E8EBE7"/>

        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- BOTÓN AGREGAR NUEVO -->
        <Style x:Key="BotonAgregar" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FILTROS DE FECHA -->
        <Style x:Key="EstiloFiltro" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="#E8F0F0"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FILTRO DE ESTADO -->
        <Style x:Key="ComboFiltroRedondo" TargetType="ComboBox">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#E8F0F0"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="14"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Margin="12,0,25,0"
                                                      IsHitTestVisible="False"/>
                                    <TextBlock Text="▼"
                                               Foreground="#138DAA"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="White"
                                        BorderBrush="#B5CECE"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="180"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILOS DE LA TABLA -->
        <Style x:Key="EstiloEncabezado" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EstiloFila" TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EstiloCelda" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstiloTextoCelda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="EstiloMonto"
               TargetType="TextBlock"
               BasedOn="{StaticResource EstiloTextoCelda}">
            <Setter Property="Foreground" Value="#187A3D"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource ColorFondo}"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="12,12,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource BotonAgregar}"
                            HorizontalAlignment="Left"
                            Click="AgregarNuevo_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="/Resources/ImagenesTabla/IconoMas.png"
                                   Width="20"
                                   Height="20"
                                   Margin="5,0,10,0"/>
                            <TextBlock Text="AGREGAR NUEVO"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Filtrar:"
                                   Foreground="White"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="0,0,3,0"/>

                        <Button x:Name="BtnHoy"
                                Content="Hoy"
                                Width="65"
                                Style="{StaticResource EstiloFiltro}"
                                Click="Hoy_Click"/>

                        <Button x:Name="BtnSemana"
                                Content="Semana"
                                Width="84"
                                Style="{StaticResource EstiloFiltro}"
                                Click="Semana_Click"/>

                        <Button x:Name="BtnMes"
                                Content="Mes"
                                Width="65"
                                Style="{StaticResource EstiloFiltro}"
                                Click="Mes_Click"/>

                        <Button x:Name="BtnTodos"
                                Content="Todos"
                                Width="85"
                                Style="{StaticResource EstiloFiltro}"
                                Click="BtnTodos_Click"/>

                        <ComboBox x:Name="CmbEstadoIngresos"
                                  Style="{StaticResource ComboFiltroRedondo}"
                                  Margin="10,0,0,0"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbEstadoIngresos_SelectionChanged">
                            <ComboBoxItem Content="Todos" Tag="Todos"/>
                            <ComboBoxItem Content="Activos" Tag="Activos"/>
                            <ComboBoxItem Content="Inactivos" Tag="Inactivos"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TABLA DE INGRESOS -->
            <DataGrid x:Name="DgIngresos"
                      Grid.Row="1"
                      Background="Transparent"
                      Foreground="{StaticResource ColorTexto}"
                      RowBackground="{StaticResource ColorFondo}"
                      AlternatingRowBackground="{StaticResource ColorFilaAlterna}"
                      AlternationCount="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      FontSize="15"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ColumnHeaderStyle="{StaticResource EstiloEncabezado}"
                      RowStyle="{StaticResource EstiloFila}"
                      CellStyle="{StaticResource EstiloCelda}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.OpacityMask>
                    <VisualBrush Stretch="Fill">
                        <VisualBrush.Visual>
                            <Border Width="100"
                                    Height="100"
                                    Background="Black"
                                    CornerRadius="0,0,12,12"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </DataGrid.OpacityMask>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding IdIngreso}"
                                        Width="48"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding Fecha, StringFormat=yyyy/MM/dd HH:mm}"
                                        Width="145"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <DataGridTextColumn Header="Paciente"
                                        Binding="{Binding Paciente}"
                                        Width="2*"
                                        MinWidth="145"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <DataGridTextColumn Header="Tratamiento"
                                        Binding="{Binding Tratamiento}"
                                        Width="2*"
                                        MinWidth="145"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <DataGridTextColumn Header="Medio de pago"
                                        Binding="{Binding MedioPago}"
                                        Width="145"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <DataGridTextColumn Header="Descuento"
                                        Binding="{Binding Descuento, StringFormat='L {0:N2}'}"
                                        Width="125"
                                        ElementStyle="{StaticResource EstiloTextoCelda}"/>

                    <DataGridTextColumn Header="Monto"
                                        Binding="{Binding Total, StringFormat='L {0:N2}'}"
                                        Width="125"
                                        ElementStyle="{StaticResource EstiloMonto}"/>

                    <DataGridTemplateColumn Header=""
                                            Width="60"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Width="35"
                                        Height="35"
                                        Style="{StaticResource BotonIcono}"
                                        ToolTip="Editar ingreso"
                                        Click="EditarIngreso_Click">
                                    <Image Source="/Resources/ImagenesTabla/IconoEngranaje.png"
                                           Width="25"
                                           Height="25"
                                           Stretch="Uniform"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="ErrorListado"
                       Grid.Row="2"
                       Foreground="#E52B50"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="12,6"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>