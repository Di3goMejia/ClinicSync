<UserControl x:Class="ClinicSyncDesktop.Views.ResumenFinanzasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClinicSyncDesktop.Views"
             Background="Transparent"
             Loaded="ResumenFinanzasView_Loaded">

    <UserControl.Resources>
        <local:TextoInicialMayusculaConverter x:Key="TextoInicialMayuscula"/>

        <SolidColorBrush x:Key="ColorTexto" Color="#17475A"/>
        <SolidColorBrush x:Key="ColorFondo" Color="#D9DDD8"/>
        <SolidColorBrush x:Key="ColorFilaAlterna" Color="#E8EBE7"/>

        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="EstiloFiltro" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="#E8F0F0"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstiloTextoCelda" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="EstiloConcepto"
               TargetType="TextBlock"
               BasedOn="{StaticResource EstiloTextoCelda}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="ToolTip" Value="{Binding Concepto}"/>
        </Style>

        <Style x:Key="EstiloMonto"
               TargetType="TextBlock"
               BasedOn="{StaticResource EstiloTextoCelda}">
            <Setter Property="FontWeight" Value="Bold"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Tipo}" Value="INGRESO">
                    <Setter Property="Foreground" Value="#187A3D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="EGRESO">
                    <Setter Property="Foreground" Value="#B3261E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{StaticResource ColorFondo}" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA DE FILTROS Y EXPORTACIÓN -->
                <Border Grid.Row="0"
                        Background="{StaticResource Turquesa}"
                        CornerRadius="12,12,0,0">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnExportarPDF"
                                Grid.Column="0"
                                Content="Exportar PDF"
                                Width="120"
                                Margin="0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource EstiloFiltro}"
                                Click="ExportarPdf_Click"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Filtrar:"
                                       Foreground="White"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,3,0"/>

                            <Button x:Name="BtnHoy"
                                    Content="Hoy"
                                    Width="65"
                                    Style="{StaticResource EstiloFiltro}"
                                    Click="Hoy_Click"/>

                            <Button x:Name="BtnSemana"
                                    Content="Semana"
                                    Width="84"
                                    Style="{StaticResource EstiloFiltro}"
                                    Click="Semana_Click"/>

                            <Button x:Name="BtnMes"
                                    Content="Mes"
                                    Width="65"
                                    Style="{StaticResource EstiloFiltro}"
                                    Click="Mes_Click"/>

                            <Button x:Name="BtnTodos"
                                    Content="Todos"
                                    Width="85"
                                    Style="{StaticResource EstiloFiltro}"
                                    Click="Todos_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtError"
                           Grid.Row="1"
                           TextWrapping="Wrap"
                           Foreground="#B3261E"
                           Margin="10,8,10,4"
                           Visibility="Collapsed"/>

                <!-- TABLA DE RESUMEN -->
                <DataGrid x:Name="DgResumen"
                          Grid.Row="2"
                          Background="Transparent"
                          Foreground="{StaticResource ColorTexto}"
                          RowBackground="{StaticResource ColorFondo}"
                          AlternatingRowBackground="{StaticResource ColorFilaAlterna}"
                          AlternationCount="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          FontSize="15"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.OpacityMask>
                        <VisualBrush Stretch="Fill">
                            <VisualBrush.Visual>
                                <Border Width="100"
                                        Height="100"
                                        Background="Black"
                                        CornerRadius="0,0,12,12"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </DataGrid.OpacityMask>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo, Converter={StaticResource TextoInicialMayuscula}}"
                                            Width="0.9*"
                                            MinWidth="85"
                                            ElementStyle="{StaticResource EstiloTextoCelda}"/>

                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                            Width="1.4*"
                                            MinWidth="145"
                                            ElementStyle="{StaticResource EstiloTextoCelda}"/>

                        <DataGridTextColumn Header="Concepto"
                                            Binding="{Binding Concepto}"
                                            Width="2.5*"
                                            MinWidth="135"
                                            ElementStyle="{StaticResource EstiloConcepto}"/>

                        <DataGridTextColumn Header="Medio de pago"
                                            Binding="{Binding MedioPago, Converter={StaticResource TextoInicialMayuscula}}"
                                            Width="1.3*"
                                            MinWidth="120"
                                            ElementStyle="{StaticResource EstiloTextoCelda}"/>

                        <DataGridTextColumn Header="Monto"
                                            Binding="{Binding Monto, StringFormat={}{0:L 0.00}}"
                                            Width="1.1*"
                                            MinWidth="110"
                                            ElementStyle="{StaticResource EstiloMonto}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel x:Name="PanelAvisos"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,25,20"
                    Panel.ZIndex="100"
                    Visibility="Collapsed"/>
    </Grid>
</UserControl>