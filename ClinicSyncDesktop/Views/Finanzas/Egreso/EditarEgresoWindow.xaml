<Window x:Class="ClinicSyncDesktop.Views.EditarEgresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar egreso"
        Width="460"
        Height="410"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- DEGRADADO TURQUESA DE EDITAR PACIENTE -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- ETIQUETAS -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- CAMPOS REDONDEADOS -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN REDONDEADO DE PACIENTES -->
        <Style x:Key="BotonRedondo" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#B6E7ED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX DE EDITAR PACIENTE -->
        <Style x:Key="ComboRedondo" TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="#D9DDD8"
                                    CornerRadius="13"/>

                            <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,0,25,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>

                            <Image x:Name="IconoFlecha"
                                   Source="/Resources/ImagenesPacientes/flecha-hacia-abajo-combobox.png"
                                   Width="15"
                                   Height="15"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Image.RenderTransform>
                            </Image>

                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                Opacity="0"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   StaysOpen="False">
                                <Border Background="White"
                                        BorderBrush="#D9DDD8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="160"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="IconoFlecha"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INTERRUPTOR ORIGINAL DE EDITAR PACIENTE -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Width" Value="39"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Fondo"
                                    Background="#D9DDD8"
                                    CornerRadius="11"/>

                            <Ellipse x:Name="Circulo"
                                     Width="16"
                                     Height="16"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#23A995"/>
                                <Setter TargetName="Circulo"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Circulo"
                                        Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FECHA REDONDEADA -->
        <Style x:Key="FechaRedondeada" TargetType="DatePicker">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="#D9DDD8"
                                CornerRadius="13">
                            <Grid Margin="9,0,5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox
                                    x:Name="PART_TextBox"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#17475A"
                                    FontSize="12"
                                    VerticalContentAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        Cursor="Hand">
                                    <Image Source="/Resources/ImagenesPacientes/calendario.png"
                                           Width="15"
                                           Height="15"/>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       StaysOpen="False"
                                       IsOpen="{Binding IsDropDownOpen,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           Mode=TwoWay}">
                                    <Border Background="White"
                                            BorderBrush="#D9DDD8"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Calendar x:Name="PART_Calendar"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- VENTANA PRINCIPAL -->
    <Border Margin="9"
            Background="White"
            CornerRadius="15"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="5"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="15,15,0,0">

                <Grid Margin="12,0,9,0">
                    <TextBlock Text="Editar egreso:"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="10,0,-10,0"/>

                    <Button Width="23"
                            Height="23"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cancelar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"/>
                    </Button>
                </Grid>
            </Border>

            <!-- FORMULARIO -->
            <Grid Grid.Row="1"
                  Margin="22,17,22,7">

                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="61"/>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ACTIVO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Activo:"
                               Style="{StaticResource Etiqueta}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <CheckBox x:Name="chkActivo"
                              Style="{StaticResource Interruptor}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- FECHA Y HORA -->
                <StackPanel Grid.Row="1">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Fecha:"
                                   Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text=" *"
                                   Foreground="#CF4059"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="dpFecha"
                                    Grid.Column="0"
                                    Style="{StaticResource FechaRedondeada}"/>

                        <TextBox x:Name="txtHora"
                                 Grid.Column="2"
                                 Style="{StaticResource Campo}"
                                 Text="00:00"
                                 MaxLength="5"
                                 TextAlignment="Center"
                                 ToolTip="HH:mm"/>
                    </Grid>
                </StackPanel>

                <!-- CONCEPTO -->
                <StackPanel Grid.Row="2">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Concepto:"
                                   Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text=" *"
                                   Foreground="#CF4059"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox x:Name="txtConcepto"
                             Style="{StaticResource Campo}"
                             Height="65"
                             Margin="0,5,0,0"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"/>
                </StackPanel>

                <!-- MEDIO DE PAGO Y MONTO -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Medio de pago:"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text=" *"
                                       Foreground="#CF4059"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <ComboBox x:Name="cmbMedio"
                                  Style="{StaticResource ComboRedondo}"
                                  Margin="0,5,0,0">
                            <ComboBoxItem Content="EFECTIVO"/>
                            <ComboBoxItem Content="TRANSFERENCIA"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Monto:"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text=" *"
                                       Foreground="#CF4059"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBox x:Name="txtMonto"
                                 Style="{StaticResource Campo}"
                                 Margin="0,5,0,0"
                                 ToolTip="0.00"/>
                    </StackPanel>
                </Grid>

                <!-- MENSAJES DE VALIDACIÓN -->
                <TextBlock x:Name="txtError"
                           Grid.Row="4"
                           Foreground="#CF4059"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Margin="0,5,0,0"/>
            </Grid>

            <!-- PIE CON DEGRADADO -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,15,15">

                <Button x:Name="btnGuardar"
                        Content="Guardar cambios"
                        Width="150"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotonRedondo}"
                        Click="Guardar_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
