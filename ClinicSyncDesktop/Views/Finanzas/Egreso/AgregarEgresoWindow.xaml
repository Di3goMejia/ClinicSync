<Window x:Class="ClinicSyncDesktop.Views.AgregarEgresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar nuevo egreso"
        Width="460"
        Height="414"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- DEGRADADO TURQUESA -->
        <LinearGradientBrush x:Key="Turquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- ETIQUETAS -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- CAMPOS REDONDEADOS -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CAMPO DE VARIAS LÍNEAS (CONCEPTO) -->
        <Style x:Key="CampoMultilinea" TargetType="TextBox">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN AGREGAR REDONDEADO -->
        <Style x:Key="BotonRedondo" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#B6E7ED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX REDONDEADO -->
        <Style x:Key="ComboRedondo" TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="#D9DDD8"
                                    CornerRadius="13"/>

                            <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                Margin="10,0,25,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>

                            <!-- FLECHA QUE GIRA -->
                            <Image x:Name="IconoFlecha"
                                   Source="/Resources/ImagenesPacientes/flecha-hacia-abajo-combobox.png"
                                   Width="15"
                                   Height="15"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Image.RenderTransform>
                            </Image>

                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                Opacity="0"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   StaysOpen="False">
                                <Border Background="White"
                                        BorderBrush="#D9DDD8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="IconoFlecha"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN CALENDARIO -->
        <Style x:Key="BotonCalendario" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- VENTANA REDONDEADA -->
    <Border Margin="9"
            CornerRadius="15"
            Background="White"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="5"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Border Grid.Row="0"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">

                <Grid Margin="12,0,9,0">
                    <TextBlock Text="Agregar nuevo egreso:"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="10,0,-10,0"/>

                    <Button Width="23"
                            Height="23"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cerrar_Click">
                        <Image Source="/Resources/ImagenesPacientes/cerrar-ventana.png"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- FORMULARIO -->
            <Grid Grid.Row="1"
                  Margin="22,17,22,10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="102"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FECHA Y HORA -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FECHA -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fecha:"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text=" *"
                                       Foreground="#CF4059"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid Height="25"
                              Margin="0,5,0,0">

                            <Border Background="#D9DDD8"
                                    CornerRadius="13"/>

                            <Grid Margin="9,0,5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>

                                <!-- FECHA EDITABLE -->
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="txtFecha"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#17475A"
                                             FontSize="12"
                                             Padding="0"
                                             MaxLength="10"
                                             VerticalContentAlignment="Center"
                                             TextChanged="txtFecha_TextChanged"
                                             LostFocus="txtFecha_LostFocus"
                                             ToolTip="AAAA/MM/DD"/>

                                    <TextBlock x:Name="txtPlaceholderFecha"
                                               Text="YYYY/MM/DD"
                                               Foreground="#AEB0B1"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <!-- ICONO CALENDARIO -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource BotonCalendario}"
                                        Click="Calendario_Click">
                                    <Image Source="/Resources/ImagenesPacientes/calendario.png"
                                           Width="15"
                                           Height="15"/>
                                </Button>
                            </Grid>

                            <!-- DATEPICKER INTERNO -->
                            <DatePicker x:Name="dpFecha"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        SelectedDateChanged="dpFecha_SelectedDateChanged"
                                        Panel.ZIndex="-1"/>
                        </Grid>
                    </StackPanel>

                    <!-- HORA -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Hora:"/><Run Foreground="#FFCF4059" FontWeight="Bold" Language="es-hn" Text=" "/><Run Foreground="#FFCF4059" FontWeight="Bold" Text="*"/></TextBlock>
                        <TextBox x:Name="txtHora"
                                 Style="{StaticResource Campo}"
                                 Margin="0,5,0,0"
                                 MaxLength="5"
                                 Text="00:00"
                                 ToolTip="HH:mm"/>
                    </StackPanel>
                </Grid>

                <!-- TIPO -->
                <StackPanel Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tipo:"
                                   Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text=" *"
                                   Foreground="#CF4059"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <ComboBox x:Name="cmbTipo"
                              Margin="0,5,0,0"
                              Style="{StaticResource ComboRedondo}"
                              SelectedIndex="0"
                              SelectionChanged="cmbTipo_SelectionChanged">
                        <ComboBoxItem Content="Seleccione una opción"
                                      IsEnabled="False"/>
                        <ComboBoxItem Content="Materiales"
                                      Tag="MATERIALES"/>
                        <ComboBoxItem Content="Servicios"
                                      Tag="SERVICIOS"/>
                    </ComboBox>
                </StackPanel>

                <!-- CONCEPTO -->
                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Concepto:"
                                   Style="{StaticResource Etiqueta}"/>
                        <TextBlock Text=" *"
                                   Foreground="#CF4059"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <Grid Margin="0,5,0,0"
                          Height="72">

                        <!-- SERVICIOS: TEXTO LIBRE -->
                        <TextBox x:Name="txtConcepto"
                                 Height="72"
                                 MaxLength="255"
                                 Style="{StaticResource CampoMultilinea}"/>

                        <!-- MATERIALES: SELECTOR -->
                        <Border x:Name="panelMateriales"
                                Visibility="Collapsed"
                                Background="#D9DDD8"
                                CornerRadius="13"
                                Cursor="Hand"
                                MouseLeftButtonUp="Materiales_Click">
                            <Grid Margin="12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtMateriales"
                                           Text="Seleccione un material"
                                           Foreground="#8A9A9E"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="#138DAA"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="+"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-2,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- MEDIO DE PAGO Y MONTO -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MEDIO DE PAGO -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Medio de pago:"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text=" *"
                                       Foreground="#CF4059"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <ComboBox x:Name="cmbMedio"
                                  Margin="0,5,0,0"
                                  Style="{StaticResource ComboRedondo}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Seleccione una opción"
                                          IsEnabled="False"/>
                            <ComboBoxItem Content="Efectivo"
                                          Tag="EFECTIVO"/>
                            <ComboBoxItem Content="Transferencia"
                                          Tag="TRANSFERENCIA"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- MONTO -->
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Monto:"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBlock Text=" *"
                                       Foreground="#CF4059"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Grid Margin="0,5,0,0">
                            <TextBox x:Name="txtMonto"
                                     Style="{StaticResource Campo}"
                                     Padding="26,0,10,0"
                                     MaxLength="10"
                                     PreviewTextInput="txtMonto_PreviewTextInput"
                                     ToolTip="0.00"/>

                            <TextBlock Text="L"
                                       Foreground="#7A8A8F"
                                       FontSize="12"
                                       Margin="21,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- MENSAJE DE VALIDACIÓN -->
                <Grid Grid.Row="4"
                      Margin="0,5,0,0"
                      VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="iconoError"
                           Grid.Column="0"
                           Source="/Resources/ImagenesAvisos/validacion-alerta.png"
                           Width="13"
                           Height="13"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0"
                           Visibility="Collapsed"/>

                    <TextBlock x:Name="txtError"
                               Grid.Column="1"
                               Foreground="#CF4059"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                </Grid>

            </Grid>

            <!-- BOTÓN AGREGAR -->
            <Border Grid.Row="2"
                    Background="{StaticResource Turquesa}"
                    CornerRadius="0,0,15,15">

                <Button x:Name="btnAgregar"
                        Content="Agregar"
                        Width="95"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotonRedondo}"
                        Click="Agregar_Click"/>
            </Border>

        </Grid>
    </Border>
</Window>