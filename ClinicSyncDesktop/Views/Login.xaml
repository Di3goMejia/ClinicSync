<Window x:Class="ClinicSync.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicSync - Iniciar Sesión"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="800"
        MinHeight="650"
        Background="#168FA8">

    <Window.Resources>

        <!-- FONDO TURQUESA -->
        <LinearGradientBrush x:Key="FondoLogin"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- ESTILO DE CAMPOS -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- BOTÓN ACCEDER -->
        <Style x:Key="BotonAcceder" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="47"/>
            <Setter Property="Background" Value="#168FA8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource FondoLogin}">

        <StackPanel Width="490"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- LOGO -->
            <Image Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/Imagenes MenuPrincipal/ClinicSync-LOGO.png"
                   Width="130"
                   Height="130"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>

            <TextBlock Text="CLINIC&#10;SYNC"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,18"/>

            <!-- PANEL DE LOGIN -->
            <Border Width="490"
                    Height="500"
                    Background="#73B9C8"
                    CornerRadius="22">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Iniciar Sesión"
                               FontSize="35"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <!-- USUARIO -->
                    <StackPanel Margin="0,0,0,28">

                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="White">
                            <Run Text="Usuario:"/>
                            <Run Text="*" Foreground="#FF365B"/>
                        </TextBlock>

                        <Border Width="220"
                                Height="45"
                                Background="White"
                                CornerRadius="6">

                            <TextBox x:Name="TxtUsuario"
                                     Style="{StaticResource CampoTexto}"
                                     Text=""
                                     VerticalContentAlignment="Center"/>
                        </Border>

                    </StackPanel>

                    <!-- CONTRASEÑA -->
                    <StackPanel Margin="0,0,0,8">

                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="White">
                            <Run Text="Contraseña:"/>
                            <Run Text="*" Foreground="#FF365B"/>
                        </TextBlock>

                        <Border Width="220"
                                Height="47"
                                Background="White"
                                CornerRadius="6">

                            <Grid>

                                <PasswordBox x:Name="TxtContrasena"
                                             Margin="0,0,40,0"
                                             Padding="12,8"
                                             FontSize="16"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"/>

                                <TextBox x:Name="TxtContrasenaVisible"
                                         Style="{StaticResource CampoTexto}"
                                         Margin="0,0,40,0"
                                         Visibility="Collapsed"/>

                                <Button x:Name="BtnMostrarContrasena"
                                        Width="35"
                                        Height="35"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Mostrar contraseña"
                                        Click="BtnMostrarContrasena_Click">

                                    <Image x:Name="IconoContrasena"
                                           Source="pack://application:,,,/ClinicSyncDesktop;component/Resources/ImagenesLogin/mostrar-contraseña.png"
                                           Width="24"
                                           Height="24"
                                           Stretch="Uniform"/>
                                </Button>

                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Content="Acceder"
                            Style="{StaticResource BotonAcceder}"
                            Click="Acceder_Click"/>

                    <Button Content="¿Olvidó su contraseña?"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OlvidoContrasena_Click"/>

                    <Button Content="Activar cuenta"
                            Margin="0,8,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="ActivarCuenta_Click"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>