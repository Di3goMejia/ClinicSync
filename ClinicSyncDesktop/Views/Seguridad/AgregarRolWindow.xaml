<Window x:Class="ClinicSyncDesktop.Views.Seguridad.AgregarRolWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Agregar rol" Width="650" Height="600" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboRedondo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="15"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Grid.Column="0"
                                                      Margin="12,0,25,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>

                                    <TextBlock Text="▼"
                                               Grid.Column="1"
                                               Foreground="#168FA7"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" StaysOpen="False">
                                <Border Background="White" BorderBrush="#D9DDD8" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPie" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExpanderGrupo" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          Focusable="False"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"/>

                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Margin="7" Background="White" CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            
            <!-- BARRA -->
            <Border Grid.Row="0" Background="{StaticResource Turquesa}" CornerRadius="11,11,0,0" MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Agregar nuevo rol" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="16,0" 
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="19"
                            Height="20"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#E8424B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Cancelar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            
            <!-- INDICADOR PASO ACTUAL -->
            <Grid Grid.Row="1" Margin="35,13,35,0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="2,0">
                    <Border x:Name="BarraPaso1" Height="5" Background="#138DAA"/>
                    <TextBlock Text="Información del rol" Foreground="#17475A" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="2,0">
                    <Border x:Name="BarraPaso2" Height="5" Background="#D9DDD8"/>
                    <TextBlock Text="Permisos" Foreground="#17475A" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="30,10">
                <StackPanel x:Name="PanelInfo">
                    <!-- NOMBRE -->
                    <TextBlock Style="{StaticResource Etiqueta}" Margin="0,10,0,5">
                        <Run Text="Nombre"/>
                        <Run Text=" *" Foreground="#CF4059"/>
                    </TextBlock>
                    <TextBox x:Name="TxtNombre" Style="{StaticResource Campo}" Margin="0,4,0,14" />

                    <!-- DESCRIPCIÓN -->
                    <TextBlock Style="{StaticResource Etiqueta}" Margin="0,10,0,5">Descripción</TextBlock>
                    <TextBox x:Name="TxtDescripcion" 
                             Style="{StaticResource Campo}" 
                             Height="70" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             Margin="0,4,0,14" />
                    
                    <!-- ROL BASE -->
                    <TextBlock Style="{StaticResource Etiqueta}" Margin="0,10,0,5" Text="Rol base" />
                    <ComboBox x:Name="CmbRolBase" 
                              Style="{StaticResource ComboRedondo}"
                              Height="30" 
                              Margin="0,4,0,14" 
                              SelectionChanged="RolBase_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- ERROR -->
                    <TextBlock x:Name="TxtError" Foreground="#B3261E" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="PanelPermisos" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               x:Name="TxtMensajePermisos" 
                               Foreground="#17475A" 
                               FontWeight="SemiBold" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,10" />
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,10,0" Text="Buscar:" FontWeight="SemiBold" />
                        <TextBox x:Name="TxtBuscarPermiso" 
                                 Style="{StaticResource Campo}" 
                                 Width="260" 
                                 TextChanged="FiltroPermisos_TextChanged" />

                        <TextBlock Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="30,0,10,0" Text="Módulo:" FontWeight="SemiBold" />
                        <ComboBox x:Name="CmbModulo" 
                                  Style="{StaticResource ComboRedondo}"
                                  Width="150" 
                                  Height="30" 
                                  SelectionChanged="FiltroPermisos_Changed" />
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="0,0,12,0">
                        <ItemsControl x:Name="ListaPermisos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource ExpanderGrupo}"
                                              IsExpanded="{Binding EstaExpandido, Mode=TwoWay}"
                                              Margin="0,0,0,8">
                                        <Expander.Header>
                                            <Border Background="{StaticResource Turquesa}"
                                                    CornerRadius="6"
                                                    Padding="10,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="▼"
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Nombre}"
                                                               Grid.Column="1"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <CheckBox IsThreeState="True"
                                                              IsChecked="{Binding TodosSeleccionados, Mode=OneWay}"
                                                              Click="GrupoSeleccionado_Click"
                                                              Grid.Column="2"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Permisos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10,6"
                                                            BorderBrush="#E1E6E3"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Nombre}"
                                                                       Foreground="#17475A"
                                                                       VerticalAlignment="Center" />
                                                            <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                                                      Click="PermisoSeleccionado_Click"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource Turquesa}" Grid.ColumnSpan="2" CornerRadius="0,0,11,11">
                <Grid Margin="20,4">
                    <Button x:Name="BtnRegresar" 
                            Content="Regresar" 
                            Style="{StaticResource BotonPie}" 
                            HorizontalAlignment="Left" 
                            Visibility="Collapsed" 
                            Click="Regresar_Click" />
                    
                    <Button x:Name="BtnSiguiente" 
                            Content="Siguiente" 
                            Style="{StaticResource BotonPie}" 
                            HorizontalAlignment="Right" 
                            Click="Siguiente_Click" />
                    
                    <Button x:Name="BtnAgregar" 
                            Content="Agregar" 
                            Style="{StaticResource BotonPie}" 
                            HorizontalAlignment="Right" 
                            Visibility="Collapsed" 
                            Click="Guardar_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
