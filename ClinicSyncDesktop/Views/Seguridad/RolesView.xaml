<UserControl x:Class="ClinicSyncDesktop.Views.Seguridad.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="DegradadoTurquesa"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>

        <!-- BOTÓN AGREGAR -->
        <Style x:Key="BotonAgregar" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BUSCADOR -->
        <Style x:Key="CampoBuscar" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F7F4"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX DE ESTADO CON EL ESTILO DE INGRESOS -->
        <Style x:Key="ComboFiltroRedondo" TargetType="ComboBox">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#E8F0F0"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <Grid>
                                    <ContentPresenter
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="12,0,25,0"
                                        IsHitTestVisible="False"/>

                                    <TextBlock Text="▼"
                                               Foreground="#138DAA"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="White"
                                        BorderBrush="#B5CECE"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="180"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN DE OPCIONES -->
        <Style x:Key="BotonEngranaje" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ENCABEZADOS -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- FILAS -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- CELDAS -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#17475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextoCentrado" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- INDICADOR DE ROL ACTIVO -->
        <Style x:Key="Interruptor" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Pista"
                                    Background="#EFF1EE"
                                    CornerRadius="9"/>
                            <Ellipse x:Name="Circulo"
                                     Width="13"
                                     Height="13"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pista"
                                        Property="Background"
                                        Value="#25AD9A"/>
                                <Setter TargetName="Circulo"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Circulo"
                                        Property="Margin"
                                        Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border Background="#D9DDD8"
                CornerRadius="12"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA SUPERIOR -->
                <Border Grid.Row="0"
                        Background="{StaticResource DegradadoTurquesa}"
                        CornerRadius="12,12,0,0">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnAgregar"
                                Grid.Column="0"
                                Style="{StaticResource BotonAgregar}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                VerticalAlignment="Center"
                                Click="BtnAgregar_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/ImagenesTabla/IconoMas.png"
                                       Width="20"
                                       Height="20"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="5,0,10,0"/>
                                <TextBlock Text="AGREGAR NUEVO"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="2"
                                   Text="Buscar:"
                                   Foreground="White"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="TxtBuscar"
                                 Grid.Column="3"
                                 Style="{StaticResource CampoBuscar}"
                                 Height="25"
                                 VerticalAlignment="Center"
                                 ToolTip="Buscar roles"
                                 TextChanged="TxtBuscar_TextChanged"/>

                        <TextBlock Grid.Column="4"
                                   Text="Estado:"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="12,0,8,0"/>

                        <ComboBox x:Name="CmbEstado"
                                  Grid.Column="5"
                                  Style="{StaticResource ComboFiltroRedondo}"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbEstado_SelectionChanged">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Activos"/>
                            <ComboBoxItem Content="Inactivos"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- TABLA DE ROLES -->
                <DataGrid x:Name="dgRoles"
                          Grid.Row="1"
                          Background="Transparent"
                          RowBackground="#D9DDD8"
                          AlternatingRowBackground="#E8EBE7"
                          AlternationCount="2"
                          Foreground="#17475A"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          FontSize="15"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.OpacityMask>
                        <VisualBrush Stretch="Fill">
                            <VisualBrush.Visual>
                                <Border Width="100"
                                        Height="100"
                                        Background="Black"
                                        CornerRadius="0,0,12,12"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </DataGrid.OpacityMask>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding IdRol}"
                                            Width="0.55*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="2.1*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding Descripcion}"
                                            Width="1.3*"
                                            ElementStyle="{StaticResource TextoCentrado}"/>

                        <DataGridTemplateColumn Header="Activo" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Interruptor}"
                                                  IsChecked="{Binding Activo}"
                                                  IsHitTestVisible="False"
                                                  Focusable="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header=""
                                                Width="50"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button x:Name="BtnOpciones"
                                            Style="{StaticResource BotonEngranaje}"
                                            ToolTip="Opciones del rol"
                                            Click="BtnOpciones_Click">
                                        <Image Source="/Resources/ImagenesTabla/IconoEngranaje.png"
                                               Width="25"
                                               Height="25"
                                               Stretch="Uniform"
                                               SnapsToDevicePixels="True"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel x:Name="PanelAvisos"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,35"
                    Panel.ZIndex="10"/>
    </Grid>
</UserControl>