<Window x:Class="ClinicSyncDesktop.Views.Seguridad.SolicitarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar acción"
        Width="360" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#32A5AB" Offset="0"/>
            <GradientStop Color="#138DAA" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="BotonPie" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Campo" TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border Margin="7" Background="White" CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <!-- BARRA -->
            <Border Grid.Row="0" Background="{StaticResource Turquesa}" CornerRadius="11,11,0,0"  MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">
                <Grid Margin="15,0,10,0">
                    <TextBlock Text="Confirmar acción" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Width="19"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#E8424B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Cancelar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="1" Margin="25,15,25,10">
                <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" Foreground="#17475A" FontSize="13" Margin="0,0,0,10"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource Campo}"/>
                <TextBlock x:Name="TxtError" Foreground="#CF4059" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- PIE -->
            <Border Grid.Row="2" Background="{StaticResource Turquesa}" CornerRadius="0,0,11,11">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Content="Cancelar" Style="{StaticResource BotonPie}" Click="Cancelar_Click"/>
                    <Button Content="Confirmar" Style="{StaticResource BotonPie}" Margin="8,0,0,0" Click="Confirmar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
