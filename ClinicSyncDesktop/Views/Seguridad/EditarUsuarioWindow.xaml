<Window x:Class="ClinicSyncDesktop.Views.Seguridad.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar usuario" Width="560" Height="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#32A5AB"/><GradientStop Color="#138DAA" Offset="1"/></LinearGradientBrush>
        <Style x:Key="Etiqueta" TargetType="TextBlock"><Setter Property="Foreground" Value="#17475A"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="Campo" TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#D9DDD8"/><Setter Property="Foreground" Value="#17475A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="Boton" TargetType="Button"><Setter Property="Background" Value="#92D4DE"/><Setter Property="Foreground" Value="#17475A"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,6"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Border Margin="7" Background="White" CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Turquesa}" MouseLeftButtonDown="Encabezado_MouseLeftButtonDown"><Grid Margin="15,0,10,0"><TextBlock Text="Editar usuario" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/><Button Width="27" Height="27" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Click="Cerrar_Click"><TextBlock Text="×" Foreground="White" FontSize="25" Margin="0,-4,0,0"/></Button></Grid></Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnDatos" Content="Datos personales" Style="{StaticResource Boton}" Width="160" Click="Datos_Click"/>
                <Button x:Name="BtnCuenta" Content="Cuenta" Style="{StaticResource Boton}" Width="120" Margin="8,0,0,0" Click="Cuenta_Click"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="35,8">
                <Grid>
                    <StackPanel x:Name="PanelDatos">
                        <TextBlock Text="Identidad" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtIdentidad" Style="{StaticResource Campo}" Margin="0,0,0,10"/>
                        <TextBlock Text="Nombres" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtNombres" Style="{StaticResource Campo}" Margin="0,0,0,10"/>
                        <TextBlock Text="Apellidos" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtApellidos" Style="{StaticResource Campo}" Margin="0,0,0,10"/>
                        <TextBlock Text="Fecha de nacimiento" Style="{StaticResource Etiqueta}"/><DatePicker x:Name="DpFechaNacimiento" Height="30" Margin="0,0,0,10"/>
                        <TextBlock Text="Género" Style="{StaticResource Etiqueta}"/><ComboBox x:Name="CmbGenero" Height="30" Margin="0,0,0,10"><ComboBoxItem Content="Femenino" Tag="F"/><ComboBoxItem Content="Masculino" Tag="M"/></ComboBox>
                        <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtTelefono" Style="{StaticResource Campo}" Margin="0,0,0,10"/>
                         <TextBlock Text="Rol" Style="{StaticResource Etiqueta}"/><ComboBox x:Name="CmbRol" Height="30" DisplayMemberPath="Nombre" SelectedValuePath="IdRol" Margin="0,0,0,8"/>
                        <Button Content="Elegir imagen" HorizontalAlignment="Left" Click="SeleccionarImagen_Click" Margin="0,4,0,8"/>
                        <Border Background="#E8F4F4" BorderBrush="#B8D9D9" BorderThickness="1" CornerRadius="8" Width="130" Height="160" HorizontalAlignment="Left"><Image x:Name="ImgPerfil" Stretch="UniformToFill" Margin="4"/></Border>
                    </StackPanel>
                    <StackPanel x:Name="PanelCuenta" Visibility="Collapsed">
                        <TextBlock Text="Nombre de usuario" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtNombreUsuario" Style="{StaticResource Campo}" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="Correo electrónico" Style="{StaticResource Etiqueta}"/><TextBox x:Name="TxtCorreo" Style="{StaticResource Campo}" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="Estado de la cuenta" Style="{StaticResource Etiqueta}"/><TextBlock x:Name="TxtEstado" Foreground="#17475A" FontWeight="Bold" Margin="0,0,0,10"/>
                         <Button x:Name="BtnReenviar" Content="Reenviar solicitud de activación" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="Reenviar_Click" Margin="0,0,0,8"/>
                         <Button x:Name="BtnCambiarEstado" Content="Desactivar usuario" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="CambiarEstado_Click" Margin="0,0,0,8"/>
                        <Button Content="Restablecer contraseña" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="Restablecer_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TxtError" Foreground="#B3261E" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed"/>
            </Grid>
            <Border Grid.Row="3" Background="{StaticResource Turquesa}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"><Button Content="Guardar" Style="{StaticResource Boton}" Click="Guardar_Click"/><Button Content="Cancelar" Style="{StaticResource Boton}" Margin="8,0,0,0" Click="Cerrar_Click"/></StackPanel></Border>
        </Grid>
    </Border>
</Window>
