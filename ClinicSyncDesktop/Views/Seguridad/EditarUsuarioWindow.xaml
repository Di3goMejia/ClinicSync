<Window x:Class="ClinicSyncDesktop.Views.Seguridad.EditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar usuario" Width="560" Height="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <LinearGradientBrush x:Key="Turquesa" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#32A5AB"/><GradientStop Color="#138DAA" Offset="1"/></LinearGradientBrush>
        <Style x:Key="Etiqueta" TargetType="TextBlock"><Setter Property="Foreground" Value="#17475A"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboRedondo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#D9DDD8"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="15"/>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Grid.Column="0" Margin="12,0,25,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <TextBlock Text="▼" Grid.Column="1" Foreground="#168FA7" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" StaysOpen="False">
                                <Border Background="White" BorderBrush="#D9DDD8" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="160"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Background" Value="#92D4DE"/>
            <Setter Property="Foreground" Value="#17475A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonPlano" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <Border Margin="7" Background="White" CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Turquesa}" CornerRadius="11,11,0,0" MouseLeftButtonDown="Encabezado_MouseLeftButtonDown">
                <Grid Margin="15,0,10,0">
                    <TextBlock Text="Editar usuario" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Width="19"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#E8424B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Cerrar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnDatos" Content="Datos personales" Style="{StaticResource Boton}" Width="160" Click="Datos_Click"/>
                <Button x:Name="BtnCuenta" Content="Cuenta" Style="{StaticResource Boton}" Width="120" Margin="8,0,0,0" Click="Cuenta_Click"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="35,8">
                <Grid>
                    <StackPanel x:Name="PanelDatos">
                        <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Identidad"/><Run Text=" *" Foreground="#CF4059"/></TextBlock>
                        <TextBox x:Name="TxtIdentidad" Style="{StaticResource Campo}" MaxLength="20" ToolTip="XXXX-XXXX-XXXXX"/>

                        <TextBlock Style="{StaticResource Etiqueta}" Margin="0,10,0,5"><Run Text="Nombre completo"/><Run Text=" *" Foreground="#CF4059"/></TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNombres" Grid.Column="0" Style="{StaticResource Campo}" MaxLength="50" ToolTip="Nombres"/>
                            <TextBox x:Name="TxtApellidos" Grid.Column="2" Style="{StaticResource Campo}" MaxLength="50" ToolTip="Apellidos"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Fecha de nacimiento"/><Run Text=" *" Foreground="#CF4059"/></TextBlock>
                                <DatePicker x:Name="DpFechaNacimiento" Height="30" Background="#D9DDD8" Foreground="#17475A" BorderThickness="0" SelectedDateFormat="Short"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Sexo"/><Run Text=" *" Foreground="#CF4059"/></TextBlock>
                                <ComboBox x:Name="CmbGenero" Style="{StaticResource ComboRedondo}">
                                    <ComboBoxItem Content="Femenino" Tag="F"/>
                                    <ComboBoxItem Content="Masculino" Tag="M"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Teléfono"/><Run Text=" *" Foreground="#CF4059"/></TextBlock>
                                <TextBox x:Name="TxtTelefono" Style="{StaticResource Campo}" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Etiqueta}"><Run Text="Rol"/><Run Text=" *" Foreground="#CF4059"/></TextBlock>
                                <ComboBox x:Name="CmbRol" Style="{StaticResource ComboRedondo}" SelectedValuePath="IdRol">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nombre}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E8F4F4" BorderBrush="#B8D9D9" BorderThickness="1" CornerRadius="8" Width="65" Height="80" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Image x:Name="ImgPerfil" Stretch="UniformToFill" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Imagen:" Foreground="#17475A" FontSize="13" FontWeight="SemiBold" Margin="0,4,10,0"/>
                                    <Button Grid.Column="1" Height="25" Padding="8,0" Background="#E4F0F0" Style="{StaticResource BotonPlano}" Click="SeleccionarImagen_Click">
                                        <TextBlock Text="Elegir imagen" Foreground="#168FAD" FontSize="11"/>
                                    </Button>
                                    <TextBox x:Name="TxtImagen" Grid.Column="2" Height="25" Margin="6,0,4,0" IsReadOnly="True" Background="Transparent" Foreground="#17475A" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Imagen seleccionada"/>
                                    <Button x:Name="BtnQuitarImagen" Grid.Column="3" Width="22" Height="25" Background="Transparent" Style="{StaticResource BotonPlano}" Visibility="Collapsed" Click="QuitarImagen_Click">
                                        <TextBlock Text="×" Foreground="#CF4059" FontSize="18"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="ⓘ Tipos de archivo aceptados: JPG, PNG (máximo 5 MB)" FontSize="10" Foreground="#AEB0B1" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PanelCuenta" Visibility="Collapsed">
                        <TextBlock Text="Nombre de usuario" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtNombreUsuario" Style="{StaticResource Campo}" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="Correo electrónico" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtCorreo" Style="{StaticResource Campo}" IsReadOnly="True" Margin="0,0,0,10"/>
                        <TextBlock Text="Estado de la cuenta" Style="{StaticResource Etiqueta}"/>
                        <TextBlock x:Name="TxtEstado" Foreground="#17475A" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button x:Name="BtnReenviar" Content="Reenviar solicitud de activación" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="Reenviar_Click" Margin="0,0,0,8"/>
                        <Button x:Name="BtnCambiarEstado" Content="Desactivar usuario" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="CambiarEstado_Click" Margin="0,0,0,8"/>
                        <Button Content="Restablecer contraseña" Style="{StaticResource Boton}" HorizontalAlignment="Left" Click="Restablecer_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TxtError" Foreground="#B3261E" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed"/>
            </Grid>
            <Border Grid.Row="3" CornerRadius="0,0,11,11" Background="{StaticResource Turquesa}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Content="Guardar" Style="{StaticResource Boton}" Click="Guardar_Click"/>
                    <Button Content="Cancelar" Style="{StaticResource Boton}" Margin="8,0,0,0" Click="Cerrar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
